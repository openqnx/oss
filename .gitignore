# Generated trees, all reproducible from the recipes (~30 GB).
# Anchored with a leading slash: an unanchored "src/" would also match
# tests/src/, which is hand-written source we very much want tracked.
# Note also that gitignore has no trailing comments -- a pattern runs to
# the end of the line, spaces included.
/src
/build
/stage
/stage.prev-*/
/logs
/dist
/hosttools
/pkgroot
/repo
/tmp
/tests/build/

# Credentials: the private key used to reach the lab targets. Never commit.
/tests/ssh/

# Generated by env.sh from the .ini.in templates; the templates are tracked.
/toolchain/meson-*.ini
/stage*/

# Session transcripts and chat exports: they carry lab target credentials and
# internal host addresses. Never let a copy dropped in here reach the remote.
*.jsonl
*session-log*.md
qnx-session-backups/
/.verify/
