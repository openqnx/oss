From 318fd7299ab2f4e50f1af27efcf57255a22c91c6 Mon Sep 17 00:00:00 2001
From: Terence Ang <taang@qnx.com>
Date: Thu, 19 Mar 2026 16:37:36 -0400
Subject: [PATCH] QNX support from qnx-ports

Imported from qnx-ports/7zip (branch qnx-25.01, 67c101a..318fd72); original authorship kept.
Upstream-Status: QNX-specific (carried in the qnx-ports fork)

Commits:
  dce1857 Patched 25.01
  318fd72 Merge pull request #2 from taang-qnx/mybranch

Refreshed for 7-Zip 26.05: upstream now excludes __QNXNTO__ from the
d_type code itself (CPP/Windows/FileFind.cpp and FileFind.h: entries are
typed through stat on QNX, as on AIX and Solaris), so those hunks are
dropped. 26.05 also sends QNX down the BSD sysctl(CTL_HW, HW_PHYSMEM)
path in System.cpp; QNX 8 has sysctl() only in libsocket, which 7zz does
not link, and HW_PHYSMEM fails there with ENOENT: QNX is taken out of that branch again and gets
the sysconf() branch this patch has always carried.
---
 C/Threads.c            |  6 +++---
 C/Threads.h            |  1 +
 CPP/7zip/7zip_gcc.mak  | 10 +++++-----
 CPP/Windows/System.cpp | 16 ++++++++++++----
 4 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/C/Threads.c b/C/Threads.c
index a6c5442..85abab7 100755
--- a/C/Threads.c
+++ b/C/Threads.c
@@ -486,7 +486,7 @@ WRes Thread_Create_With_CpuSet(CThread *p, THREAD_FUNC_TYPE func, LPVOID param,
       */
 
       // ret2 =
-      pthread_attr_setaffinity_np(&attr, sizeof(*cpuSet), cpuSet);
+      //pthread_attr_setaffinity_np(&attr, sizeof(*cpuSet), cpuSet);
       // if (ret2) ret = ret2;
 #endif
     }
@@ -496,14 +496,14 @@ WRes Thread_Create_With_CpuSet(CThread *p, THREAD_FUNC_TYPE func, LPVOID param,
     if (!ret)
     {
       p->_created = 1;
-      /*
       if (cpuSet)
       {
+#if defined(__linux__)
         // ret2 =
         pthread_setaffinity_np(p->_tid, sizeof(*cpuSet), cpuSet);
         // if (ret2) ret = ret2;
+#endif
       }
-      */
     }
   }
   // ret2 =
diff --git a/C/Threads.h b/C/Threads.h
index e788e32..9873be0 100755
--- a/C/Threads.h
+++ b/C/Threads.h
@@ -29,6 +29,7 @@ Z7_DIAGNOSTIC_IGNORE_END_RESERVED_MACRO_IDENTIFIER
 #endif
 
 #include <pthread.h>
+#include <sched.h>
 
 #endif
 
diff --git a/CPP/7zip/7zip_gcc.mak b/CPP/7zip/7zip_gcc.mak
index 3f188fa..bd243b3 100755
--- a/CPP/7zip/7zip_gcc.mak
+++ b/CPP/7zip/7zip_gcc.mak
@@ -24,7 +24,7 @@ PROGPATH_STATIC = $(O)/$(PROG)s
 
 
 ifneq ($(CC), xlc)
-CFLAGS_WARN_WALL = -Werror -Wall -Wextra
+CFLAGS_WARN_WALL = -Wall -Wextra
 endif
 
 # for object file
@@ -45,12 +45,12 @@ CFLAGS_DEBUG = -g
 else
 CFLAGS_DEBUG = -DNDEBUG
 ifneq ($(CC), $(CROSS_COMPILE)clang)
-LFLAGS_STRIP = -s
+LFLAGS_STRIP =
 endif
 endif
 
 # CFLAGS_BASE_LIST = -S
-CFLAGS_BASE = -O2 $(CFLAGS_BASE_LIST) $(CFLAGS_WARN_WALL) $(CFLAGS_WARN) \
+CFLAGS_BASE = $(CFLAGS_BASE_LIST) $(CFLAGS_WARN_WALL) $(CFLAGS_WARN) \
  $(CFLAGS_DEBUG) -D_REENTRANT -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE \
  -fPIC
 
@@ -168,7 +168,7 @@ endif
 
 
 
-CFLAGS = $(MY_ARCH_2) $(LOCAL_FLAGS) $(CFLAGS_BASE2) $(CFLAGS_BASE) $(FLAGS_FLTO) $(CC_SHARED) -o $@
+CFLAGS += $(MY_ARCH_2) $(LOCAL_FLAGS) $(CFLAGS_BASE2) $(CFLAGS_BASE) $(FLAGS_FLTO) $(CC_SHARED) -o $@
 
 
 ifdef IS_MINGW
@@ -1367,7 +1367,7 @@ predef_cc:
 	$(CC) $(CFLAGS) -E $(SHOW_PREDEF)  ../../../../C/CpuArch.c > predef_cc_log
 #	$(CC) $(CFLAGS) -E -dM -  < /dev/null
 predef_cxx:
-	$(CXX) $(CFLAGS) -E $(SHOW_PREDEF) ../../../Common/CrcReg.cpp  > predef_cxx_log
+	$(CXX) $(CXXFLAGS) -E $(SHOW_PREDEF) ../../../Common/CrcReg.cpp  > predef_cxx_log
 
 predef: predef_cc predef_cxx
 
diff --git a/CPP/Windows/System.cpp b/CPP/Windows/System.cpp
index 3ab8bb9..0c3ef93 100755
--- a/CPP/Windows/System.cpp
+++ b/CPP/Windows/System.cpp
@@ -6,9 +6,11 @@
 #include <unistd.h>
 #include <limits.h>
 #if defined(__APPLE__) || defined(__DragonFly__) \
-    || defined(BSD) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) \
-    || defined(__QNXNTO__)
+    || defined(BSD) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__)
 #include <sys/sysctl.h>
+#elif defined(__QNX__)
+#include <unistd.h>
+#include <sys/conf.h>
 #else
 #include <sys/sysinfo.h>
 #endif
@@ -301,8 +303,7 @@ bool GetRamSize(size_t &size)
   size64 = size;
 
 #if defined(__APPLE__) || defined(__DragonFly__) \
-    || defined(BSD) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) \
-    || defined(__QNXNTO__)
+    || defined(BSD) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__)
 
     uint64_t val = 0;
     int mib[2];
@@ -340,6 +341,13 @@ bool GetRamSize(size_t &size)
     #if defined(_SC_AIX_REALMEM) // AIX
       size64 = (UInt64)sysconf(_SC_AIX_REALMEM) * 1024;
     #endif
+  #elif defined(__QNX__)
+    long pages = sysconf(_SC_PHYS_PAGES);
+    long page_size = sysconf(_SC_PAGESIZE);
+    if (pages == -1 || page_size == -1)
+      size64 = 0;
+    else 
+      size64 = (uint64_t)pages * (uint64_t)page_size;
   #elif 0 || defined(__sun)
     #if defined(_SC_PHYS_PAGES) && defined(_SC_PAGESIZE)
     // FreeBSD, Linux, OpenBSD, and Solaris.
