From 9e8151a4ebb4f3d30f5cda7be728bc8636bd080e Mon Sep 17 00:00:00 2001
From: jscaff <jscaffidi@qnx.com>
Date: Tue, 29 Sep 2026 13:12:07 +0000
Subject: [PATCH 6/6] fix pkginfo provides having double prefixes

Likely poorly fixed merge conflict from alpine/ca9e4db4a1cca4fba82a84fad7020908b7dd1c07
---
 abuild.in | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/abuild.in b/abuild.in
index ad6874bb0d..5f01965b5b 100644
--- a/abuild.in
+++ b/abuild.in
@@ -1613,14 +1613,9 @@ trace_apk_deps() {
 	done
 
 	echo "# automatically detected:" >> "$dir"/.PKGINFO
-	if [ -f "$dir"/.provides-pc ]; then
-		sed 's/^/provides = pc:/' "$dir"/.provides-pc | sort -u \
-			>> "$dir"/.PKGINFO
-	fi
-	if [ -f "$dir"/.provides-py ]; then
-		sed 's/^/provides = /' "$dir"/.provides-py | sort -u \
-			>> "$dir"/.PKGINFO
-	fi
+	touch "$dir"/.provides-dummy
+	sed 's/^/provides = /' "$dir"/.provides-* | sort -u >> "$dir"/.PKGINFO
+
 	for i in $autodeps; do
 		echo "depend = $i"
 	done | sort -u >> "$dir"/.PKGINFO
