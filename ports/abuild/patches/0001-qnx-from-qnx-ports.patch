 export LDFLAGS="-Wl,--as-needed,-O1,--sort-common"
 export GOFLAGS="-buildmode=pie -modcacherw -trimpath -buildvcs=false"

From c11f5a68f026f7f51d2c5025d6f4c0b3d1595a2f Mon Sep 17 00:00:00 2001
From: Aaron Bassett <abassett@qnx.com>
Date: Mon, 10 Aug 2026 04:19:08 +0000
Subject: [PATCH 4/6] fix symlink/python3 autodepends

---
 abuild.in | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/abuild.in b/abuild.in
index 3bf8798567..ad6874bb0d 100644
--- a/abuild.in
+++ b/abuild.in
@@ -1578,12 +1578,12 @@ trace_apk_deps() {
 	fi
 
 	# symlink targets
-	for i in $(sort -u "$dir"/.symlinks-needs 2>/dev/null); do
+	for i in $(sort -u "$dir"/.needs-symlinks 2>/dev/null); do
 		autodeps="$autodeps $i"
 	done
 
 	# python3 dependencies
-	for i in $(sort -u "$dir"/.python3-needs 2>/dev/null); do
+	for i in $(sort -u "$dir"/.needs-python3 2>/dev/null); do
 		autodeps="$autodeps $i"
 	done
 

