QNX has no nproc: take the CPU count from getconf

Upstream-Status: QNX-specific

--- a/default.conf
+++ b/default.conf
@@ -6,7 +6,7 @@
 # Do note that these should work with at least GDC and LDC
 export DFLAGS="-Os"
 
-export JOBS="${JOBS:-$(nproc)}"
+export JOBS="${JOBS:-$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"
 export MAKEFLAGS="-j$JOBS"
 export SAMUFLAGS="-j$JOBS"
 export CARGO_BUILD_JOBS="$JOBS"
