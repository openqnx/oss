diff --git a/ld/emulparams/i386nto.sh b/ld/emulparams/i386nto.sh
index 3291412706d..0a694608e8c 100644
--- a/ld/emulparams/i386nto.sh
+++ b/ld/emulparams/i386nto.sh
@@ -4,9 +4,16 @@ NO_RELA_RELOCS=yes
 TEXT_START_ADDR=0x08048000
 TEXT_START_SYMBOLS="${CREATE_SHLIB+PROVIDE (}_btext = .${CREATE_SHLIB+)};"
 MAXPAGESIZE="CONSTANT (MAXPAGESIZE)"
+COMMONPAGESIZE="CONSTANT (COMMONPAGESIZE)"
 ARCH=i386
 MACHINE=
 NOP=0x9090
 TEMPLATE_NAME=elf
-EXTRA_EM_FILE="elf-x86"
 GENERATE_SHLIB_SCRIPT=yes
+GENERATE_PIE_SCRIPT=yes
+EXTRA_EM_FILE=nto
+COMPILE_IN=yes
+NO_SMALL_DATA=yes
+SEPARATE_GOTPLT="SIZEOF (.got.plt) >= 12 ? 12 : 0"
+
+static lang_input_statement_type *stub_file;
diff --git a/ld/emultempl/elf-x86.em b/ld/emultempl/elf-x86.em
index 2e9863fa1e6..b8ec7e6850b 100644
--- a/ld/emultempl/elf-x86.em
+++ b/ld/emultempl/elf-x86.em
@@ -34,8 +34,40 @@ static void
 elf_x86_create_output_section_statements (void)
 {
   _bfd_elf_linker_x86_set_options (&link_info, &params);
+#ifdef __QNXTARGET__
+  if (bfd_link_pie(&link_info)) {
+        stub_file = lang_add_input_file ("linker stubs",
+                                        lang_input_file_is_fake_enum,
+                                        NULL);
+        stub_file->the_bfd = bfd_create ("linker stubs", link_info.output_bfd);
+        if (stub_file->the_bfd == NULL
+        || ! bfd_set_arch_mach (stub_file->the_bfd,
+                                bfd_get_arch (link_info.output_bfd),
+                                bfd_get_mach (link_info.output_bfd)))
+        {
+        einfo (_("%F%P: can not create BFD: %E\n"));
+        return;
+        }
+
+        stub_file->the_bfd->flags |= BFD_LINKER_CREATED;
+        ldlang_add_file (stub_file);
+  }
+#endif
 }
 
+#ifdef __QNXTARGET__
+/*
+ * This is an awful hack, made necessary by presence of both ${ARCH}_elf_...
+ * and elf_${ARCH}_... in different places. Short of disrupting lots of
+ * non-QNX code, this is the shortest I came up with.
+ */
+static void
+i386_elf_create_output_section_statements(void) {
+  return elf_x86_create_output_section_statements();
+}
+
+#endif // __QNXTARGET__
+
 EOF
 
 LDEMUL_CREATE_OUTPUT_SECTION_STATEMENTS=elf_x86_create_output_section_statements
diff --git a/ld/emultempl/nto.em b/ld/emultempl/nto.em
index 7cda6650bc6..c577e0f33f9 100644
--- a/ld/emultempl/nto.em
+++ b/ld/emultempl/nto.em
@@ -21,8 +21,19 @@
 # This file is sourced from elf.em, and defines extra Neutrino
 # specific routines.
 
+cat >>e${EMULATION_NAME}.c <<EOF
+static lang_input_statement_type *stub_file;
+EOF
+
+REG_EXTENDED=1
+
 # NTO templates aims to refine the default ${ARCH}elf.em template.
+
+if [[ ${ARCH} =~ i386 ]]; then
+. "${srcdir}/emultempl/elf-x86.em"
+else
 . "${srcdir}/emultempl/${ARCH}elf.em"
+fi
 
 cat >>e${EMULATION_NAME}.c <<EOF
 
@@ -31,7 +42,7 @@ cat >>e${EMULATION_NAME}.c <<EOF
 #include "elf-bfd.h"
 #include "../bfd/libbfd.h"
 
-bool nto_lazy_stack = false;
+static bool nto_lazy_stack = false;
 struct nto_stack_note
 {
   unsigned char stacksize[4];
