+#elif (defined(__QNX__) || defined(__QNXNTO__))
+// QNX's procfs has no per-process "environ" entry, so env() below cannot be
+// implemented -- but the handle and iterator helpers still have to exist or
+// libboost_process ships with undefined symbols. The blob walk itself is not
+// platform-specific; it matches the layout env() would have produced.
+
+void native_env_handle_deleter::operator()(native_env_handle_type h) const
+{
+    delete [] h;
+}
+
+native_env_iterator next(native_env_iterator nh)
+{
+    while (*nh != '\0')
+        nh ++;
+    return ++nh ;
+}
+
+native_env_iterator find_end(native_env_iterator nh)
+{
+    while (*nh != EOF)
+        nh ++;
+    return nh ;
+}
+
+const environment::char_type * dereference(native_env_iterator iterator)
+{
+    return iterator;
+}
