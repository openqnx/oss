+#elif (defined(__QNX__) || defined(__QNXNTO__))
+
+env_view env(boost::process::v2::pid_type, boost::system::error_code & ec)
+{
+    // /proc/<pid> on QNX holds as, cmdline, ctl, exefile, mappings, pmap and
+    // vmstat -- another process's environment is not exposed, and there is no
+    // sysctl equivalent. Report that rather than returning an empty view that
+    // a caller would read as "no environment variables set".
+    BOOST_PROCESS_V2_ASSIGN_EC(ec, ENOTSUP, boost::system::system_category())
+    return {};
+}
+
