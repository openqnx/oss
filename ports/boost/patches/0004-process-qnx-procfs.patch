+#elif (defined(__QNX__) || defined(__QNXNTO__))
+
+filesystem::path exe(boost::process::v2::pid_type pid, boost::system::error_code & ec)
+{
+    // QNX exposes the executable path as the *contents* of /proc/<pid>/exefile,
+    // not as a symlink the way Linux's /proc/<pid>/exe does.
+    char buffer[PATH_MAX + 1];
+    snprintf(buffer, sizeof(buffer), "/proc/%d/exefile", static_cast<int>(pid));
+    int fd = ::open(buffer, O_RDONLY);
+    if (fd == -1)
+    {
+        if (errno == ENOENT)
+            BOOST_PROCESS_V2_ASSIGN_EC(ec, ESRCH, boost::system::system_category())
+        else
+            BOOST_PROCESS_V2_ASSIGN_LAST_ERROR(ec)
+        return "";
+    }
+    auto r = ::read(fd, buffer, sizeof(buffer) - 1);
+    ::close(fd);
+    if (r < 0)
+    {
+        BOOST_PROCESS_V2_ASSIGN_LAST_ERROR(ec)
+        return "";
+    }
+    buffer[r] = '\0';
+    // The contents may or may not be newline/NUL terminated.
+    for (auto i = r; i-- > 0; )
+        if (buffer[i] == '\n' || buffer[i] == '\0')
+            buffer[i] = '\0';
+        else
+            break;
+    if (buffer[0] == '\0')
+    {
+        BOOST_PROCESS_V2_ASSIGN_EC(ec, ENOENT, boost::system::system_category())
+        return "";
+    }
+    return filesystem::canonical(buffer, ec);
+}
+
 #elif (defined(__FreeBSD__) || defined(__DragonFly__) || defined(__NetBSD__))
 
 filesystem::path exe(boost::process::v2::pid_type pid, boost::system::error_code & ec)
