Optional versioned soname for libcrypto and libssl (BORINGSSL_SOVERSION)

A shared BoringSSL build names its libraries libcrypto.so and libssl.so
with no version: their soname, and so every consumer's NEEDED entry, is
the bare development name. On a system that also has OpenSSL (here the
openssl component, /usr/local/lib/libcrypto.so -> libcrypto.so.3), and on
QNX, whose loader searches LD_LIBRARY_PATH before a program's run path,
a BoringSSL program can then load OpenSSL's libcrypto and fail or crash.
With -DBORINGSSL_SOVERSION=<v> the libraries are libcrypto.so.<v> and
libssl.so.<v>, a name only BoringSSL's prefix holds. BoringSSL makes no
ABI promise between releases, so the recipe passes the release version.

Upstream-Status: QNX-specific

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 58dce62..805db18 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -679,6 +679,15 @@ set_property(TARGET ssl PROPERTY EXPORT_NAME SSL)
 target_link_libraries(ssl crypto)
 target_compile_definitions(ssl PRIVATE -DBORINGSSL_IMPLEMENTATION)
 
+# A distributor can give the shared libraries a versioned soname, so that a
+# program built against BoringSSL never loads another libcrypto.so/libssl.so
+# (OpenSSL's) found first on the library search path.
+if(BUILD_SHARED_LIBS AND BORINGSSL_SOVERSION)
+  set_target_properties(crypto ssl PROPERTIES
+                        VERSION ${BORINGSSL_SOVERSION}
+                        SOVERSION ${BORINGSSL_SOVERSION})
+endif()
+
 add_library(decrepit ${DECREPIT_SOURCES})
 target_link_libraries(decrepit ssl crypto)
 target_compile_definitions(decrepit PRIVATE -DBORINGSSL_IMPLEMENTATION)
