-std::string formatSocketAddress(const SocketStringAddress& socketAddress);
\ No newline at end of file
+std::string formatSocketAddress(const SocketStringAddress& socketAddress);
+/* The length of the address in a sockaddr_storage. Linux accepts
+ * sizeof(struct sockaddr_storage) in bind(), connect() and sendto();
+ * BSD stacks (QNX io-sock) want the length of the address family. */
+#include <netinet/in.h>
+#include <sys/socket.h>
+static inline socklen_t socketAddressLength(const struct sockaddr_storage *addr) {
+  return addr->ss_family == AF_INET6 ? sizeof(struct sockaddr_in6) : sizeof(struct sockaddr_in);
+}
