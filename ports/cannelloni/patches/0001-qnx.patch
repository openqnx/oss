--- a/timer.cpp
+++ b/timer.cpp
@@ -26,6 +26,41 @@
 
 using namespace cannelloni;
 
+#ifdef __QNXNTO__
+/* QNX has timerfd_create() and timerfd_settime() but no timerfd_gettime():
+ * keep what was set and work out the remaining time from the clock. */
+#include <time.h>
+static uint64_t qnx_now_us() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (uint64_t)t.tv_sec*1000000 + t.tv_nsec/1000;
+}
+
+int Timer::qnxSettime(const struct itimerspec *ts) {
+  uint64_t value = (uint64_t)ts->it_value.tv_sec*1000000 + ts->it_value.tv_nsec/1000;
+  m_interval = (uint64_t)ts->it_interval.tv_sec*1000000 + ts->it_interval.tv_nsec/1000;
+  m_deadline = value ? qnx_now_us() + value : 0;
+  return ::timerfd_settime(m_timerfd, 0, ts, NULL);
+}
+
+void Timer::qnxGettime(struct itimerspec *ts) {
+  uint64_t value = 0;
+  if (m_deadline) {
+    uint64_t now = qnx_now_us();
+    if (now < m_deadline)
+      value = m_deadline - now;
+    else if (m_interval)
+      value = m_interval - ((now - m_deadline) % m_interval);
+  }
+  ts->it_interval.tv_sec = m_interval/1000000;
+  ts->it_interval.tv_nsec = (m_interval%1000000)*1000;
+  ts->it_value.tv_sec = value/1000000;
+  ts->it_value.tv_nsec = (value%1000000)*1000;
+}
+#define timerfd_gettime(fd, ts) qnxGettime(ts)
+#define timerfd_settime(fd, flags, ts, old) qnxSettime(ts)
+#endif
+
 Timer::Timer() {
   /* Create timerfd */
   m_timerfd = timerfd_create(CLOCK_REALTIME, 0);
