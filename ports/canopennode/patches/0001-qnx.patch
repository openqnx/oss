      * on all devices)*/
+#ifdef __QNX__
+    /* qnx-socketcan stamps frames in software: SO_TIMESTAMP, a struct timeval */
+    tmp = 1;
+    ret = setsockopt(interface->fd, SOL_SOCKET, SO_TIMESTAMP, &tmp, sizeof(tmp));
+#else
     tmp = (SOF_TIMESTAMPING_SOFTWARE |
