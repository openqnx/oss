CommonAPI SOME/IP: byte-order macros on QNX.

The streams test glibc's __BYTE_ORDER/__LITTLE_ENDIAN; QNX has only the BSD
names from <sys/param.h>. Alias them on QNX.

Upstream-Status: QNX-specific

--- a/include/CommonAPI/SomeIP/OutputStream.hpp
+++ b/include/CommonAPI/SomeIP/OutputStream.hpp
@@ -10,6 +10,19 @@
 #ifndef COMMONAPI_SOMEIP_OUTPUTSTREAM_HPP_
 #define COMMONAPI_SOMEIP_OUTPUTSTREAM_HPP_
 
+/* QNX exposes only the BSD spellings of the byte-order macros, from
+ * <sys/param.h>; the __-prefixed glibc names used below do not exist there.
+ * Alias them so the endianness checks keep working unmodified. */
+#if defined(__QNXNTO__)
+#include <sys/param.h>
+#ifndef __BYTE_ORDER
+#define __BYTE_ORDER    BYTE_ORDER
+#define __LITTLE_ENDIAN LITTLE_ENDIAN
+#define __BIG_ENDIAN    BIG_ENDIAN
+#endif
+#endif
+
+
 #include <cstring>
 #include <iomanip>
 #include <limits>
