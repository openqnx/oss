From 5e2c761a5f63bcde7d6aedb143e1d29844f49fea Mon Sep 17 00:00:00 2001
From: Deep Chordia <dchordia@blackberry.com>
Date: Thu, 24 Oct 2024 16:23:45 +0530
Subject: [PATCH 1/3] Add INSTALL_TESTS option

Imported from qnx-ports/capnproto (v1.0.2...qnx-1.0.2).
Upstream-Status: QNX-specific (carried in the qnx-ports fork)

---
 c++/CMakeLists.txt           | 1 +
 c++/src/capnp/CMakeLists.txt | 5 +++++
 c++/src/kj/CMakeLists.txt    | 7 +++++++
 3 files changed, 13 insertions(+)

diff --git a/c++/CMakeLists.txt b/c++/CMakeLists.txt
index 5e5f508601..30e47ad2ee 100644
--- a/c++/CMakeLists.txt
+++ b/c++/CMakeLists.txt
@@ -28,6 +28,7 @@ set(INSTALL_TARGETS_DEFAULT_ARGS
 
 option(EXTERNAL_CAPNP "Use the system capnp binary, or the one specified in $CAPNP, instead of using the compiled one." OFF)
 option(CAPNP_LITE "Compile Cap'n Proto in 'lite mode', in which all reflection APIs (schema.h, dynamic.h, etc.) are not included. Produces a smaller library at the cost of features. All programs built against the library must be compiled with -DCAPNP_LITE. Requires EXTERNAL_CAPNP." OFF)
+option(INSTALL_TESTS "Install Cap'n Proto tests" OFF)
 
 # Check for invalid combinations of build options
 if(CAPNP_LITE AND BUILD_TESTING AND NOT EXTERNAL_CAPNP)
diff --git a/c++/src/capnp/CMakeLists.txt b/c++/src/capnp/CMakeLists.txt
index 9980fde617..eeaa4a7978 100644
--- a/c++/src/capnp/CMakeLists.txt
+++ b/c++/src/capnp/CMakeLists.txt
@@ -277,6 +277,9 @@ if(BUILD_TESTING)
   add_dependencies(capnp-tests test_capnp)
   add_dependencies(check capnp-tests)
   add_test(NAME capnp-tests-run COMMAND capnp-tests)
+  if(INSTALL_TESTS)
+    install(TARGETS capnp-tests DESTINATION bin/)
+  endif()
 
   if(NOT CAPNP_LITE)
     add_executable(capnp-heavy-tests
@@ -316,6 +319,8 @@ if(BUILD_TESTING)
     target_link_libraries(capnp-evolution-tests capnpc capnp kj)
     add_dependencies(check capnp-evolution-tests)
     add_test(NAME capnp-evolution-tests-run COMMAND capnp-evolution-tests)
+    if(INSTALL_TESTS)
+      install(TARGETS capnp-heavy-tests capnp-evolution-tests DESTINATION bin/)
   endif()  # NOT CAPNP_LITE
 endif()  # BUILD_TESTING
 
diff --git a/c++/src/kj/CMakeLists.txt b/c++/src/kj/CMakeLists.txt
index 980c53e34c..95ec0575bd 100644
--- a/c++/src/kj/CMakeLists.txt
+++ b/c++/src/kj/CMakeLists.txt
@@ -261,6 +261,10 @@ if(BUILD_TESTING)
   target_link_libraries(kj-tests kj-test kj)
   add_dependencies(check kj-tests)
   add_test(NAME kj-tests-run COMMAND kj-tests)
+  if(INSTALL_TESTS)
+    install(TARGETS kj-tests DESTINATION bin/)
+  endif()
+
 
   if(NOT CAPNP_LITE)
     add_executable(kj-heavy-tests
@@ -310,5 +314,8 @@ if(BUILD_TESTING)
     endif()
     add_dependencies(check kj-heavy-tests)
     add_test(NAME kj-heavy-tests-run COMMAND kj-heavy-tests)
+    if(INSTALL_TESTS)
+      install(TARGETS kj-heavy-tests DESTINATION bin/)
+    endif()
   endif()  # NOT CAPNP_LITE
 endif()  # BUILD_TESTING

