Subject: [PATCH 2/2] Fix linking order

---
 CMakeLists.txt | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a42f54d705c..08662f273e6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -346,7 +346,7 @@ if(ARM_COMPUTE_BUILD_TESTING)
