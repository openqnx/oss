 	}
 	return cpuinfo_linux_cpu_to_processor_map[cpu];
+#elif defined(__QNXNTO__)
+	/* the CPU this thread runs on, as the kernel numbers it */
+	int cpu = SchedGetCpuNum();
+	if CPUINFO_UNLIKELY (cpu < 0 || (uint32_t)cpu >= cpuinfo_qnx_get_processors_count()) {
+		return NULL;
+	}
+	return &qnx_processors[cpu];
 #else
 	return NULL;
 #endif
