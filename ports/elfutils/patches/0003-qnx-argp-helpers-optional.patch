Compile the argp helpers only where <argp.h> exists (QNX).

color.c and printversion.c are option-parsing helpers of the eu-* tools,
built on glibc's argp, which QNX does not have. They are compiled into
libeu.a, whose objects libelf also takes, though libelf uses neither: on
QNX without <argp.h> they compile to nothing (the tools are not built).

Upstream-Status: QNX-specific

--- a/lib/color.c
+++ b/lib/color.c
@@ -31,6 +31,9 @@
 # include <config.h>
 #endif
 
+/* QNX: no <argp.h>; this helper only serves the argp-based tools,
+   which are not built there.  libelf does not use it.  */
+#if !defined(__QNX__) || __has_include(<argp.h>)
 #include <argp.h>
 #include <stdlib.h>
 #include <string.h>
@@ -232,3 +235,5 @@
     }
   return 0;
 }
+
+#endif /* !__QNX__ || <argp.h> */
--- a/lib/printversion.c
+++ b/lib/printversion.c
@@ -30,6 +30,9 @@
 # include <config.h>
 #endif
 
+/* QNX: no <argp.h>; this helper only serves the argp-based tools,
+   which are not built there.  libelf does not use it.  */
+#if !defined(__QNX__) || __has_include(<argp.h>)
 #include "printversion.h"
 
 void
@@ -42,3 +45,5 @@
 warranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\n\
 "), "2025", PACKAGE_URL);
 }
+
+#endif /* !__QNX__ || <argp.h> */
