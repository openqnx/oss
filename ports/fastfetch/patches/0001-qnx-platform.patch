--- /dev/null
+++ b/src/detection/cpu/cpu_qnx.c
@@ -0,0 +1,37 @@
+#include "cpu.h"
+
+#include <sys/syspage.h>
+
+// QNX: the processors as the startup code recorded them in the system page
+// (cpuinfo: one entry per CPU, its speed in MHz and a name in the string
+// table); on x86 the brand string and vendor come from cpuid.
+const char* ffDetectCPUImpl(FF_A_UNUSED const FFCPUOptions* options, FFCPUResult* cpu) {
+    if (_syspage_ptr == NULL) {
+        return "No system page";
+    }
+
+    uint16_t n = (uint16_t) _syspage_ptr->num_cpu;
+    const struct cpuinfo_entry* ci = SYSPAGE_ENTRY(cpuinfo);
+    const char* strings = SYSPAGE_ENTRY(strings)->data;
+
+    uint32_t maxSpeed = 0;
+    for (uint16_t i = 0; i < n; i++) {
+        if (ci[i].speed > maxSpeed) {
+            maxSpeed = ci[i].speed;
+        }
+    }
+
+    cpu->coresLogical = cpu->coresOnline = cpu->coresPhysical = n;
+    cpu->packages = 1;
+    cpu->frequencyBase = maxSpeed; // MHz
+
+    ffCPUDetectByCpuid(cpu);
+
+    if (cpu->name.length == 0 && n > 0 && strings) {
+        ffStrbufSetS(&cpu->name, strings + ci[0].name);
+    }
+    if (cpu->frequencyBase < maxSpeed) {
+        cpu->frequencyBase = maxSpeed;
+    }
+    return NULL;
+}
--- /dev/null
+++ b/src/detection/disk/disk_qnx.c
@@ -0,0 +1,97 @@
+#include "disk.h"
+#include "common/io.h"
+#include "common/strutil.h"
+
+#include <devctl.h>
+#include <fcntl.h>
+#include <sys/dcmd_blk.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <unistd.h>
+
+// QNX has no mount table (getmntent/getfsstat). The file systems mounted
+// are found the way they appear in the path space: "/" and every top-level
+// directory whose file system differs from the root's (st_dev), as in
+// a standard image's /system, /data, /boot. DCMD_FSYS_MOUNTED_ON names the
+// device behind each.
+static void addDisk(FFDiskOptions* options, FFlist* disks, const char* path) {
+    struct statvfs fs;
+    if (statvfs(path, &fs) != 0 || fs.f_blocks == 0) {
+        return;
+    }
+    if (options->hideFolders.length && ffDiskMatchesFolderPatterns(&options->hideFolders, path, FF_DISK_FOLDER_SEPARATOR)) {
+        return;
+    }
+    if (options->hideFS.length && ffStrbufSeparatedContainS(&options->hideFS, fs.f_basetype, ':')) {
+        return;
+    }
+
+    FFDisk* disk = FF_LIST_ADD(FFDisk, *disks);
+    uint64_t bs = fs.f_frsize ? fs.f_frsize : fs.f_bsize;
+    disk->bytesTotal = (uint64_t) fs.f_blocks * bs;
+    disk->bytesFree = (uint64_t) fs.f_bfree * bs;
+    disk->bytesAvailable = (uint64_t) fs.f_bavail * bs;
+    disk->bytesUsed = 0; // filled in by disk.c
+    disk->filesTotal = (uint32_t) fs.f_files;
+    disk->filesUsed = (uint32_t) (fs.f_files - fs.f_ffree);
+    ffStrbufInitS(&disk->mountpoint, path);
+    ffStrbufInitS(&disk->filesystem, fs.f_basetype);
+    ffStrbufInit(&disk->mountFrom);
+    ffStrbufInit(&disk->name);
+    disk->type = FF_DISK_VOLUME_TYPE_REGULAR_BIT;
+    if (fs.f_flag & ST_RDONLY) {
+        disk->type |= FF_DISK_VOLUME_TYPE_READONLY_BIT;
+    }
+    disk->createTime = 0;
+
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd >= 0) {
+        char dev[256] = "";
+        if (devctl(fd, DCMD_FSYS_MOUNTED_ON, dev, sizeof(dev), NULL) == EOK && dev[0]) {
+            ffStrbufSetS(&disk->mountFrom, dev);
+        }
+        close(fd);
+    }
+}
+
+const char* ffDetectDisksImpl(FFDiskOptions* options, FFlist* disks) {
+    if (options->folders.length > 0) {
+        // --disk-folders: exactly the listed paths
+        FF_STRBUF_AUTO_DESTROY folder = ffStrbufCreate();
+        uint32_t start = 0;
+        while (start < options->folders.length) {
+            uint32_t end = ffStrbufNextIndexC(&options->folders, start, FF_DISK_FOLDER_SEPARATOR);
+            ffStrbufSetNS(&folder, end - start, options->folders.chars + start);
+            if (folder.length) {
+                addDisk(options, disks, folder.chars);
+            }
+            start = end + 1;
+        }
+        return NULL;
+    }
+
+    struct stat root;
+    if (stat("/", &root) != 0) {
+        return "stat(\"/\") failed";
+    }
+    addDisk(options, disks, "/");
+
+    FF_AUTO_CLOSE_DIR DIR* dir = opendir("/");
+    if (dir == NULL) {
+        return "opendir(\"/\") failed";
+    }
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != NULL) {
+        if (entry->d_name[0] == '.' || ffStrEquals(entry->d_name, "proc") || ffStrEquals(entry->d_name, "dev")) {
+            continue;
+        }
+        char path[PATH_MAX];
+        snprintf(path, sizeof(path), "/%s", entry->d_name);
+        struct stat st;
+        if (lstat(path, &st) != 0 || !S_ISDIR(st.st_mode) || st.st_dev == root.st_dev) {
+            continue;
+        }
+        addDisk(options, disks, path);
+    }
+    return NULL;
+}
