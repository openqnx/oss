@@ -0,0 +1,13 @@
+#include "displayserver.h"
+
+#include <unistd.h>
+
+// QNX: the graphics system is QNX Screen (no X11, no Wayland compositor of
+// its own). It is reported when its resource manager is up; the displays
+// themselves are not enumerated.
+void ffConnectDisplayServerImpl(FFDisplayServerResult* ds) {
+    if (access("/dev/screen", F_OK) == 0) {
+        ffStrbufSetStatic(&ds->wmProcessName, "screen");
+        ffStrbufSetStatic(&ds->wmPrettyName, "QNX Screen");
+    }
+}
--- /dev/null
+++ b/src/detection/host/host_qnx.c
@@ -0,0 +1,20 @@
+#include "host.h"
+
+#include <sys/utsname.h>
+#include <sys/syspage.h>
+
+// QNX: the board name the BSP's startup code put in the system page (uname
+// -m: "x86pc", a board name on ARM), the CPU architecture as the family.
+const char* ffDetectHost(FFHostResult* host) {
+    struct utsname uts;
+    if (uname(&uts) != 0) {
+        return "uname() failed";
+    }
+    ffStrbufSetS(&host->name, uts.machine);
+#if defined(__aarch64__)
+    ffStrbufSetStatic(&host->family, "aarch64");
+#elif defined(__x86_64__)
+    ffStrbufSetStatic(&host->family, "x86_64");
+#endif
+    return NULL;
+}
--- /dev/null
+++ b/src/detection/memory/memory_qnx.c
@@ -0,0 +1,35 @@
+#include "memory.h"
+
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/syspage.h>
+
+// QNX: the RAM is what the startup code listed as "ram" in the system
+// page's address-space table (sysconf(_SC_PHYS_PAGES) is not implemented);
+// the free memory is the size procnto reports for /proc.
+const char* ffDetectMemory(FFMemoryResult* ram) {
+    if (_syspage_ptr == NULL) {
+        return "No system page";
+    }
+    const struct asinfo_entry* as = SYSPAGE_ENTRY(asinfo);
+    const char* strings = SYSPAGE_ENTRY(strings)->data;
+    size_t n = _syspage_ptr->asinfo.entry_size / sizeof(*as);
+    uint64_t total = 0;
+    for (size_t i = 0; i < n; i++) {
+        if (strcmp(strings + as[i].name, "ram") == 0) {
+            total += as[i].end - as[i].start + 1;
+        }
+    }
+    if (total == 0) {
+        return "No \"ram\" entries in the system page";
+    }
+    ram->bytesTotal = total;
+
+    struct stat st;
+    if (stat("/proc", &st) != 0) {
+        return "stat(\"/proc\") failed";
+    }
+    uint64_t freeBytes = (uint64_t) st.st_size;
+    ram->bytesUsed = freeBytes < ram->bytesTotal ? ram->bytesTotal - freeBytes : 0;
+    return NULL;
+}
--- /dev/null
+++ b/src/detection/os/os_qnx.c
@@ -0,0 +1,20 @@
+#include "os.h"
+#include "common/io.h"
+
+#include <sys/utsname.h>
+
+// QNX Neutrino: no os-release file; the release is the kernel's
+// (uname -r: "8.0.0" on SDP 8.0), the version string its build date.
+void ffDetectOSImpl(FFOSResult* os) {
+    ffStrbufSetStatic(&os->name, "QNX");
+    ffStrbufSetStatic(&os->id, "qnx");
+
+    struct utsname uts;
+    if (uname(&uts) == 0) {
+        ffStrbufSetS(&os->versionID, uts.release);
+        ffStrbufSetS(&os->version, uts.release);
+        ffStrbufSetS(&os->buildID, uts.version);
+    }
+    ffStrbufSetF(&os->prettyName, "QNX %s", os->version.length ? os->version.chars : "");
+    ffStrbufTrimRightSpace(&os->prettyName);
+}
--- /dev/null
+++ b/src/detection/processes/processes_qnx.c
@@ -0,0 +1,24 @@
+#include "processes.h"
+
+#include "common/io.h"
+#include "common/strutil.h"
+
+#include <dirent.h>
+
+// QNX: one directory per process under /proc (pid 1 is procnto itself).
+const char* ffDetectProcesses(uint32_t* result) {
+    FF_AUTO_CLOSE_DIR DIR* dir = opendir("/proc");
+    if (dir == NULL) {
+        return "opendir(\"/proc\") failed";
+    }
+
+    uint32_t n = 0;
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != NULL) {
+        if (ffCharIsDigit(entry->d_name[0])) {
+            ++n;
+        }
+    }
+    *result = n;
+    return NULL;
+}
--- /dev/null
+++ b/src/detection/uptime/uptime_qnx.c
@@ -0,0 +1,18 @@
+#include "uptime.h"
+#include "common/time.h"
+
+#include <sys/syspage.h>
+
+// QNX: the boot time (seconds since the epoch) is in the system page.
+const char* ffDetectUptime(FFUptimeResult* result) {
+    if (_syspage_ptr == NULL) {
+        return "No system page";
+    }
+    uint64_t boot = SYSPAGE_ENTRY(qtime)->boot_time;
+    if (boot == 0) {
+        return "qtime->boot_time is 0";
+    }
+    result->bootTime = boot * 1000;
+    result->uptime = ffTimeGetNow() - result->bootTime;
+    return NULL;
+}
