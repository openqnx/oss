No temporary C numeric locale on QNX (no xlocale; only the C locale)

QNX has no xlocale: no locale_t, newlocale(), uselocale() or freelocale().
fcft switches LC_NUMERIC to "C" around FcNameParse() so fontconfig parses
floating point sizes ("monospace:size=10.5") in any locale. QNX only has the
"C" locale, so the numeric locale is always "C" already: skip the switch.

Upstream-Status: QNX-specific

--- a/fcft.c
+++ b/fcft.c
@@ -534,6 +534,7 @@
     /* Fontconfig fails to parse floating point values unless locale
      * (LC_NUMERIC) is e.g C, or en_US.UTF-8 */
 
+#if !defined(__QNX__)
     locale_t c_locale = newlocale(LC_NUMERIC_MASK, "C", (locale_t)0);
     if (c_locale == (locale_t)0) {
         LOG_ERRNO("%s: failed to create temporary locale", name);
@@ -547,11 +548,14 @@
         return NULL;
     }
 
+#endif
     FcPattern *pattern = FcNameParse((const unsigned char *)name);
 
+#if !defined(__QNX__)
     /* Restore locale */
     uselocale(old_locale);
     freelocale(c_locale);
+#endif
 
     if (pattern == NULL) {
         LOG_ERR("%s: failed to lookup font", name);
