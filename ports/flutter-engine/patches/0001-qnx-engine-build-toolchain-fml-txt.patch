@@ -0,0 +1,56 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/fml/platform/qnx/message_loop_qnx.h"
+
+#include <chrono>
+
+namespace fml {
+
+MessageLoopQnx::MessageLoopQnx() = default;
+
+MessageLoopQnx::~MessageLoopQnx() = default;
+
+// |fml::MessageLoopImpl|
+void MessageLoopQnx::Run() {
+  while (true) {
+    {
+      std::unique_lock<std::mutex> lock(mutex_);
+      while (!terminated_) {
+        const fml::TimePoint now = fml::TimePoint::Now();
+        if (wake_time_ <= now) {
+          break;
+        }
+        if (wake_time_ == fml::TimePoint::Max()) {
+          cv_.wait(lock);
+        } else {
+          cv_.wait_for(lock, std::chrono::microseconds(
+                                 (wake_time_ - now).ToMicroseconds() + 1));
+        }
+      }
+      if (terminated_) {
+        return;
+      }
+      // Tasks re-arm the loop through WakeUp() while they run.
+      wake_time_ = fml::TimePoint::Max();
+    }
+    RunExpiredTasksNow();
+  }
+}
+
+// |fml::MessageLoopImpl|
+void MessageLoopQnx::Terminate() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  terminated_ = true;
+  cv_.notify_one();
+}
+
+// |fml::MessageLoopImpl|
+void MessageLoopQnx::WakeUp(fml::TimePoint time_point) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  wake_time_ = time_point;
+  cv_.notify_one();
+}
+
+}  // namespace fml
