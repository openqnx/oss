+/* Compatibility header for the QNX clang toolchain (//build/toolchain/qnx). */
+#ifndef QNX_COMPAT_DIRENT_H
+#define QNX_COMPAT_DIRENT_H
+#include_next <dirent.h>
+/* QNX's struct dirent has no d_type; code that uses it reads DT_UNKNOWN
+   through __qnx_dirent_type() and falls back to stat(). */
+#ifndef DT_UNKNOWN
+#define DT_UNKNOWN 0
+#define DT_FIFO 1
+#define DT_CHR 2
+#define DT_DIR 4
+#define DT_BLK 6
+#define DT_REG 8
+#define DT_LNK 10
+#define DT_SOCK 12
+#endif
+#define __qnx_dirent_type(e) ((void)(e), DT_UNKNOWN)
+#endif
