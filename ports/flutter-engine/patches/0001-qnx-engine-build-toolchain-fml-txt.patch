index 00000000000..4f626cc2e22
--- /dev/null
+++ b/engine/src/build/toolchain/qnx/include/sys/syscall.h
@@ -0,0 +1,19 @@
+/* Compatibility header for the QNX clang toolchain (//build/toolchain/qnx). */
+#ifndef QNX_COMPAT_SYS_SYSCALL_H
+#define QNX_COMPAT_SYS_SYSCALL_H
+#include <errno.h>
+#include <pthread.h>
+#include <stdarg.h>
+/* QNX has no syscall(2). Only the thread id is emulated (QNX thread ids are
+   the pthread_t values); every other number fails with ENOSYS. */
+#define __NR_gettid 186
+#define SYS_gettid __NR_gettid
+#define __NR_getrandom 318
+#define __NR_memfd_create 319
+static inline long __qnx_compat_syscall(long __n, ...) {
+  if (__n == __NR_gettid) return (long)pthread_self();
+  errno = ENOSYS;
+  return -1;
+}
+#define syscall __qnx_compat_syscall
+#endif
