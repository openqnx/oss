diff --git a/engine/src/build/toolchain/qnx/BUILD.gn b/engine/src/build/toolchain/qnx/BUILD.gn
index 87fd9714811..263aef97aaa 100644
--- a/engine/src/build/toolchain/qnx/BUILD.gn
+++ b/engine/src/build/toolchain/qnx/BUILD.gn
@@ -19,3 +19,40 @@ gcc_toolchain("qnx") {
   toolchain_os = "linux"
   is_clang = false
 }
+
+# Clang toolchains for QNX SDP 8.0 (x86_64, aarch64): a host clang/lld built
+# from LLVM with the qnx-ports QNX support, and a sysroot that merges the SDP
+# target headers and libraries (args qnx_clang_dir, qnx_sysroot_<cpu>).
+import("//build/toolchain/qnx/qnx.gni")
+template("qnx_clang_toolchain") {
+  gcc_toolchain(target_name) {
+    _compat = rebase_path("//build/toolchain/qnx/include")
+    _flags = "--target=${invoker.triple} --sysroot=${invoker.sysroot} -isystem $_compat"
+    asm = "${qnx_clang_dir}/bin/clang $_flags"
+    cc = "${qnx_clang_dir}/bin/clang $_flags"
+    cxx = "${qnx_clang_dir}/bin/clang++ $_flags"
+    _compat_lib = rebase_path("//build/toolchain/qnx/lib")
+    ld = "$cxx -L$_compat_lib"
+    # QNX keeps the BSD sockets in libsocket, inotify in libfsnotify and
+    # catopen()/catgets() in libcatalog.
+    libs_section_postfix = "-lsocket -lfsnotify -lcatalog"
+    solink_libs_section_postfix = "-lsocket -lfsnotify -lcatalog"
+    readelf = "${qnx_clang_dir}/bin/llvm-readelf"
+    nm = "${qnx_clang_dir}/bin/llvm-nm"
+    ar = "${qnx_clang_dir}/bin/llvm-ar"
+    strip = "${qnx_clang_dir}/bin/llvm-strip"
+    toolchain_cpu = invoker.cpu
+    toolchain_os = "qnx"
+    is_clang = true
+  }
+}
+qnx_clang_toolchain("clang_x64") {
+  cpu = "x64"
+  triple = "x86_64-pc-qnx8.0.0"
+  sysroot = qnx_sysroot_x64
+}
+qnx_clang_toolchain("clang_arm64") {
+  cpu = "arm64"
+  triple = "aarch64-unknown-qnx8.0.0"
+  sysroot = qnx_sysroot_arm64
+}
