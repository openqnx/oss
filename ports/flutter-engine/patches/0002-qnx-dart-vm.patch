+// Copyright (c) 2026, the Dart project authors.  Please see the AUTHORS file
+// for details. All rights reserved. Use of this source code is governed by a
+// BSD-style license that can be found in the LICENSE file.
+
+// QNX Neutrino: like signal_handler_linux.cc, but QNX's mcontext_t holds the
+// CPU registers in .cpu (x86_64: named fields, aarch64: gpr[32] + elr), and
+// SA_RESTART is not supported.
+
+#include "vm/globals.h"
+#include "vm/instructions.h"
+#include "vm/signal_handler.h"
+#include "vm/simulator.h"
+#if defined(DART_HOST_OS_QNX)
+
+namespace dart {
+
+uintptr_t SignalHandler::GetProgramCounter(const mcontext_t& mcontext) {
+#if defined(HOST_ARCH_X64)
+  return static_cast<uintptr_t>(mcontext.cpu.rip);
+#elif defined(HOST_ARCH_ARM64)
+  return static_cast<uintptr_t>(mcontext.cpu.elr);
+#else
+#error Unsupported architecture.
+#endif
+}
+
+uintptr_t SignalHandler::GetFramePointer(const mcontext_t& mcontext) {
+#if defined(HOST_ARCH_X64)
+  return static_cast<uintptr_t>(mcontext.cpu.rbp);
+#elif defined(HOST_ARCH_ARM64)
+  return static_cast<uintptr_t>(mcontext.cpu.gpr[AARCH64_REG_X29]);
+#else
+#error Unsupported architecture.
+#endif
+}
+
+uintptr_t SignalHandler::GetCStackPointer(const mcontext_t& mcontext) {
+#if defined(HOST_ARCH_X64)
+  return static_cast<uintptr_t>(mcontext.cpu.rsp);
+#elif defined(HOST_ARCH_ARM64)
+  return static_cast<uintptr_t>(mcontext.cpu.gpr[AARCH64_REG_SP]);
+#else
+#error Unsupported architecture.
+#endif
+}
+
+uintptr_t SignalHandler::GetDartStackPointer(const mcontext_t& mcontext) {
+#if defined(TARGET_ARCH_ARM64) && !defined(DART_INCLUDE_SIMULATOR)
+  return static_cast<uintptr_t>(mcontext.cpu.gpr[SPREG]);
+#else
+  return GetCStackPointer(mcontext);
+#endif
+}
+
+uintptr_t SignalHandler::GetLinkRegister(const mcontext_t& mcontext) {
+#if defined(HOST_ARCH_X64)
+  return 0;
+#elif defined(HOST_ARCH_ARM64)
+  return static_cast<uintptr_t>(mcontext.cpu.gpr[AARCH64_REG_LR]);
+#else
+#error Unsupported architecture.
+#endif
+}
+
+void SignalHandler::Install(SignalAction action) {
+  struct sigaction act = {};
+  act.sa_sigaction = action;
+  sigemptyset(&act.sa_mask);
+  sigaddset(&act.sa_mask, SIGPROF);  // Prevent nested signals.
+  act.sa_flags = SA_SIGINFO;          // QNX: no SA_RESTART
+  int r = sigaction(SIGPROF, &act, nullptr);
+  ASSERT(r == 0);
+}
+
+void SignalHandler::Remove() {
+  // Ignore future SIGPROF signals because by default SIGPROF will terminate
+  // the process and we may have some signals in flight.
+  struct sigaction act = {};
+  act.sa_handler = SIG_IGN;
+  sigemptyset(&act.sa_mask);
+  int r = sigaction(SIGPROF, &act, nullptr);
+  ASSERT(r == 0);
+}
+
+}  // namespace dart
+
+#endif  // defined(DART_HOST_OS_QNX)
