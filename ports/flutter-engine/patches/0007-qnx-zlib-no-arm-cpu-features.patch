QNX: no ARM NEON/CRC32 code paths in zlib on QNX (they need Linux's
getauxval/HWCAP to detect the CPU features).

Upstream-Status: QNX-specific

diff --git a/engine/src/flutter/third_party/zlib/BUILD.gn b/engine/src/flutter/third_party/zlib/BUILD.gn
index eff72b2..60fb0d3 100644
--- a/engine/src/flutter/third_party/zlib/BUILD.gn
+++ b/engine/src/flutter/third_party/zlib/BUILD.gn
@@ -70,7 +70,8 @@ source_set("zlib_common_headers") {
 # TODO(ritownsend@google.com): Optimizations temporarily disabled for
 # Windows on Arm MSVC builds, see http://crbug.com/v8/10012.
 use_arm_neon_optimizations =
-    (current_cpu == "arm" || current_cpu == "arm64") && !(is_win && !is_clang)
+    (current_cpu == "arm" || current_cpu == "arm64") && !(is_win && !is_clang) &&
+    !is_qnx  # QNX: no getauxval()/HWCAP CPU feature detection
 
 use_x86_x64_optimizations =
     (current_cpu == "x86" || current_cpu == "x64") && !is_ios
