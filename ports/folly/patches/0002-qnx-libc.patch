--- a/folly/portability/SysMman.h
+++ b/folly/portability/SysMman.h
@@ -45,6 +45,27 @@
 #define MAP_POPULATE 0
 #endif
 
+#if defined(__QNX__) && !defined(MADV_NORMAL)
+// QNX has posix_madvise() but no madvise(). posix_madvise() returns the error
+// number instead of setting errno, which madvise()'s callers read; advice it
+// does not know (MADV_POPULATE_*, MADV_COLLAPSE) fails with EINVAL, as on a
+// kernel that predates it.
+#include <cerrno>
+#define MADV_NORMAL POSIX_MADV_NORMAL
+#define MADV_SEQUENTIAL POSIX_MADV_SEQUENTIAL
+#define MADV_RANDOM POSIX_MADV_RANDOM
+#define MADV_WILLNEED POSIX_MADV_WILLNEED
+#define MADV_DONTNEED POSIX_MADV_DONTNEED
+inline int madvise(void* addr, size_t len, int advice) {
+  int err = posix_madvise(addr, len, advice);
+  if (err != 0) {
+    errno = err;
+    return -1;
+  }
+  return 0;
+}
+#endif
+
 #else //_WIN32
 
 #include <cstdint>
