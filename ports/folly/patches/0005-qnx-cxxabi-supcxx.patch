 #include <folly/lang/Align.h>
 #include <folly/lang/New.h>
 
+//  QNX's C++ library is libc++, but its C++ ABI runtime (built into
+//  libc++.so) is GCC's libsupc++, not llvm's libc++abi: it exports no
+//  __cxa_increment_exception_refcount, and its exception objects have the
+//  libsupc++ layout (__cxa_refcounted_exception). The libsupc++ code paths
+//  below are therefore used there, not the libc++abi ones.
+#if defined(__GLIBCXX__) || (defined(__QNX__) && defined(_LIBCPP_VERSION))
+#define FOLLY_DETAIL_CXXABI_SUPCXX 1
+#else
+#define FOLLY_DETAIL_CXXABI_SUPCXX 0
+#endif
+#if FOLLY_DETAIL_CXXABI_SUPCXX && !defined(__GLIBCXX__)
+#ifndef _GLIBCXX_CDTOR_CALLABI
+#define _GLIBCXX_CDTOR_CALLABI
+#endif
+using _Atomic_word = int;
+#endif
+
