         }
 
-        if (spawn(term->reaper, term->cwd, binding->aux->pipe.args,
+        if (foot_spawn(term->reaper, term->cwd, binding->aux->pipe.args,
                   pipe_fd[0], stdout_fd, stderr_fd, NULL, NULL, NULL) < 0)
             goto pipe_err;
 
