+         auto release_accessor = reinterpret_cast<decltype(&bt_release_accessor)>(dlsym(bt, "bt_release_accessor"));
+         if (!init_accessor || !get_backtrace || !load_memmap || !sprnf_addrs || !unload_memmap || !release_accessor) {
+            return oss.str();
