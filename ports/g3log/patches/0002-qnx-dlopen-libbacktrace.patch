Open QNX's libbacktrace at dump time instead of linking it.

patches/0001 linked libg3log.so against libbacktrace.so.1, which needs
libunwind-nto.so.0. That library is part of the SDP but missing from many
QNX target images, where every program using g3log then failed to start
("Could not load library libunwind-nto.so.0") -- for a library used only to
print a stack dump on a crash. dlopen() it when a dump is wanted; without
it the dump is empty and logging works as before.

Upstream-Status: QNX-specific

--- a/Build.cmake
+++ b/Build.cmake
@@ -103,8 +103,8 @@
 
 # check for backtrace and cxa_demangle only in non-Windows dev environments
 IF(QNX)
-	# QNX has no execinfo backtrace(); stack dumps use QNX's own libbacktrace.
-	TARGET_LINK_LIBRARIES(${G3LOG_LIBRARY} backtrace)
+	# QNX has no execinfo backtrace(); stack dumps use QNX's own libbacktrace,
+	# opened with dlopen() when a dump is taken (crashhandler_unix.cpp).
 ELSEIF(NOT(MSVC OR MINGW))
 	# the backtrace module does not provide a modern cmake target
 	FIND_PACKAGE(Backtrace REQUIRED)
--- a/src/crashhandler_unix.cpp
+++ b/src/crashhandler_unix.cpp
@@ -18,6 +18,7 @@
 #include <cxxabi.h>
 #if defined(__QNX__)
 #include <backtrace.h>
+#include <dlfcn.h>
 #else
 #include <execinfo.h>
 #endif
@@ -144,27 +145,44 @@
