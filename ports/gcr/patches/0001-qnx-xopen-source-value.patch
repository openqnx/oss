gcr: give _XOPEN_SOURCE a value.

QNX's <sys/platform.h> accepts _XOPEN_SOURCE only as 500, 600 or 700; a bare
-D_XOPEN_SOURCE stops with "This version of XOPEN_SOURCE is not supported".
700 is the level that declares strptime(), which the flag is there for.

Upstream-Status: Pending

diff --git a/gck/meson.build b/gck/meson.build
index a21a1e9..22685f9 100644
--- a/gck/meson.build
+++ b/gck/meson.build
@@ -77,7 +77,10 @@ gck_cflags = [
   '-DGCK_API_SUBJECT_TO_CHANGE',
   '-DP11_KIT_API_SUBJECT_TO_CHANGE',
   '-DPKCS11_REGISTRY_DIR="@0@"'.format(get_option('prefix') / get_option('libdir') / 'pkcs11'),
-  '-D_XOPEN_SOURCE',   # Needed for strptime()
+  # QNX requires _XOPEN_SOURCE to name a version (500, 600 or 700); a bare
+  # definition trips "#error This version of XOPEN_SOURCE is not supported"
+  # in <sys/platform.h>. 700 is the level that declares strptime().
+  '-D_XOPEN_SOURCE=700',   # Needed for strptime()
   '-D_DEFAULT_SOURCE', # Needed for timegm
 ]
 
diff --git a/gcr/meson.build b/gcr/meson.build
index c83641b..d2c37b0 100644
--- a/gcr/meson.build
+++ b/gcr/meson.build
@@ -146,7 +146,10 @@ gcr_base_cflags = [
   '-DGCR_API_SUBJECT_TO_CHANGE',
   '-DGCK_API_SUBJECT_TO_CHANGE',
   '-DP11_KIT_API_SUBJECT_TO_CHANGE',
-  '-D_XOPEN_SOURCE',   # Needed for strptime()
+  # QNX requires _XOPEN_SOURCE to name a version (500, 600 or 700); a bare
+  # definition trips "#error This version of XOPEN_SOURCE is not supported"
+  # in <sys/platform.h>. 700 is the level that declares strptime().
+  '-D_XOPEN_SOURCE=700',   # Needed for strptime()
 ]
 
 gcr_base_symbolmap = meson.current_source_dir() / 'libgcr-base.map'
