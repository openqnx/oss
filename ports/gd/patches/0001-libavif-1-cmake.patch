Accept libavif 1.x in CMake (find_package without a 0.x version)

libavif's CMake package config declares SameMajorVersion compatibility, so
FIND_PACKAGE(libavif 0.8.2) rejects libavif 1.x ("version 1.1.1 ... not
accepted") although gd works with it. Ask for any version; 0.8.2 is the
minimum the comment keeps.

Upstream-Status: Pending (not QNX-specific: gd 2.3.3 predates libavif 1.0)

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -142,7 +142,7 @@
 	ENDIF (ENABLE_HEIF)
 
 	IF (ENABLE_AVIF)
-		FIND_PACKAGE(libavif 0.8.2 REQUIRED CONFIG)
+		FIND_PACKAGE(libavif REQUIRED CONFIG)  # 0.8.2 or later (1.x config files say SameMajorVersion)
 		SET(HAVE_LIBAVIF 1)
 		SET(AVIF_LIBRARIES avif)
 		SET(AVIF_FOUND 1)
