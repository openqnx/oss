+#ifdef __MINGW32__
+char *
+strcasestr(const char *const haystack, const char *const needle)
+{
+  char buff_h[1024];
+  char buff_n[1024];
+  const char *p;
+  int i;
+
+  p = haystack;
+  for (p = haystack, i = 0; *p && i < sizeof(buff_h)-1; ++p, ++i)
+    buff_h[i] = toupper(*p);
+  buff_h[i] = '\0';
+  for (p = needle, i = 0; *p && i < sizeof(buff_n)-1; ++p, ++i)
+    buff_n[i] = toupper(*p);
+  buff_n[i] = '\0';
+
+  return strstr(buff_h, buff_n);
+}
+#endif /* __MINGW32__ */
