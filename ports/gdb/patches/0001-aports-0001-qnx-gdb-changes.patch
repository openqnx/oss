+/* Call FUNC wrapped in a TRY/CATCH that swallows all GDB
+   exceptions. */
+static int
+catch_errors (int (*func) ())
+{
+  try
+    {
+      return func( );
+    }
+  catch (const gdb_exception_error &ex)
+    {
+      exception_print (gdb_stderr, ex);
+    }
+
+  return 1;
+}
