+static LONGEST
+nto_core_xfer_siginfo (struct gdbarch *gdbarch, gdb_byte *readbuf,
+       ULONGEST offset, ULONGEST len) {
+  struct thread_info *ti;
+  unsigned long maxlen;
+
+  gdb_assert( readbuf );
