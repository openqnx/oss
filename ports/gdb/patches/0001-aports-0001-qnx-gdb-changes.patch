+  DStMsg_memwr_t memwr;
+  DStMsg_regrd_t regrd;
+  DStMsg_regwr_t regwr;
+  DStMsg32_run_t run32;
+  DStMsg_run_t run;
+  DStMsg32_brk_t brk32;
+  DStMsg_brk_t brk;
