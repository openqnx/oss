+void
+pdebug_target::kill ( )
+{
+  nto_trace (0) ("pdebug_kill()\n");
+
+  remove_breakpoints ();
+
+  /* Use catch_errors so the user can quit from gdb even when we aren't on
+     speaking terms with the remote system.  */
+  catch_errors( nto_kill_1 );
+
+  mourn_inferior ( );
+
+  return;
+}
