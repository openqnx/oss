GIO: the fstab mount-point code on QNX without the sysctl user-mount check.

In 2.90.1 upstream takes the fstab branch of gunixmounts.c whenever
getfsent() exists (HAVE_GETFSENT), which QNX provides in <fstab.h>, so QNX
gets _g_get_unix_mount_points() without help (this patch used to add
HAVE_QNX to those #if lines). What remains: that branch asks sysctl
whether users may mount filesystems. Meson's has_function() finds
sysctlbyname on QNX, but libc exports no userspace sysctlbyname (only the
kernel-internal kernel_sysctlbyname), so linking fails; QNX also has no
user-mountable-filesystem setting to ask. Skip that check on QNX.

Upstream-Status: QNX-specific

--- a/gio/gunixmounts.c
+++ b/gio/gunixmounts.c
@@ -1627,13 +1627,17 @@
   GUnixMountPoint *mount_point;
   GList *return_list = NULL;
   G_LOCK_DEFINE_STATIC (fsent);
-#ifdef HAVE_SYS_SYSCTL_H
+#if defined(HAVE_SYS_SYSCTL_H) && !defined(HAVE_QNX)
   uid_t uid = getuid ();
   int usermnt = 0;
   struct stat sb;
 #endif
 
-#ifdef HAVE_SYS_SYSCTL_H
+/* HAVE_SYSCTLBYNAME is a false positive on QNX: meson's cc.has_function()
+ * accepts it, but libc exports no userspace sysctlbyname (only the
+ * kernel-internal kernel_sysctlbyname), so linking fails. QNX also has no
+ * user-mountable-filesystem concept to query. */
+#if defined(HAVE_SYS_SYSCTL_H) && !defined(HAVE_QNX)
 #if defined(HAVE_SYSCTLBYNAME)
   {
     size_t len = sizeof(usermnt);
@@ -1679,7 +1683,7 @@
       if (strcmp (fstab->fs_type, "ro") == 0)
 	is_read_only = TRUE;
 
-#ifdef HAVE_SYS_SYSCTL_H
+#if defined(HAVE_SYS_SYSCTL_H) && !defined(HAVE_QNX)
       if (usermnt != 0)
         {
           if (uid == 0 ||
