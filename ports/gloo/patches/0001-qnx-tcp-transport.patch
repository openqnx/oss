--- a/gloo/transport/tcp/loop.h
+++ b/gloo/transport/tcp/loop.h
@@ -19,6 +19,14 @@
 
 #include <sys/epoll.h>
 
+#if !defined(EPOLLONESHOT) && defined(__QNX__)
+// QNX's epoll has no EPOLLONESHOT. Loop emulates it: a descriptor
+// registered with this bit is taken out of the epoll set when its event is
+// reported, before its handler runs (which may register it again).
+#define EPOLLONESHOT (1u << 30)
+#define GLOO_EMULATE_EPOLLONESHOT 1
+#endif
+
