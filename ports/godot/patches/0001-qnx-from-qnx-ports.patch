+msgstr ""
+"Multiplie chaque composante du [Vector4] par le flottant [float] donné.\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) * 2) # Affiche (20.0, 40.0, 60.0, 80.0)\n"
+"[/codeblock]"
 
-msgid "Unknown device."
-msgstr "Périphérique inconnu."
+msgid "Multiplies each component of the [Vector4] by the given [int]."
+msgstr "Multiplie chaque composante du [Vector4] par l'entier [int] donné."
 
-msgid "Invalid control."
-msgstr "Contrôle invalide."
+msgid ""
+"Adds each component of the [Vector4] by the components of the given "
+"[Vector4].\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) + Vector4(3, 4, 5, 6)) # Prints (13.0, 24.0, "
+"35.0, 46.0)\n"
+"[/codeblock]"
+msgstr ""
+"Ajoute chaque composante du [Vector4] aux composantes du [Vector4] donné.\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) + Vector4(3, 4, 5, 6)) # Affiche (13.0, 24.0, "
+"35.0, 46.0)\n"
+"[/codeblock]"
 
-msgid "Memory allocation error."
-msgstr "Erreur d’allocation de mémoire."
+msgid ""
+"Subtracts each component of the [Vector4] by the components of the given "
+"[Vector4].\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) - Vector4(3, 4, 5, 6)) # Prints (7.0, 16.0, "
+"25.0, 34.0)\n"
+"[/codeblock]"
+msgstr ""
+"Sosutrait chaque composante du [Vector4] par les composantes du [Vector4] "
+"donné.\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) - Vector4(3, 4, 5, 6)) # Affiche (7.0, 16.0, "
+"25.0, 34.0)\n"
+"[/codeblock]"
 
-msgid "The most important data type in Godot."
-msgstr "Le plus important type de donnée dans Godot."
+msgid ""
+"Divides each component of the [Vector4] by the components of the given "
+"[Vector4].\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) / Vector4(2, 5, 3, 4)) # Prints (5.0, 4.0, "
