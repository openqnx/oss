+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="EditorExportPlatformQnx" inherits="EditorExportPlatformPC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
+	<brief_description>
+		Exporter for QNX.
+	</brief_description>
