+"[b]Esempio di risultato:[/b]\n"
+"[codeblock]\n"
+"## JSON.stringify(my_dictionary)\n"
+"{\"name\":\"my_dictionary\",\"version\":\"1.0.0\",\"entities\":[{\"name\":"
+"\"entity_0\",\"value\":\"value_0\"},{\"name\":\"entity_1\",\"value\":"
+"\"value_1\"}]}\n"
+"\n"
+"## JSON.stringify(my_dictionary, \"\\t\")\n"
+"{\n"
+"    \"name\": \"my_dictionary\",\n"
+"    \"version\": \"1.0.0\",\n"
+"    \"entities\": [\n"
+"        {\n"
+"            \"name\": \"entity_0\",\n"
+"            \"value\": \"value_0\"\n"
+"        },\n"
+"        {\n"
+"            \"name\": \"entity_1\",\n"
+"            \"value\": \"value_1\"\n"
+"        }\n"
+"    ]\n"
+"}\n"
+"\n"
+"## JSON.stringify(my_dictionary, \"...\")\n"
+"{\n"
+"...\"name\": \"my_dictionary\",\n"
+"...\"version\": \"1.0.0\",\n"
+"...\"entities\": [\n"
+"......{\n"
+".........\"name\": \"entity_0\",\n"
+".........\"value\": \"value_0\"\n"
+"......},\n"
+"......{\n"
+".........\"name\": \"entity_1\",\n"
+".........\"value\": \"value_1\"\n"
+"......}\n"
+"...]\n"
+"}\n"
+"[/codeblock]"
