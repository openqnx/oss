+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) * Vector4(3, 4, 5, 6)) # Affiche (30.0, 80.0, "
+"150.0, 240.0)\n"
+"[/codeblock]"
 
-msgid "Disconnected."
-msgstr "Déconnecté."
+msgid ""
+"Multiplies each component of the [Vector4] by the given [float].\n"
+"[codeblock]\n"
+"print(Vector4(10, 20, 30, 40) * 2) # Prints (20.0, 40.0, 60.0, 80.0)\n"
