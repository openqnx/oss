 	}
 }
 
+static void
+get_qnx_screen_backend(struct wlr_backend *backend, void*data)
+{
+	if(wlr_backend_is_qnx_screen(backend)){
+		struct wlr_backend **qnx_screen = data;
+		*qnx_screen = backend;
+	}
+}
+
 static void
 handle_renderer_lost(struct wl_listener *listener, void *data)
 {
@@ -545,6 +559,17 @@ server_init(void)
 	}
 	wlr_multi_backend_add(server.backend, server.headless.backend);
 
+	struct wlr_backend *qnx_backend = NULL;
+	wlr_multi_for_each_backend(server.backend,
+                get_qnx_screen_backend, &qnx_backend);
+
+	if (qnx_backend) {
+		server.qnx_redir = wlr_qnx_redir_create(server.wl_display, 1);
+		if(!server.qnx_redir) {
+			wlr_log(WLR_ERROR, "Unable to create wl_qnx_redir global");
+		}
+	}
+
