+ * @return Return EOK on success, otherwise an error
+ */
+int rpiIpaProcessData(RpiIpaHandle_t* handle,
+                      void* sensorMetadata,
+                      size_t sensorMetadataSize,
+                      void* ispMetadata,
+                      size_t ispMetadataSize,
+                      int32_t* exposureTime,
+                      int32_t* iso);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // RPI_CAMERA_IPA
