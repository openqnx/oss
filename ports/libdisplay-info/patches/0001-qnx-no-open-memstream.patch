Work without open_memstream() (QNX).

QNX 8's C library has no open_memstream(). The library's memory_stream
helper writes to a tmpfile() on QNX and reads the text back into a string on
close; di-edid-decode's join_str() builds its string directly.

(QNX's own package includes <sys/memstream.h> from a QNX add-on library that
is not part of the SDP; this keeps the port buildable with the SDP alone.)

Upstream-Status: QNX-specific

--- a/memory-stream.c
+++ b/memory-stream.c
@@ -2,6 +2,43 @@
 
 #include "memory-stream.h"
 
+#if defined(__QNX__)
+/*
+ * QNX 8 has no open_memstream(). Write to an anonymous temporary file and
+ * read it back into a string when the stream is closed -- same interface,
+ * same result.
+ */
+bool
+memory_stream_open(struct memory_stream *m)
+{
+	*m = (struct memory_stream){ 0 };
+	m->fp = tmpfile();
+	return m->fp != NULL;
+}
+
+char *
+memory_stream_close(struct memory_stream *m)
+{
+	char *str = NULL;
+	long len;
+
+	if (m->fp == NULL)
+		return NULL;
+	if (fflush(m->fp) == 0 && (len = ftell(m->fp)) >= 0 &&
+	    (str = malloc((size_t)len + 1)) != NULL) {
+		rewind(m->fp);
+		if (fread(str, 1, (size_t)len, m->fp) != (size_t)len) {
+			free(str);
+			str = NULL;
+		} else {
+			str[len] = '\0';
+		}
+	}
+	fclose(m->fp);
+	*m = (struct memory_stream){ 0 };
+	return str;
+}
+#else
 bool
 memory_stream_open(struct memory_stream *m)
 {
@@ -29,6 +66,8 @@
 	return str;
 }
 
+#endif
+
 void
 memory_stream_cleanup(struct memory_stream *m)
 {
