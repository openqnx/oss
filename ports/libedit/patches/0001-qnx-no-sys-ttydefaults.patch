libedit: no <sys/ttydefaults.h> on QNX.

Take the existing fallback CTRL() definition, which is what that header
would have provided.

Upstream-Status: QNX-specific

--- a/src/editline/readline.h
+++ b/src/editline/readline.h
@@ -78,7 +78,10 @@
 
 #ifndef CTRL
 #include <sys/ioctl.h>
-#if !defined(__sun) && !defined(__hpux) && !defined(_AIX)
+/* QNX has no <sys/ttydefaults.h>; the fallback CTRL() definition below is
+   the same one that header would have provided. */
+#if !defined(__sun) && !defined(__hpux) && !defined(_AIX) && \
+    !defined(__QNX__) && !defined(__QNXNTO__)
 #include <sys/ttydefaults.h>
 #endif
 #ifndef CTRL
