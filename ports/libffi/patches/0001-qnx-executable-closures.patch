libffi: allocate closures from executable mappings on QNX.

QNX never makes heap pages executable, so closures allocated from malloc()
faulted when called. Set FFI_MMAP_EXEC_WRIT so dlmmap() uses an anonymous
PROT_EXEC|PROT_WRITE mapping, which QNX allows.

Upstream-Status: QNX-specific

--- a/src/closures.c
+++ b/src/closures.c
@@ -141,6 +141,17 @@
    executable memory. */
 #  define FFI_MMAP_EXEC_WRIT 1
 # endif
+# if defined(__QNX__) || defined(__QNXNTO__)
+/* QNX enforces W^X for the heap: malloc'd pages are never executable, so
+   without this the closure allocator hands back ordinary heap memory and
+   calling through a closure jumps into the malloc arena and faults.  QNX
+   does allow an anonymous PROT_EXEC|PROT_WRITE mapping, which is what
+   dlmmap() below tries first; the temporary-file path stays as the
+   fallback.  HAVE_MNTENT is deliberately not set -- QNX has no
+   <mntent.h> -- so the fallback uses the fixed /tmp, /var/tmp, $TMPDIR
+   list instead of scanning mounted filesystems.  */
+#  define FFI_MMAP_EXEC_WRIT 1
+# endif
 #endif
 
 #if FFI_MMAP_EXEC_WRIT && defined(__linux__) && !defined(__ANDROID__)
