Build as C99 on QNX.

libgit2 sets C_STANDARD 90 on its targets, so CMake passes -std=c90. QNX's
<time.h>, <stdlib.h> and <sys/process.h> declare static inline helpers, and
every file fails with "unknown type name 'inline'". Use C99 on QNX only.

Upstream-Status: QNX-specific

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,6 +8,15 @@
 
 project(libgit2 VERSION "1.8.4" LANGUAGES C)
 
+# libgit2 builds as strict C90. QNX's libc headers use "static inline" in
+# <time.h>, <stdlib.h> and <sys/process.h>, which C90 does not have, so on
+# QNX build as C99 instead.
+if(QNX)
+	set(GIT_C_STANDARD 99)
+else()
+	set(GIT_C_STANDARD 90)
+endif()
+
 # Add find modules to the path
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${PROJECT_SOURCE_DIR}/cmake")
 
--- a/fuzzers/CMakeLists.txt
+++ b/fuzzers/CMakeLists.txt
@@ -20,7 +20,7 @@
 	endif()
 
 	add_executable(${fuzz_target_name} ${${fuzz_target_name}_SOURCES})
-	set_target_properties(${fuzz_target_name} PROPERTIES C_STANDARD 90)
+	set_target_properties(${fuzz_target_name} PROPERTIES C_STANDARD ${GIT_C_STANDARD})
 
 	target_include_directories(${fuzz_target_name} PRIVATE ${LIBGIT2_INCLUDES} ${LIBGIT2_DEPENDENCY_INCLUDES})
 	target_include_directories(${fuzz_target_name} SYSTEM PRIVATE ${LIBGIT2_SYSTEM_INCLUDES})
