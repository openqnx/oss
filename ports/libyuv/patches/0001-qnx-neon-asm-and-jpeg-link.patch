libyuv: link libjpeg into the libraries; fix an aarch64 asm operand.

With HAVE_JPEG the MJPEG decoder is compiled into libyuv itself, but only the
yuvconvert tool linked libjpeg, leaving libyuv.so with unresolved jpeg_*
symbols. In row_neon64.cc, ld1 takes its shuffle table through a register
address operand: the "m" constraint gave GCC an addressing form ld1 does not
accept.

Upstream-Status: Pending

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 636531e..5ed9065 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,11 @@ INCLUDE ( FindJPEG )
 if (JPEG_FOUND)
   include_directories( ${JPEG_INCLUDE_DIR} )
   target_link_libraries( yuvconvert ${JPEG_LIBRARY} )
+  # -DHAVE_JPEG compiles the MJPEG decoder into the libraries too, so they
+  # need libjpeg as well -- upstream only links the yuvconvert tool, which
+  # leaves libyuv.so with unresolved jpeg_* symbols and no DT_NEEDED entry.
+  target_link_libraries( ${ly_lib_shared} ${JPEG_LIBRARY} )
+  target_link_libraries( ${ly_lib_static} ${JPEG_LIBRARY} )
   add_definitions( -DHAVE_JPEG )
 endif()
 
