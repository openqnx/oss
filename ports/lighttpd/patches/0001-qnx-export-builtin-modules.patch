diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index cf28807..6844776 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -12,6 +12,12 @@ include(LighttpdMacros)
 
 add_definitions(-D_TIME_BITS=64 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGE_FILES -D_DEFAULT_SOURCE)
 
+# QNX: keep the build machine's path out of the __FILE__ names lighttpd
+# prints in its error log.
+if(CMAKE_SYSTEM_NAME STREQUAL "QNX")
+	add_compile_options("-fmacro-prefix-map=${CMAKE_SOURCE_DIR}/=")
+endif()
+
 # default to ON
 set(CMAKE_POSITION_INDEPENDENT_CODE ON CACHE BOOL "Default value for ``POSITION_INDEPENDENT_CODE`` of targets.")
 
@@ -1155,6 +1161,16 @@ if(CMAKE_C_COMPILER_ID MATCHES "GNU" OR CMAKE_C_COMPILER_ID MATCHES "Clang")
 	endif()
 endif()
 
+# QNX: CMake identifies qcc as "QCC", so the GNU branch above is skipped and
+# the server was linked without -export-dynamic. The built-in modules
+# (mod_indexfile, mod_staticfile, ...) are then invisible to
+# dlsym(RTLD_DEFAULT, "mod_x_plugin_init"), lighttpd falls back to
+# dlopen()ing lib/lighttpd/mod_x.so, which is never built, and every config
+# fails with "loading plugins finally failed".
+if(CMAKE_SYSTEM_NAME STREQUAL "QNX")
+	add_target_properties(lighttpd LINK_FLAGS "-Wl,--export-dynamic")
+endif()
+
 set_target_properties(lighttpd PROPERTIES CMAKE_INSTALL_PREFIX ${CMAKE_INSTALL_PREFIX})
 
 if(WIN32)
