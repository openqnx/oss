From 3b38719207a72875c6d289b4f843160b0aced7d4 Mon Sep 17 00:00:00 2001
From: Marcin Sochacki <msochacki@qnx.com>
Date: Tue, 1 Sep 2026 18:10:33 +0200
Subject: [PATCH 5/6] use the single /dev/bpf clone device


Imported from qnx-ports/lldpd (3b38719207a7, branch qnx-1.0.22, based on upstream 1.0.22);
original authorship kept.
Upstream-Status: QNX-specific (carried in the qnx-ports fork)

---
 src/daemon/priv-bsd.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/daemon/priv-bsd.c b/src/daemon/priv-bsd.c
index fcee9250e..4deed117b 100644
--- a/src/daemon/priv-bsd.c
+++ b/src/daemon/priv-bsd.c
@@ -102,7 +102,7 @@ asroot_iface_init_os(int ifindex, char *name, int *fd)
 	struct bpf_program fprog = { .bf_insns = filter,
 		.bf_len = sizeof(filter) / sizeof(struct bpf_insn) };
 
-#ifndef HOST_OS_SOLARIS
+#if !defined HOST_OS_SOLARIS && !defined HOST_OS_QNX
 	int n = 0;
 	char dev[20];
 	do {
@@ -110,6 +110,14 @@ asroot_iface_init_os(int ifindex, char *name, int *fd)
 		*fd = open(dev, O_RDWR);
 	} while (*fd < 0 && errno == EBUSY);
 #else
+	/* Solaris and QNX both provide a single, non-numbered /dev/bpf
+	 * cloning device rather than FreeBSD's numbered /dev/bpf0, /dev/bpf1,
+	 * ... scheme - confirmed on QNX 8.0 by inspection (only /dev/bpf
+	 * exists as a device node; there is no /dev/bpf0). Without this, the
+	 * numbered-device loop above fails immediately on the very first
+	 * attempt with ENOENT (not EBUSY, so the retry loop never even
+	 * iterates), logged as "unable to find a free BPF: No such file or
+	 * directory". */
 	*fd = open("/dev/bpf", O_RDWR);
 #endif
 	if (*fd < 0) {

