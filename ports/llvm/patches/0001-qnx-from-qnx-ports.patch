+                    const llvm::opt::ArgList &Args,
+                    const char *LinkingOutput) const override;
+};
+} // end namespace QNX
+} // end namespace tools
+
+namespace toolchains {
+
+class LLVM_LIBRARY_VISIBILITY QNX : public Generic_ELF {
