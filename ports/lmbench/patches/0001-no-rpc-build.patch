Build without Sun RPC (NO_RPC / NO_PORTMAPPER).

QNX has no Sun RPC (<rpc/rpc.h>, portmapper). With -DNO_RPC bench.h does not
include the RPC headers; with -DNO_PORTMAPPER the TCP helpers use the
benchmark's program number as the port number instead of registering it with
the portmapper, as the UDP helpers already do. lat_rpc, the one benchmark
that is RPC itself, is dropped from the build.

qnx-ports builds lmbench with the same NO_RPC idea (its tree is not public).

Upstream-Status: QNX-specific

--- a/src/bench.h
+++ b/src/bench.h
@@ -43,10 +43,14 @@
 #ifdef HAVE_SCHED_SETAFFINITY
 #include	<sched.h>
 #endif
+#ifndef NO_RPC
 #define PORTMAP
 #include	<rpc/rpc.h>
 #endif
+#endif
+#ifndef NO_RPC
 #include	<rpc/types.h>
+#endif
 
 #include 	<stdarg.h>
 #ifndef HAVE_uint
@@ -358,8 +362,10 @@
 #define XACT_VERS ((u_long)1)
 #define RPC_XACT ((u_long)1)
 #define RPC_EXIT ((u_long)2)
+#ifndef NO_RPC
 extern char *rpc_xact_1(char *msg, register SVCXPRT *transp);
 extern char *client_rpc_xact_1(char *argp, CLIENT *clnt);
+#endif
 
 void lmbench_usage(int argc, char *argv[], char* usage);
 
--- a/src/lib_tcp.c
+++ b/src/lib_tcp.c
@@ -33,6 +33,12 @@
 	if (prog < 0) {
 		s.sin_port = htons(-prog);
 	}
+#ifdef	NO_PORTMAPPER
+	else if (prog > 0) {
+		/* no portmapper: the program number is the port */
+		s.sin_port = htons((u_short)prog);
+	}
+#endif
 	if (bind(sock, (struct sockaddr*)&s, sizeof(s)) < 0) {
 		perror("bind");
 		exit(2);
@@ -45,12 +51,14 @@
 #ifdef	LIBTCP_VERBOSE
 		fprintf(stderr, "Server port %d\n", sockport(sock));
 #endif
+#ifndef	NO_PORTMAPPER
 		(void)pmap_unset((u_long)prog, (u_long)1);
 		if (!pmap_set((u_long)prog, (u_long)1, (u_long)IPPROTO_TCP,
 		    (unsigned short)sockport(sock))) {
 			perror("pmap_set");
 			exit(5);
 		}
+#endif
 	}
 	return (sock);
 }
@@ -61,9 +69,11 @@
 int
 tcp_done(int prog)
 {
+#ifndef	NO_PORTMAPPER
 	if (prog > 0) {
 		pmap_unset((u_long)prog, (u_long)1);
 	}
+#endif
 	return (0);
 }
 
@@ -160,8 +170,12 @@
 		s.sin_family = AF_INET;
 		bcopy((void*)h->h_addr, (void *)&s.sin_addr, h->h_length);
 		if (prog > 0) {
+#ifdef	NO_PORTMAPPER
+			save_port = (u_short)prog;
+#else
 			save_port = pmap_getport(&s, prog,
 			    (u_long)1, IPPROTO_TCP);
+#endif
 			if (!save_port) {
 				perror("lib TCP: No port found");
 				exit(3);
