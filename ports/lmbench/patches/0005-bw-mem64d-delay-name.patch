Rename bw_mem64d's static delay() to nop_delay().

QNX's <unistd.h> declares delay(unsigned int) (sleep for milliseconds), so
the file-local delay(int) that spins for a number of NOPs conflicts with it:
conflicting types for 'delay'.

Upstream-Status: QNX-specific

--- a/src/bw_mem64d.c
+++ b/src/bw_mem64d.c
@@ -148,7 +148,7 @@
 	free(state->buf);
 }
 
-static inline void delay(int nr_nop)
+static inline void nop_delay(int nr_nop)
 {
 	for (register int j = 0; j < nr_nop; j++)
 		asm volatile("nop");
@@ -165,7 +165,7 @@
 	while (iterations-- > 0) {
 	    register TYPE *p = state->buf;
 	    while (p <= lastone) {
-#define	DOIT(i)     sum += p[i]; delay(nr_nop);
+#define	DOIT(i)     sum += p[i]; nop_delay(nr_nop);
 		DOIT(0) DOIT(2) DOIT(4) DOIT(6) DOIT(8) DOIT(10) DOIT(12)
 		DOIT(14) DOIT(16) DOIT(18) DOIT(20) DOIT(22) DOIT(24) DOIT(26)
 		DOIT(28) DOIT(30) DOIT(32) DOIT(34) DOIT(36) DOIT(38) DOIT(40)
@@ -189,7 +189,7 @@
 	while (iterations-- > 0) {
 	    register TYPE *p = state->buf;
