--- a/src/test-mp-equation.c	2025-10-15 17:46:03.000000000 +0000
+++ b/src/test-mp-equation.c	2025-10-15 17:49:22.000000000 +0000
@@ -18,6 +18,30 @@
 #include "mp-serializer.h"
 #include "unit-manager.h"
 
+#ifdef __QNX__
+static char *qnx_fix_decimal_separator(const char *input)
+{
+    char *result;
+    size_t i, len;
+    
+    if (!input) return NULL;
+    
+    len = strlen(input);
+    result = g_malloc(len + 1);
+    
+    for (i = 0; i < len; i++) {
+        if (input[i] == 'U' && i > 0 && i < len - 1 &&
+            g_ascii_isdigit(input[i-1]) && g_ascii_isdigit(input[i+1])) {
+            result[i] = '.';
+        } else {
+            result[i] = input[i];
+        }
+    }
+    result[len] = '\0';
+    return result;
+}
+#endif
+
