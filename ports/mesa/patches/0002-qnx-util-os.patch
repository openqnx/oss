Teach Mesa's OS utilities about QNX

QNX was not among the operating systems Mesa's utilities know:
- detect_os.h: DETECT_OS_QNX, and DETECT_OS_POSIX for it, so the POSIX
  paths (dlfcn.h/dladdr, clock_gettime, sysconf, process name) are taken
  instead of "#error Unsupported OS";
- u_endian.h: QNX has no <endian.h>; take the byte order from the
  compiler's __BYTE_ORDER__;
- os_misc.c: the POSIX headers, and the available memory from
  sysconf(_SC_AVPHYS_PAGES) (no /proc/meminfo);
- build_id.c: QNX declares dl_iterate_phdr() in <sys/link.h> (no
  <link.h>), without the ElfW() macro, and passes the callback a const
  struct dl_phdr_info *.

Upstream-Status: QNX-specific

--- a/src/util/build_id.c
+++ b/src/util/build_id.c
@@ -27,6 +27,7 @@
 #if HAVE_BUILD_ID
 #include <dlfcn.h>
 #include <stddef.h>
+#include <stdint.h>
 #include <string.h>
 
 #include "macros.h"
@@ -38,7 +39,17 @@
    const struct uuid_command uuid_cmd;
 };
 #else
+#ifdef __QNX__
+/* QNX declares dl_iterate_phdr() in <sys/link.h>, without ElfW(). */
+#include <sys/link.h>
+#if defined(__LP64__)
+#define ElfW(type) Elf64_##type
+#else
+#define ElfW(type) Elf32_##type
+#endif
+#else
 #include <link.h>
+#endif
 #ifndef NT_GNU_BUILD_ID
 #define NT_GNU_BUILD_ID 3
 #endif
@@ -95,7 +106,12 @@
 }
 #else
 static int
+#ifdef __QNX__
+/* QNX's dl_iterate_phdr() passes a const struct dl_phdr_info *. */
+build_id_find_nhdr_callback(const struct dl_phdr_info *info, size_t size, void *data_)
+#else
 build_id_find_nhdr_callback(struct dl_phdr_info *info, size_t size, void *data_)
+#endif
 {
    struct callback_data *data = data_;
 
