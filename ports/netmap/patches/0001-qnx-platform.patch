 	size_t len = sizeof(mib);
 	sysctl(mib, 2, &ncpus, &len, NULL, 0);
-#elif defined(linux)
+#elif defined(linux) || defined(__QNXNTO__)
 	ncpus = sysconf(_SC_NPROCESSORS_ONLN);
 #elif defined(_WIN32)
