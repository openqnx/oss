Compute file sizes from st_blocks as off_t (unsigned blkcnt_t on QNX)

QNX's blkcnt_t (struct stat st_blocks) is unsigned (FreeBSD's is
signed, glibc's blkcnt_t is signed too), so st_blocks * 512 compared with
or chosen against the signed off_t st_size is a signed/unsigned
comparison, which nginx's -Werror build refuses (ngx_file.c). The block
count of a file is far below off_t's range: compute it as off_t.

Upstream-Status: QNX-specific

--- a/src/os/unix/ngx_files.h
+++ b/src/os/unix/ngx_files.h
@@ -186,9 +186,9 @@
 #define ngx_file_access(sb)      ((sb)->st_mode & 0777)
 #define ngx_file_size(sb)        (sb)->st_size
 #define ngx_file_fs_size(sb)                                                 \
-    (((sb)->st_blocks * 512 > (sb)->st_size                                  \
-     && (sb)->st_blocks * 512 < (sb)->st_size + 8 * (sb)->st_blksize)        \
-     ? (sb)->st_blocks * 512 : (sb)->st_size)
+    (((off_t) (sb)->st_blocks * 512 > (sb)->st_size                          \
+     && (off_t) (sb)->st_blocks * 512 < (sb)->st_size + 8 * (sb)->st_blksize) \
+     ? (off_t) (sb)->st_blocks * 512 : (sb)->st_size)
 #define ngx_file_mtime(sb)       (sb)->st_mtime
 #define ngx_file_uniq(sb)        (sb)->st_ino
 
@@ -282,7 +282,7 @@
 #define ngx_de_access(dir)       (((dir)->info.st_mode) & 0777)
 #define ngx_de_size(dir)         (dir)->info.st_size
 #define ngx_de_fs_size(dir)                                                  \
-    ngx_max((dir)->info.st_size, (dir)->info.st_blocks * 512)
+    ngx_max((dir)->info.st_size, (off_t) (dir)->info.st_blocks * 512)
 #define ngx_de_mtime(dir)        (dir)->info.st_mtime
 
 
