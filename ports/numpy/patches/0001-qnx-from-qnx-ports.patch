From 0725a2c279d3421ece6aa9eebb5c8993c1822247 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Mon, 8 Dec 2025 16:25:18 -0500
Subject: [PATCH 2/3] Fix bug when detecting on-target compiler for tests

The test code, especially the f2py test code, wants to find an on-target
compiler (meson) to help execute the tests. There is an explicit check
to make sure such a compiler exists before running the test. If it
doesn't exist, then the test is skipped.

The check had a bug where it would treat a subprocess.CalledProcessError
as an indication that the compiler is absent. However this is only
thrown when both check==True and the subprocess returns a non-zero
return code. Since check is explicitly set to False, it will never get
thrown.

Instead, catch a FileNotFoundError. That appears to be what is thrown
when the compiler can't be found.
---
 numpy/f2py/tests/util.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/numpy/f2py/tests/util.py b/numpy/f2py/tests/util.py
index 35e5d3bd8ac0..ea98ba3c08c0 100644
--- a/numpy/f2py/tests/util.py
+++ b/numpy/f2py/tests/util.py
@@ -53,7 +53,7 @@
                 cwd=tmpdir,
                 capture_output=True,
             )
-        except subprocess.CalledProcessError:
+        except FileNotFoundError:
             pytest.skip("meson not present, skipping compiler dependent test", allow_module_level=True)
         return runmeson.returncode == 0
     finally:

From f6c94adf2a34c33e95f31f39cf84f15690de86a9 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Mon, 8 Dec 2025 16:27:50 -0500
Subject: [PATCH 3/3] Provide awareness of QNX for tests

Provide an easy way for tests to tell if they are running on QNX or not.
This will make it easier to disable/skip some tests that need
functionality not on QNX.

In the case that caused this work to be done, test_mem_policy wanted to
disable warnings if running on QNX.
---
 numpy/_core/tests/test_mem_policy.py | 4 +++-
 numpy/testing/__init__.pyi           | 2 ++
 numpy/testing/_private/utils.py      | 3 ++-
 numpy/testing/_private/utils.pyi     | 2 ++
 numpy/tests/test_public_api.py       | 4 ++--
 5 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/numpy/_core/tests/test_mem_policy.py b/numpy/_core/tests/test_mem_policy.py
index b9f971e73249..1be162cdc899 100644
--- a/numpy/_core/tests/test_mem_policy.py
+++ b/numpy/_core/tests/test_mem_policy.py
@@ -9,7 +9,7 @@
 
 import numpy as np
 from numpy._core.multiarray import get_handler_name
-from numpy.testing import IS_EDITABLE, IS_WASM, extbuild
+from numpy.testing import IS_EDITABLE, IS_WASM, extbuild, IS_QNX
 
 
 @pytest.fixture
@@ -25,6 +25,8 @@
         pytest.skip("Can't build module inside Wasm")
     if IS_EDITABLE:
         pytest.skip("Can't build module for editable install")
+    if IS_QNX:
+        pytest.skip("Can't build module on QNX target")
 
