 if sys.platform.startswith('linux'): # variations: linux2,linux-i386 (any others?)
     cpuinfo = LinuxCPUInfo
 elif sys.platform.startswith('irix'):
@@ -660,6 +992,14 @@ def _has_3dnowext(self):
 elif sys.platform.startswith('cygwin'):
