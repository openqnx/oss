   if (OPENBLAS_INSTALL_TESTS)
     install(TARGETS dgemm_thread_safety DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
@@ -20,6 +23,9 @@ endif()
 if (CPP_THREAD_SAFETY_TEST OR CPP_THREAD_SAFETY_GEMV)
   add_executable(dgemv_thread_safety dgemv_thread_safety.cpp) 
   target_link_libraries(dgemv_thread_safety ${OpenBLAS_LIBNAME})
+  if (QNX)
+    target_link_libraries(dgemv_thread_safety gomp)
