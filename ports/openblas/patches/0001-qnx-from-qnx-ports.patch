+++ b/common.h
@@ -707,6 +707,7 @@ __declspec(dllimport) int __cdecl omp_in_parallel(void);
 __declspec(dllimport) int __cdecl omp_get_num_procs(void);
 #endif
 
+#if !defined(__cplusplus) || __cplusplus >= 202302L
