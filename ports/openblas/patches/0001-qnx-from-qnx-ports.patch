   add_test(dgemv_thread_safety ${CMAKE_CURRENT_BINARY_DIR}/dgemv_thread_safety)
   if (OPENBLAS_INSTALL_TESTS)
     install(TARGETS dgemv_thread_safety DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
