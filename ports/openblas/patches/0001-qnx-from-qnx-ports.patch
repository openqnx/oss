From b56a74992ebe78a22eabb9878cd117d93a405a52 Mon Sep 17 00:00:00 2001
From: Deep Chordia <dchordia@blackberry.com>
Date: Thu, 2 Jan 2025 13:21:03 +0530
Subject: [PATCH 1/6] Synchronize libm linkage

Imported from qnx-ports/OpenBLAS (5ef8b1964658...qnx-0.3.28); original authorship kept.
Upstream-Status: QNX-specific (carried in the qnx-ports fork)


---
 ctest/CMakeLists.txt | 8 ++++----
 utest/CMakeLists.txt | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/ctest/CMakeLists.txt b/ctest/CMakeLists.txt
index c56a78346f..acaf6ace82 100644
--- a/ctest/CMakeLists.txt
+++ b/ctest/CMakeLists.txt
@@ -44,7 +44,7 @@ endif()
         string(REGEX REPLACE "-fopenmp" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
         target_link_libraries(x${float_char}cblat1 omp pthread)
   endif()
-  if(${CMAKE_SYSTEM_NAME} MATCHES "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD" OR ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
+  if(${CMAKE_SYSTEM_NAME} MATCHES "AIX|Android|Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|Darwin" OR QNX)
       target_link_libraries(x${float_char}cblat1 m)
   endif()
   add_test(NAME "x${float_char}cblat1"
@@ -73,7 +73,7 @@ endif()
         string(REGEX REPLACE "-fopenmp" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
         target_link_libraries(x${float_char}cblat2 omp pthread)
   endif()
-  if(${CMAKE_SYSTEM_NAME} MATCHES "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD" OR ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
+  if(${CMAKE_SYSTEM_NAME} MATCHES "AIX|Android|Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|Darwin" OR QNX)
     target_link_libraries(x${float_char}cblat2 m)
   endif()
   add_test(NAME "x${float_char}cblat2"
@@ -124,7 +124,7 @@ endif()
         string(REGEX REPLACE "-fopenmp" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
         target_link_libraries(x${float_char}cblat3 omp pthread)
   endif()
-  if(${CMAKE_SYSTEM_NAME} MATCHES "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD" OR ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
+  if(${CMAKE_SYSTEM_NAME} MATCHES "AIX|Android|Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|Darwin" OR QNX)
     target_link_libraries(x${float_char}cblat3 m)
   endif()
   if (USE_GEMM3M)
@@ -134,7 +134,7 @@ endif()
         string(REGEX REPLACE "-fopenmp" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
         target_link_libraries(x${float_char}cblat3 omp pthread)
   endif()
-  if(${CMAKE_SYSTEM_NAME} MATCHES "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD" OR ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
+  if(${CMAKE_SYSTEM_NAME} MATCHES "AIX|Android|Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|Darwin" OR QNX)
     target_link_libraries(x${float_char}cblat3_3m m)
   endif()
   endif()
diff --git a/utest/CMakeLists.txt b/utest/CMakeLists.txt
index 6a61899da5..bdb9c36025 100644
--- a/utest/CMakeLists.txt
+++ b/utest/CMakeLists.txt
@@ -138,7 +138,7 @@ add_executable(${OpenBLAS_utest_ext_bin} ${OpenBLAS_utest_ext_src})
 target_link_libraries(${OpenBLAS_utest_bin} ${OpenBLAS_LIBNAME})
 target_link_libraries(${OpenBLAS_utest_ext_bin} ${OpenBLAS_LIBNAME})
 
-if(${CMAKE_SYSTEM_NAME} MATCHES "Linux" OR ${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD" OR ${CMAKE_SYSTEM_NAME} MATCHES "QNX"  )
+if(${CMAKE_SYSTEM_NAME} MATCHES "AIX|Android|Linux|FreeBSD|OpenBSD|NetBSD|DragonFly|Darwin" OR QNX)
 target_link_libraries(${OpenBLAS_utest_bin} m)
 endif()
 

From faf0dd8bb91448e8a2e7d48a31646c139e43cdf9 Mon Sep 17 00:00:00 2001
From: Deep Chordia <dchordia@blackberry.com>
Date: Thu, 2 Jan 2025 14:56:58 +0530
Subject: [PATCH 2/6] Add OPENBLAS_INSTALL_TESTS CMake Option

---
 CMakeLists.txt                 |  2 ++
 cpp_thread_test/CMakeLists.txt |  6 ++++++
 ctest/CMakeLists.txt           | 28 ++++++++++++++++++++++++++++
 utest/CMakeLists.txt           |  5 +++++
 4 files changed, 41 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2006604146..30f04789c7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -67,6 +67,8 @@ if((BUILD_STATIC_LIBS AND BUILD_SHARED_LIBS) AND MSVC)
   set(BUILD_SHARED_LIBS OFF CACHE BOOL "Build static library" FORCE)
 endif()
 
+option(OPENBLAS_INSTALL_TESTS "Install the test binaries" OFF)
+
 # Add a prefix or suffix to all exported symbol names in the shared library.
 # Avoids conflicts with other BLAS libraries, especially when using
 # 64 bit integer interfaces in OpenBLAS.
diff --git a/cpp_thread_test/CMakeLists.txt b/cpp_thread_test/CMakeLists.txt
index 5eccb12ceb..9c98bfec61 100644
--- a/cpp_thread_test/CMakeLists.txt
+++ b/cpp_thread_test/CMakeLists.txt
@@ -11,6 +11,9 @@ if (CPP_THREAD_SAFETY_TEST)
   add_executable(dgemm_thread_safety dgemm_thread_safety.cpp) 
   target_link_libraries(dgemm_thread_safety ${OpenBLAS_LIBNAME})
   add_test( dgemm_thread_safety ${CMAKE_CURRENT_BINARY_DIR}/dgemm_thread_safety)
+  if (OPENBLAS_INSTALL_TESTS)
+    install(TARGETS dgemm_thread_safety DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+  endif()
 endif()
 
 
@@ -18,6 +21,9 @@ if (CPP_THREAD_SAFETY_TEST OR CPP_THREAD_SAFETY_GEMV)
   add_executable(dgemv_thread_safety dgemv_thread_safety.cpp) 
   target_link_libraries(dgemv_thread_safety ${OpenBLAS_LIBNAME})
   add_test(dgemv_thread_safety ${CMAKE_CURRENT_BINARY_DIR}/dgemv_thread_safety)
+  if (OPENBLAS_INSTALL_TESTS)
+    install(TARGETS dgemv_thread_safety DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+  endif()
 endif()
 
 endif()
diff --git a/ctest/CMakeLists.txt b/ctest/CMakeLists.txt
index acaf6ace82..30a3587d57 100644
--- a/ctest/CMakeLists.txt
+++ b/ctest/CMakeLists.txt
@@ -49,6 +49,10 @@ endif()
   endif()
   add_test(NAME "x${float_char}cblat1"
     COMMAND $<TARGET_FILE:x${float_char}cblat1>)
+  if (OPENBLAS_INSTALL_TESTS)
+    install(TARGETS x${float_char}cblat1 DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+    list(APPEND CTEST_ALL "./x${float_char}cblat1 || exit $?")
+  endif()
 
   #level2
 if (NOT NOFORTRAN)
@@ -78,6 +82,11 @@ endif()
   endif()
   add_test(NAME "x${float_char}cblat2"
     COMMAND ${test_helper} $<TARGET_FILE:x${float_char}cblat2> "${PROJECT_SOURCE_DIR}/ctest/${float_char}in2")
+  if (OPENBLAS_INSTALL_TESTS)
+    install(TARGETS x${float_char}cblat2 DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+    install(FILES "${PROJECT_SOURCE_DIR}/ctest/${float_char}in2" DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+    list(APPEND CTEST_ALL "./x${float_char}cblat2 < ./${float_char}in2 || exit $?")
+  endif()
 
   #level3
 if (NOT NOFORTRAN)
@@ -147,4 +156,23 @@ endif()
     COMMAND ${test_helper} $<TARGET_FILE:x${float_char}cblat3_3m> "${PROJECT_SOURCE_DIR}/ctest/${float_char}in3_3m")
     endif()
   endif()
+  if (OPENBLAS_INSTALL_TESTS)
+      install(TARGETS x${float_char}cblat3 DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+      install(FILES "${PROJECT_SOURCE_DIR}/ctest/${float_char}in3" DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+      list(APPEND CTEST_ALL "./x${float_char}cblat3 < ./${float_char}in3 || exit $?")
+      if (USE_GEMM3M)
+          if ((${float_char} STREQUAL "c") OR (${float_char} STREQUAL "z"))
+              install(TARGETS x${float_char}cblat3_3m DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+              install(FILES "${PROJECT_SOURCE_DIR}/ctest/${float_char}in3_3m" DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+              list(APPEND CTEST_ALL "./x${float_char}cblat3_3m < ./${float_char}in3_3m || exit $?")
+          endif()
+      endif()
+  endif()
+
 endforeach()
+
+if (OPENBLAS_INSTALL_TESTS)
+  list(JOIN CTEST_ALL "\n" CTEST_ALL_STR)
+  file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/openblas_ctests.sh "${CTEST_ALL_STR}")
+  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/openblas_ctests.sh" DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+endif()
diff --git a/utest/CMakeLists.txt b/utest/CMakeLists.txt
index bdb9c36025..9f3e1e1515 100644
--- a/utest/CMakeLists.txt
+++ b/utest/CMakeLists.txt
@@ -162,3 +162,8 @@ endif()
 
 add_test(${OpenBLAS_utest_bin} ${CMAKE_CURRENT_BINARY_DIR}/${OpenBLAS_utest_bin})
 add_test(${OpenBLAS_utest_ext_bin} ${CMAKE_CURRENT_BINARY_DIR}/${OpenBLAS_utest_bin})
+
+if (OPENBLAS_INSTALL_TESTS)
+  install(TARGETS ${OpenBLAS_utest_bin} DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+  install(TARGETS ${OpenBLAS_utest_ext_bin} DESTINATION "${CMAKE_INSTALL_BINDIR}/openblas_tests")
+endif()
\ No newline at end of file

From 44215092aa071bc4a76883c09bcbc90e5d0ef0de Mon Sep 17 00:00:00 2001
