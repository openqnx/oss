<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration><gap>0</gap></core>
  <theme><cornerRadius>6</cornerRadius>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>DejaVu Sans</name><size>10</size></font>
  </theme>
  <placement><policy>cascade</policy></placement>
  <keyboard>
    <keybind key="W-Return"><action name="Execute" command="xfce4-terminal"/></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar"/></keybind>
    <keybind key="W-space"><action name="ShowMenu" menu="root-menu"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
  <mouse><default/>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu" menu="root-menu"/></mousebind>
      <mousebind button="Left" action="Press"><action name="ShowMenu" menu="root-menu"/></mousebind>
    </context>
  </mouse>
</labwc_config>
