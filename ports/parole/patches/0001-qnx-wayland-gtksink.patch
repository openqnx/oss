diff -ru a/src/parole-player.c b/src/parole-player.c
--- a/src/parole-player.c	2025-05-21 15:46:43.000000000 +0900
+++ b/src/parole-player.c	2026-11-25 16:32:14.662386250 +0900
@@ -3618,6 +3618,16 @@
     gtk_widget_realize(player->priv->gst);
     gtk_widget_show(player->priv->gst);
 
+    /* gtksink (no X11): its widget shows the video; ParoleGst's own window,
+     * meant for an X11 video overlay, is not used. */
+    if (parole_gst_get_sink_widget(PAROLE_GST(player->priv->gst)) != NULL) {
+        GtkWidget *sink_widget = parole_gst_get_sink_widget(PAROLE_GST(player->priv->gst));
+        gtk_widget_hide(player->priv->gst);
+        gtk_widget_set_no_show_all(player->priv->gst, TRUE);
+        gtk_box_pack_start(GTK_BOX(player->priv->videobox), sink_widget, TRUE, TRUE, 0);
+        gtk_widget_show(sink_widget);
+    }
+
     gtk_widget_grab_focus(player->priv->gst);
 
     parole_gst_set_default_aspect_ratio(player, builder);
