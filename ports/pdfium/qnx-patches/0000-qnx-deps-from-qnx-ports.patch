From 8971da9e2c1fe8fac247c75fd4dacc7c1575ee4a Mon Sep 17 00:00:00 2001
From: Yongxin Dai <yodai@qnx.com>
Date: Mon, 23 Jun 2025 15:43:43 -0400
Subject: [PATCH] [QNX Base] Update DEPS to support QNX OS

Imported from qnx-ports/pdfium (commit 8971da9e2c1f on 84a8011ec69d).
Upstream-Status: QNX-specific (carried in the qnx-ports fork)
Changed here: qnx_build (qnx-ports/build-files) pinned to commit 6f1507550d65.

- Add dependency: qnx_build
- Add hooks to initialize QNX build system and
  apply necessary changes
---
 DEPS | 40 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/DEPS b/DEPS
index 08d0a2c34f..a07d9322d7 100644
--- a/DEPS
+++ b/DEPS
@@ -221,6 +221,10 @@ vars = {
   # the commit queue can handle CLs rolling zlib
   # and whatever else without interference from each other.
   'zlib_revision': 'c7678ba8af4577e45023b35ae96b6b71efa0acf7',
+
+  'checkout_qnx': False,
+  'qnx_build_files': 'https://github.com/qnx-ports/build-files.git',
+  'qnx_build_files_revision': '6f1507550d656edafbf8bcc826a196da1b00c459'
 }
 
 # Only these hosts are allowed for dependencies in this DEPS file.
@@ -587,6 +591,10 @@ deps = {
     'condition': 'checkout_v8',
   },
 
+  'qnx_build': {
+    'url': Var('qnx_build_files') + '@' + Var('qnx_build_files_revision'),
+    'condition': 'checkout_qnx',
+  },
 }
 
 recursedeps = [
@@ -769,4 +777,36 @@ hooks = [
                '--quiet',
                ],
   },
+
+  # Apply changes made for QNX.
+  {
+    'name': 'appple_qnx_patches',
+    'pattern': '.',
+    'condition': 'checkout_qnx',
+    'action': [
+        'python3',
+        'qnx_build/ports/pdfium/scripts/apply_patches.py'
+        ],
+  },
+
+  # Apply changes made into third-party reositories by QNX.
+  {
+    'name': 'appple_qnx_ancillary_patches',
+    'pattern': '.',
+    'condition': 'checkout_qnx',
+    'action': [
+        'python3',
+        'qnx_build/ports/pdfium/scripts/apply_ancillary_patches.py'
+        ],
+  },
+
+  {
+    'name': 'initialize_build_structure',
+    'pattern': '.',
+    'condition': 'checkout_qnx',
+    'action': [
+        'python3',
+        'qnx_build/ports/pdfium/scripts/generate_supplementary_files.py'
+        ],
+  },
 ]
