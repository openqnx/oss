Build on QNX: select() headers, ioctl, RTS/CTS flow control.

- picocom.c uses select(), fd_set and struct timeval without including
  <sys/select.h>/<sys/time.h>, which glibc pulls in through other headers
  and QNX does not.
- term.c only uses the modem-control ioctls (TIOCMGET/TIOCMSET) on a list of
  known systems; QNX supports them too.
- QNX has no CRTSCTS: hardware flow control is the pair of c_cflag bits
  IHFLOW | OHFLOW. Defining CRTSCTS as that pair keeps "--flow h" working
  (defining it as 0, as other QNX ports do, silently disables it).

Based on qnx-ports/build-files ports/picocom/0001-qnx-compat.patch.

Upstream-Status: QNX-specific

--- a/picocom.c
+++ b/picocom.c
@@ -23,6 +23,8 @@
  * USA
  */
 
+#include <sys/select.h>
+#include <sys/time.h>
 #include <stdlib.h>
 #include <stdio.h>
 #include <string.h>
--- a/term.c
+++ b/term.c
@@ -61,13 +61,18 @@
 #if defined(__linux__) || \
     defined(__FreeBSD__) || defined(__OpenBSD__) || \
     defined(__NetBSD__) || defined(__DragonFly__) || \
-    defined(__APPLE__)
+    defined(__APPLE__) || defined(__QNX__)
 #define USE_IOCTL
 #endif
 #ifdef USE_IOCTL
 #include <sys/ioctl.h>
 #endif
 
+#if defined(__QNX__) && !defined(CRTSCTS)
+/* QNX spells RTS/CTS hardware flow control as two termios c_cflag bits. */
+#define CRTSCTS (IHFLOW | OHFLOW)
+#endif
+
 #include "custbaud.h"
 #ifdef USE_CUSTOM_BAUD
 #include CUSTOM_BAUD_HEAD
