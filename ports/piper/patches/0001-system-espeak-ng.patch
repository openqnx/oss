Option to use the installed espeak-ng instead of building a private copy.

libpiper's build downloads espeak-ng with git, builds a private static
copy for the build machine's compiler and installs a second
share/espeak-ng-data. In a cross build that espeak-ng could not compile
its own data, and the workspace has espeak-ng as a component of its own.
PIPER_USE_SYSTEM_ESPEAK_NG=ON takes the installed one through pkg-config
(its shared library, nothing installed twice).

The program looked for espeak-ng-data next to its executable, found
through /proc/self/exe -- which QNX does not have (std::filesystem::
canonical() threw before any option was looked at). With the installed
espeak-ng there is nothing next to the executable: unless --espeak_data
is given, no path is passed and espeak-ng uses its own data directory.
Off by default, upstream's behaviour is unchanged.

Upstream-Status: QNX-specific

--- a/libpiper/CMakeLists.txt
+++ b/libpiper/CMakeLists.txt
@@ -5,6 +5,15 @@
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+# An espeak-ng that is already installed (found with pkg-config) instead of
+# a private static copy built here: its library is linked, its data is used
+# where it is installed, and nothing of it is installed again.
+option(PIPER_USE_SYSTEM_ESPEAK_NG "Use the installed espeak-ng (pkg-config) instead of building one" OFF)
+
+if(PIPER_USE_SYSTEM_ESPEAK_NG)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(ESPEAKNG REQUIRED IMPORTED_TARGET espeak-ng)
+else()
 include(ExternalProject)
 
 # Install location for espeak-ng
@@ -65,6 +74,8 @@
     ${ESPEAKNG_INSTALL_DIR}/include
 )
 
+endif()
+
 # ---- onnxruntime ---
 
 find_package(onnxruntime QUIET)
@@ -147,6 +158,17 @@
 )
 enable_clang_tidy(piper)
 
+if(PIPER_USE_SYSTEM_ESPEAK_NG)
+target_include_directories(piper PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/include
+)
+target_link_libraries(piper
+    PkgConfig::ESPEAKNG
+    onnxruntime::onnxruntime
+)
+# The program then leaves the data directory to espeak-ng (src/main/main.cpp).
+add_compile_definitions(PIPER_USE_SYSTEM_ESPEAK_NG)
+else()
 add_dependencies(piper espeak_ng_external)
 target_include_directories(piper PUBLIC
     ${ESPEAKNG_INSTALL_DIR}/include
@@ -157,6 +179,7 @@
     ${UCD_STATIC_LIB}
     onnxruntime::onnxruntime
 )
+endif()
 
 # ---- piper exe ---
 add_subdirectory(src/main)
@@ -202,10 +225,12 @@
 # Copy espeak-ng-data
 set(ESPEAKNG_DATA_SRC ${CMAKE_BINARY_DIR}/espeak_ng-install/share/espeak-ng-data)
 
+if(NOT PIPER_USE_SYSTEM_ESPEAK_NG)
 install(
     DIRECTORY ${ESPEAKNG_DATA_SRC}
     DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}
 )
+endif()
 
