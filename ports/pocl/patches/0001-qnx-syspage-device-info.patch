+#elif defined(__QNXNTO__)
+
+/* QNX has neither /sys nor /proc/meminfo: the system page describes the
+ * machine -- the number of CPUs, the "ram" address ranges and each CPU's
+ * chain of data caches. */
+
+#include <sys/neutrino.h>
+#include <sys/syspage.h>
+
+int
+pocl_topology_detect_device_info (cl_device_id device)
+{
+  const char *strings = SYSPAGE_ENTRY (strings)->data;
+  size_t i, count;
+
+  device->global_mem_cacheline_size = HOST_CPU_CACHELINE_SIZE;
+  device->global_mem_cache_type = CL_READ_WRITE_CACHE;
+
+  /* global mem cache size: the last (largest) level of CPU 0's data caches */
+  uint64_t cache_size = 0;
+  count = SYSPAGE_ENTRY_SIZE (cacheattr) / SYSPAGE_ELEMENT_SIZE (cacheattr);
+  size_t idx = SYSPAGE_ARRAY_IDX (cpuinfo, 0)->data_cache;
+  for (i = 0; idx != CACHE_LIST_END && idx < count && i < count; ++i)
+    {
+      struct cacheattr_entry *c = SYSPAGE_ARRAY_IDX (cacheattr, idx);
+      uint64_t size = (uint64_t)c->line_size * c->num_lines;
+      if (size > cache_size)
+        cache_size = size;
+      idx = c->next;
+    }
+  if (cache_size == 0)
+    {
+      POCL_MSG_WARN (
+        "Could not figure out CPU cache size, using bogus value\n");
+      cache_size = 1 << 20;
+    }
+  device->global_mem_cache_size = cache_size;
+
+  /* global_mem_size: the sum of the "ram" entries of the address space */
+  uint64_t ram = 0;
+  count = SYSPAGE_ENTRY_SIZE (asinfo) / SYSPAGE_ELEMENT_SIZE (asinfo);
+  for (i = 0; i < count; ++i)
+    {
+      struct asinfo_entry *as = SYSPAGE_ARRAY_IDX (asinfo, i);
+      if (strcmp (strings + as->name, "ram") == 0)
+        ram += as->end - as->start + 1;
+    }
+  if (ram == 0)
+    {
+      POCL_MSG_WARN ("Cannot get memory size\n");
+      ram = 256 << 20;
+    }
+  device->global_mem_size = ram;
+
+  /* max_compute_units */
+  device->max_compute_units = _syspage_ptr->num_cpu;
+  if (device->max_compute_units == 0)
+    device->max_compute_units = 1;
+
+  return 0;
+}
