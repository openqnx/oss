+#ifdef __QNXNTO__
+/* QNX gives the main thread a stack of 512 KiB and every other thread
+ * 256 KiB by default, where Linux gives 8 MiB to both. Clang's parser and
+ * semantic analysis, LLVM's passes and instruction selection and lld are
+ * deeply recursive and are written for the larger stack (the clang program
+ * itself runs its compilations on a thread with 8 MiB). So on QNX the
+ * threads PoCL creates get 8 MiB, and the compiler is entered through
+ * pocl_run_with_large_stack() when the application's thread has less.
+ * The stack is mapped lazily: only what is used takes memory. */
+
+int
+pocl_create_thread_large_stack (pthread_t *thr, void *(*func) (void *),
+                                void *arg)
+{
+  pthread_attr_t attr;
+  int err = pthread_attr_init (&attr);
+  if (err)
+    return err;
+  err = pthread_attr_setstacksize (&attr, POCL_QNX_LARGE_STACK_SIZE);
+  if (err == 0)
+    err = pthread_create (thr, &attr, func, arg);
+  pthread_attr_destroy (&attr);
+  return err;
+}
+
+struct pocl_large_stack_call
+{
+  void (*func) (void *);
+  void *arg;
+};
+
+static void *
+pocl_large_stack_trampoline (void *data)
+{
+  struct pocl_large_stack_call *call = (struct pocl_large_stack_call *)data;
+  call->func (call->arg);
+  return NULL;
+}
+
+void
+pocl_run_with_large_stack (void (*func) (void *), void *arg)
+{
+  struct pocl_large_stack_call call = { func, arg };
+  pthread_t thr;
+
+  /* the thread's stack size is in its thread local storage block */
+  if (__tls ()->__stacksize >= POCL_QNX_LARGE_STACK_SIZE
+      || pocl_create_thread_large_stack (&thr, pocl_large_stack_trampoline,
+                                         &call)
+           != 0)
+    {
+      func (arg);
+      return;
+    }
+  pthread_join (thr, NULL);
+}
+#endif
+
