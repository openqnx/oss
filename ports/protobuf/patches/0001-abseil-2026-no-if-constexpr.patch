+namespace internal {
+// abseil's utility_internal::IfConstexprElse (absl/utility/internal/
+// if_constexpr.h), which abseil 20260817 removed: calls true_func or
+// false_func with args, chosen at compile time, also before C++17.
+template <bool Condition, typename TrueFunc, typename FalseFunc, typename... Args>
+auto ArenaIfConstexprElse(TrueFunc&& true_func, FalseFunc&& false_func,
+                          Args&&... args) {
+  return std::get<Condition>(std::forward_as_tuple(
+      std::forward<FalseFunc>(false_func), std::forward<TrueFunc>(true_func)))(
+      std::forward<Args>(args)...);
+}
+}  // namespace internal
