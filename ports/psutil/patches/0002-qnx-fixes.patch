-def cpu_times():
-    """Return system CPU times as a namedtuple."""
-    # Not supported
+def per_cpu_times():
+    """Return system CPU times as a list of namedtuples, one per CPU.
+
+    QNX keeps no per-CPU user/system accounting; what it has is the CPU
+    time of procnto's idle threads (process 1, threads 1..N, one per CPU),
+    which is how QNX's own top and hogs compute load. Busy time is the
+    elapsed time since boot less a CPU's idle time; it is reported as
+    "system" (user and system cannot be told apart).
+    """
+    ncpu = cext.cpu_count_logical()
+    idle = dict(cext.proc_threads(1))
+    elapsed = max(0.0, time.time() - cext.boot_time())
+    ret = []
+    for i in range(1, ncpu + 1):
+        it = idle.get(i, 0) / 1e9
+        ret.append(ntp.scputimes(0.0, max(0.0, elapsed - it), it))
+    return ret
 
 
-def per_cpu_times():
-    """Return system CPU times as a named tuple."""
-    # Not supported
+def cpu_times():
+    """Return system CPU times as a namedtuple (sum over all CPUs)."""
+    percpu = per_cpu_times()
+    return ntp.scputimes(*[sum(x) for x in zip(*percpu)])
 
 
