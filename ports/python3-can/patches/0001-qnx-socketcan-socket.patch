+        # QNX: no PF_CAN in the network stack; the socket is qnx-socketcan's
+        from can.interfaces.socketcan.qnx import CanSocket
+
+        sock = CanSocket()
+    else:
+        sock = socket.socket(constants.PF_CAN, socket.SOCK_RAW, constants.CAN_RAW)
 
