+elif plat[:3] == 'qnx':      # QNX 8
+    class ReturnBaudrate(object):
+        def __getitem__(self, key):
+            return key
+
+    # c_cflag bits of QNX's <termios.h>: stick (mark/space) parity and
+    # hardware flow control (input RTS, output CTS). Python's termios
+    # module does not name them.
+    CMSPAR = 0x00000004     # PARSTK
+    QNX_IHFLOW = 0x00000001
+    QNX_OHFLOW = 0x00000002
+
+    class PlatformSpecific(PlatformSpecificBase):
+        # QNX takes the baud rate as a number (B115200 == 115200), so
+        # rates termios has no name for are passed on as they are.
+        BAUDRATE_CONSTANTS = ReturnBaudrate()
+
+        TIOCSBRK = 0x747B   # _IO('t', 123)
+        TIOCCBRK = 0x747A   # _IO('t', 122)
+
+        def _update_break_state(self):
+            """\
+            Set break: Controls TXD. When active, no transmitting is possible.
+            """
+            if self._break_state:
+                fcntl.ioctl(self.fd, PlatformSpecific.TIOCSBRK)
+            else:
+                fcntl.ioctl(self.fd, PlatformSpecific.TIOCCBRK)
+
