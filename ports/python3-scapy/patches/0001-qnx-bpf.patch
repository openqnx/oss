+def qnx_enable_reader(fd):
+    # type: (int) -> None
+    """QNX io-sock keeps a new BPF descriptor on the interface's writer-only
+    list: it sees no packet until BIOCSETF has been issued twice (libpcap
+    does that as a side effect of pcap_open_live() + pcap_setfilter()).
+    Install an accept-all program twice; a real filter replaces it later."""
+    from scapy.libs.structures import bpf_insn, bpf_program
+    insn = (bpf_insn * 1)()
+    insn[0].code = 0x06  # BPF_RET | BPF_K
+    insn[0].k = 0x40000
+    bp = bpf_program()
+    bp.bf_len = 1
+    bp.bf_insns = ctypes.cast(insn, ctypes.POINTER(bpf_insn))
+    for _ in range(2):
+        fcntl.ioctl(fd, BIOCSETF, bp)
+
