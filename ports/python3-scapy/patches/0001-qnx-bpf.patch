 IOCPARM_MASK = 0x1fff
-IOC_VOID = 0x20000000
+# QNX's <sys/ioctl.h> encodes a request without parameters with no
+# direction bits at all (BIOCPROMISC is 0x4269, not 0x20004269).
+IOC_VOID = 0 if QNX else 0x20000000
 IOC_OUT = 0x40000000
 IOC_IN = 0x80000000
 IOC_INOUT = IOC_IN | IOC_OUT
