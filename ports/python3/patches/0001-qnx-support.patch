--- a/Objects/mimalloc/prim/unix/prim.c
+++ b/Objects/mimalloc/prim/unix/prim.c
@@ -51,7 +51,10 @@
   #include <sys/sysctl.h>
 #endif
 
-#if !defined(__HAIKU__) && !defined(__APPLE__) && !defined(__CYGWIN__) && !defined(_AIX) && !defined(__OpenBSD__) && !defined(__FreeBSD__) && !defined(__sun) && !defined(__NetBSD__)
+// QNX is a microkernel: there is no <sys/syscall.h> and no stable syscall
+// number table to call through. Without MI_HAS_SYSCALL_H mimalloc uses the
+// ordinary open/read/close functions below, which is the intended fallback.
+#if !defined(__HAIKU__) && !defined(__APPLE__) && !defined(__CYGWIN__) && !defined(_AIX) && !defined(__OpenBSD__) && !defined(__FreeBSD__) && !defined(__sun) && !defined(__NetBSD__) && !defined(__QNX__) && !defined(__QNXNTO__)
   #define MI_HAS_SYSCALL_H
   #include <sys/syscall.h>
 #endif
@@ -153,8 +156,36 @@
 // mmap
 //---------------------------------------------
 
+#if defined(__QNX__) || defined(__QNXNTO__)
+// QNX has no madvise(); it provides POSIX's posix_madvise(), which reports
+// failure by *returning* the error number rather than setting errno. Translate
+// to the madvise convention, because the callers below inspect errno (they
+// retry on EAGAIN and fall back on EINVAL).
+//
+// MADV_DONTNEED is used here to decommit -- "it decreases rss immediately"
+// per the comment below -- and plain POSIX_MADV_DONTNEED is only advisory on
+// QNX. POSIX_MADV_DISCARD_NP is the one that actually drops the pages, so it
+// is the faithful equivalent; fall back to the portable name if absent.
+#if defined(POSIX_MADV_DISCARD_NP)
+  #define MADV_DONTNEED POSIX_MADV_DISCARD_NP
+#else
+  #define MADV_DONTNEED POSIX_MADV_DONTNEED
+#endif
+#define MADV_NORMAL     POSIX_MADV_NORMAL
+#define MADV_RANDOM     POSIX_MADV_RANDOM
+#define MADV_SEQUENTIAL POSIX_MADV_SEQUENTIAL
+#define MADV_WILLNEED   POSIX_MADV_WILLNEED
+// No MADV_FREE and no MADV_HUGEPAGE on QNX: leaving them undefined makes the
+// #if defined() guards above pick the MADV_DONTNEED path and skip the
+// transparent-huge-page hint, which QNX does not have either.
+#endif
+
 static int unix_madvise(void* addr, size_t size, int advice) {
-  #if defined(__sun)
+  #if defined(__QNX__) || defined(__QNXNTO__)
+  const int rc = posix_madvise(addr, size, advice);
+  if (rc != 0) { errno = rc; return -1; }
+  return 0;
+  #elif defined(__sun)
   return madvise((caddr_t)addr, size, advice);  // Solaris needs cast (issue #520)
   #else
   return madvise(addr, size, advice);
--- a/Include/internal/pycore_time.h
+++ b/Include/internal/pycore_time.h
@@ -59,6 +59,15 @@
 
 #include "pycore_runtime_structs.h" // _PyTimeFraction
 
+#if defined(__QNX__) || defined(__QNXNTO__)
+   // struct timeval reaches this header implicitly via <time.h> on glibc, but
+   // QNX declares it only in <sys/time.h>. Without it the declarations below
+   // build an incomplete "struct timeval" scoped to their own parameter lists,
+   // and pytime.c -- which does include <sys/time.h> -- then fails with
+   // "conflicting types for _PyTime_FromTimeval".
+#  include <sys/time.h>
+#endif
+
 #ifdef __clang__
 struct timeval;
 #endif
--- a/Modules/faulthandler.c
+++ b/Modules/faulthandler.c
@@ -1,4 +1,13 @@
 #include "Python.h"
+
+/* QNX 8.0 leaves SA_RESTART commented out in <signal.h> ("not supported yet"):
+   interrupted kernel calls always return EINTR rather than restarting, and the
+   EINTR retry loops elsewhere in CPython already handle that. Requesting the
+   flag is therefore a no-op, not a behaviour change. */
+#if (defined(__QNX__) || defined(__QNXNTO__)) && !defined(SA_RESTART)
+#  define SA_RESTART 0
+#endif
+
 #include "pycore_ceval.h"         // _PyEval_IsGILEnabled()
 #include "pycore_initconfig.h"    // _PyStatus_ERR()
 #include "pycore_pyerrors.h"      // _Py_DumpExtensionModules()
