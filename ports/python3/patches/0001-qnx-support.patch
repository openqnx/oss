--- a/Modules/termios.c
+++ b/Modules/termios.c
@@ -14,6 +14,20 @@
 #include <termios.h>
 #include <unistd.h>               // _POSIX_VDISABLE
 
+#if defined(__QNX__) || defined(__QNXNTO__)
+/* QNX's <sys/termio.h> and <termios.h> are mutually exclusive -- including
+   both ends in "#error termio/termios incompatibility" -- so this module is
+   built with termios alone and "struct termio" is never defined. The legacy
+   TC*A ioctl request codes are macros expressed as sizeof(struct termio),
+   so they cannot be evaluated here. They are the pre-POSIX interface that
+   termios replaced; dropping them leaves the POSIX TCGETS/TCSETS family,
+   which QNX does define. */
+#undef TCGETA
+#undef TCSETA
+#undef TCSETAF
+#undef TCSETAW
+#endif
+
 // On QNX 6, struct termio must be declared by including sys/termio.h
 // if TCGETA, TCSETA, TCSETAW, or TCSETAF are used. sys/termio.h must
 // be included before termios.h or it will generate an error.
