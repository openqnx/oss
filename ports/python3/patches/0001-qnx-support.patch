CPython: build for QNX.

- configure: recognise *-nto-qnx* hosts (ac_sys_system=QNX); do not define
  _XOPEN_SOURCE, which on QNX hides everything outside that standard
  (declarations are gated on _QNX_SOURCE); link with $(CC), which in a cross
  build carries qcc's -V target; build a real shared libpython with
  --enable-shared (it silently came out static).
- mimalloc, pycore_time.h, faulthandler, signal, posix, select, termios: the
  QNX-specific declarations and the Linux-only interfaces QNX lacks.
configure is changed with configure.ac.

Upstream-Status: QNX-specific

--- a/configure.ac
+++ b/configure.ac
@@ -336,6 +336,9 @@
 	*-*-vxworks*)
 	    ac_sys_system=VxWorks
 	    ;;
+	*-*-qnx* | *-nto-qnx*)
+	    ac_sys_system=QNX
+	    ;;
 	*-*-emscripten)
 	    ac_sys_system=Emscripten
 	    ;;
@@ -806,6 +809,9 @@
 	*-*-vxworks*)
 		_host_ident=$host_cpu
 		;;
+	*-*-qnx* | *-nto-qnx*)
+		_host_ident=$host_cpu
+		;;
 	*-*-emscripten)
 		_host_ident=$(emcc -dumpversion | cut -f1 -d-)-$host_cpu
 		;;
@@ -863,6 +869,12 @@
   # entirely and define __EXTENSIONS__ instead.
   SunOS/*)
     define_xopen_source=no;;
+  # QNX, like Solaris, treats _XOPEN_SOURCE as a request to *disable* anything
+  # outside the named standard: its headers gate declarations on __EXT_* macros
+  # derived from _QNX_SOURCE, and defining _XOPEN_SOURCE switches those off.
+  # Leave it out and let _QNX_SOURCE (which the toolchain passes) do the work.
+  QNX/*)
+    define_xopen_source=no;;
   # On UnixWare 7, u_long is never defined with _XOPEN_SOURCE,
   # but used in /usr/include/netinet/tcp.h. Reported by Tim Rice.
   # Reconfirmed for 7.1.4 by Martin v. Loewis.
@@ -1430,9 +1442,13 @@
 	LINKCC='$(PURIFY) $(CC)'
 	case $ac_sys_system in
 	QNX*)
-	   # qcc must be used because the other compilers do not
-	   # support -N.
-	   LINKCC=qcc;;
+	   # qcc must be used because the other compilers do not support -N.
+	   # $(CC) already *is* qcc here, and in a cross build it carries the
+	   # -V<target> selector that a bare "qcc" lacks -- without it qcc drives
+	   # its default target's linker, which then rejects the objects with
+	   # "Relocations in generic ELF (EM: 183)". This case predates anyone
+	   # cross-building CPython for QNX.
+	   LINKCC='$(PURIFY) $(CC)';;
 	esac
 fi
 AC_MSG_RESULT([$LINKCC])
@@ -1569,7 +1585,11 @@
         PY3LIBRARY=libpython3.so
       fi
       ;;
-    Linux*|GNU*|NetBSD*|FreeBSD*|DragonFly*|OpenBSD*|VxWorks*)
+    # QNX is ordinary ELF with the same soname conventions as the systems
+    # beside it here. Without this entry --enable-shared is accepted and then
+    # quietly produces a static libpython, so anything embedding Python (and
+    # python3-config --libs) gets the archive instead of a shared object.
+    Linux*|GNU*|NetBSD*|FreeBSD*|DragonFly*|OpenBSD*|VxWorks*|QNX*)
       LDLIBRARY='libpython$(LDVERSION).so'
       BLDLIBRARY='-L. -lpython$(LDVERSION)'
       RUNSHARED=LD_LIBRARY_PATH=`pwd`${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
@@ -3565,6 +3585,12 @@
 		]);;
 	FreeBSD*|NetBSD*|OpenBSD*|DragonFly*) CCSHARED="-fPIC";;
 	Haiku*) CCSHARED="-fPIC";;
+	# QNX is ELF and needs position-independent code in a shared library like
+	# every other ELF platform here. Without this entry the core objects are
+	# built without -fPIC and the link fails with "relocation
+	# R_AARCH64_ADR_PREL_PG_HI21 against symbol _PyRuntime ... can not be used
+	# when making a shared object".
+	QNX*) CCSHARED="-fPIC";;
 	OpenUNIX*|UnixWare*)
 		if test "$ac_cv_gcc_compat" = "yes"
 		then CCSHARED="-fPIC"
