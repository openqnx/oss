+#ifdef Q_OS_QNX
+bool MountPoints::readMountCommand()
+{
+    // QNX 'mount' output format:
+    //   ifs on / type ifs
+    //   /dev/hd0t179 on /data type qnx6
+    //   /dev/hd0t12 on /boot type dos (fat16)
+
+    int exitCode = -1;
+    QString output = SysUtil::runCommand( "/usr/bin/mount", QStringList(), &exitCode );
+
+    if ( exitCode != 0 || output.isEmpty() )
+    {
+        logWarning() << "mount command failed or returned no output" << endl;
+        return false;
+    }
+
+    int count = 0;
+
+    foreach ( const QString & line, output.split( "\n" ) )
+    {
+        if ( line.isEmpty() )
+            continue;
+
+        // fields: device "on" path "type" fstype [options...]
+        QStringList fields = line.split( QRegularExpression( "\\s+" ), Qt::SkipEmptyParts );
+
+        if ( fields.size() < 4 )
+        {
+            logWarning() << "Skipping short mount line: " << line << endl;
+            continue;
+        }
+
+        QString device = fields[0];
+        // fields[1] == "on"
+        QString path   = fields[2];
+        // fields[3] == "type"
+        QString fsType = fields.size() >= 5 ? fields[4] : QString();
+
+        // Skip /dev/shmem and other non-real mounts
+        if ( path.startsWith( "/dev/" ) )
+            continue;
+
+        MountPoint * mountPoint = new MountPoint( device, path, fsType, QString() );
+        CHECK_NEW( mountPoint );
+
+        postProcess( mountPoint );
+        add( mountPoint );
+
+        if ( ! mountPoint->isDuplicate() )
+            ++count;
+    }
+
+    if ( count < 1 )
+    {
+        logWarning() << "No usable mount points from 'mount' command" << endl;
+        return false;
+    }
+
+    _isPopulated = true;
+    return true;
+}
+#endif
+
