Rename struct malloc_stats, which QNX's <malloc.h> declares.

QNX's <malloc.h> (reached through the system headers) declares its own
`struct malloc_stats` for mallinfo-style statistics, and server.h's struct of
the same name is then a redefinition. The struct is Redis-internal (one
member of struct redisServer), so it is renamed.

Upstream-Status: QNX-specific

--- a/src/server.h
+++ b/src/server.h
@@ -1923,7 +1923,7 @@
 
 #define RDB_SAVE_INFO_INIT {-1,0,"0000000000000000000000000000000000000000",-1}
 
-struct malloc_stats {
+struct redis_malloc_stats {
     size_t zmalloc_used;
     size_t process_rss;
     size_t allocator_allocated;
@@ -2213,7 +2213,7 @@
     long long stat_slowlog_count;          /* Total slowlog entries ever pushed */
     long long stat_slowlog_time_us_sum;    /* Sum of all slowlog entry durations (usec) */
     long long stat_slowlog_time_us_max;    /* Max slowlog entry duration (usec) */
-    struct malloc_stats cron_malloc_stats; /* sampled in serverCron(). */
+    struct redis_malloc_stats cron_malloc_stats; /* sampled in serverCron(). */
     struct defragFragCache defrag_frag_cache; /* see struct defragFragCache. */
     redisAtomic long long stat_net_input_bytes; /* Bytes read from network. */
     redisAtomic long long stat_net_output_bytes; /* Bytes written to network. */
