robot_localization: find GeographicLib without its config on QNX

GeographicLib's geographiclib-config-version.cmake, when cross-compiling,
rejects the package unless CMAKE_SYSTEM_NAME and CMAKE_SYSTEM_PROCESSOR are
the ones it was built with (QNX, aarch64). The ROS toolchain (qnx-ports')
sets CMAKE_SYSTEM_PROCESSOR to the QNX CPU directory name, aarch64le: "Could
not find a configuration file for package GeographicLib ... version: 2.7
(target = QNX-aarch64)". Find the header and library directly on QNX.

Upstream-Status: Pending
---
diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7432201..09c77df 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,7 +37,16 @@ find_package(yaml-cpp REQUIRED)
 
 # Geographiclib installs FindGeographicLib.cmake to this non-standard location
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "/usr/share/cmake/geographiclib/")
-find_package(GeographicLib REQUIRED)
+if(QNX AND CMAKE_CROSSCOMPILING)
+  # The ROS toolchain names the aarch64 processor "aarch64le"; GeographicLib's
+  # package version file, cross-compiling, accepts only the processor it was
+  # built for ("aarch64") and rejects the package. Find the library itself.
+  find_path(GeographicLib_INCLUDE_DIRS GeographicLib/Geodesic.hpp REQUIRED)
+  find_library(GeographicLib_LIBRARIES GeographicLib REQUIRED)
+  include_directories(${GeographicLib_INCLUDE_DIRS})
+else()
+  find_package(GeographicLib REQUIRED)
+endif()
 
 set(library_name rl_lib)
 
