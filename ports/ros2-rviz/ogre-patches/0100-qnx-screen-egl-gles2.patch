+
+    void QNXEGLWindow::swapBuffers()
+    {
+        if (mClosed || mIsExternalGLControl)
+            return;
+        if (eglSwapBuffers(mEglDisplay, mEglSurface) == EGL_TRUE)
+            return;
+        // The window's size can change under the surface (Qt resizes it):
+        // make the buffers and the surface again, at the new size.
+        EGLint error = eglGetError();
+        LogManager::getSingleton().logWarning("QNXEGLWindow: " + mName + ": eglSwapBuffers failed, EGL error 0x" +
+                                              StringConverter::toString(error, 0, ' ', std::ios::hex) +
+                                              "; making the surface again");
+        uint w = mWidth, h = mHeight;
+        queryWindowSize(w, h);
+        recreateSurface(w, h);
+        if (eglSwapBuffers(mEglDisplay, mEglSurface) == EGL_FALSE)
+        {
+            OGRE_EXCEPT(Exception::ERR_RENDERINGAPI_ERROR, "eglSwapBuffers failed: EGL error " +
+                        StringConverter::toString(eglGetError()), "QNXEGLWindow::swapBuffers");
+        }
+    }
+
+    void QNXEGLWindow::setHidden(bool hidden)
+    {
+        mHidden = hidden;
+        if (mOwnWindow && mWindow)
+        {
+            int visible = hidden ? 0 : 1;
+            screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_VISIBLE, &visible);
+        }
+    }
+
+    void QNXEGLWindow::create(const String& name, uint width, uint height,
+                              bool fullScreen, const NameValuePairList *miscParams)
+    {
+        mName = name;
+        mWidth = width;
+        mHeight = height;
+        mLeft = 0;
+        mTop = 0;
+        mIsFullScreen = false;
+        String title = name;
+        bool hidden = false;
+
+        if (miscParams)
+        {
+            NameValuePairList::const_iterator opt;
+            NameValuePairList::const_iterator end = miscParams->end();
+
+            if ((opt = miscParams->find("externalWindowHandle")) != end)
+                mWindow = (EGLNativeWindowType)(Ogre::StringConverter::parseSizeT(opt->second));
+            if ((opt = miscParams->find("left")) != end)
+                mLeft = StringConverter::parseInt(opt->second);
+            if ((opt = miscParams->find("top")) != end)
+                mTop = StringConverter::parseInt(opt->second);
+            if ((opt = miscParams->find("title")) != end)
+                title = opt->second;
+            if ((opt = miscParams->find("FSAA")) != end)
+                mFSAA = StringConverter::parseInt(opt->second);
+            if ((opt = miscParams->find("hidden")) != end)
+                hidden = StringConverter::parseBool(opt->second);
+            if ((opt = miscParams->find("vsync")) != end)
+                mVSync = StringConverter::parseBool(opt->second);
+            if ((opt = miscParams->find("vsyncInterval")) != end)
+                mVSyncInterval = StringConverter::parseUnsignedInt(opt->second);
+            if ((opt = miscParams->find("gamma")) != end)
+                mHwGamma = StringConverter::parseBool(opt->second);
+        }
+
+        mIsExternal = (mWindow != 0);
+        mIsTopLevel = !mIsExternal;
+        if (!mWindow)
+            createNativeWindow(mLeft, mTop, mWidth, mHeight, title);
+
+        mEglDisplay = mGLSupport->getGLDisplay();
+
+        mEglConfig = chooseConfig();
+        if (!mEglConfig)
+        {
+            OGRE_EXCEPT(Exception::ERR_RENDERINGAPI_ERROR, "No suitable EGL config", "QNXEGLWindow::create");
+        }
+
+        // The window's own size if it has one (a Qt window), else the one asked for.
+        uint w = mWidth, h = mHeight;
+        queryWindowSize(w, h);
+        createBuffers(w, h);
+
+        mHwGamma = false;
+        mEglSurface = createSurface();
+
+        mContext = createEGLContext();
+        mContext->setCurrent();
+
+        EGLint sw = mWidth, sh = mHeight;
+        eglQuerySurface(mEglDisplay, mEglSurface, EGL_WIDTH, &sw);
+        eglQuerySurface(mEglDisplay, mEglSurface, EGL_HEIGHT, &sh);
+        mWidth = sw;
+        mHeight = sh;
+
+        mActive = true;
+        mVisible = true;
+        mClosed = false;
+        setHidden(hidden);
+
+        LogManager::getSingleton().logMessage("QNXEGLWindow: " + mName + (mIsExternal ? " (external Screen window) " : " ") +
+                                              StringConverter::toString(mWidth) + "x" + StringConverter::toString(mHeight));
+    }
+
+    void QNXEGLWindow::destroy(void)
+    {
+        if (mClosed)
+            return;
+
+        if (mContext)
+        {
+            delete mContext;
+            mContext = 0;
+        }
+        if (mEglSurface)
+        {
+            eglDestroySurface(mEglDisplay, mEglSurface);
+            mEglSurface = 0;
+        }
+        if (mWindow)
+        {
+            if (mOwnWindow)
+                screen_destroy_window(mWindow);
+            else if (mOwnBuffers)
+                screen_destroy_window_buffers(mWindow);
+        }
+        mWindow = 0;
+        mOwnWindow = false;
+        mClosed = true;
+        mActive = false;
+        mVisible = false;
+    }
+}
