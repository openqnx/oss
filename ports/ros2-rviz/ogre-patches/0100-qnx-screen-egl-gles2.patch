+#ifndef __QNXEGLWindow_H__
+#define __QNXEGLWindow_H__
+
+#include "OgreEGLWindow.h"
+#include "OgreQNXEGLSupport.h"
+
+namespace Ogre {
+    /** An EGL window surface on a QNX Screen window: either one OGRE
+        creates, or one handed over as "externalWindowHandle" (the
+        screen_window_t of, say, a Qt QWindow -- QWindow::winId() on Qt's
+        qnx platform). On QNX the application creates the window's buffers
+        (screen_create_window_buffers) before eglCreateWindowSurface, in
+        the format of the config's native visual, and again whenever the
+        window's size changes. */
+    class _OgrePrivate QNXEGLWindow : public EGLWindow
+    {
+        QNXEGLSupport* mQNXSupport;
+        bool mOwnWindow;
+        bool mOwnBuffers;
+        int mFSAA;
+        void createBuffers(uint width, uint height);
+        ::EGLSurface createSurface();
+        ::EGLConfig chooseConfig();
+        void recreateSurface(uint width, uint height);
+        bool queryWindowSize(uint& width, uint& height);
+    protected:
+        virtual void getLeftAndTopFromNativeWindow(int & left, int & top, uint width, uint height);
+        virtual void initNativeCreatedWindow(const NameValuePairList *miscParams);
+        virtual void createNativeWindow(int &left, int &top, uint &width, uint &height, String &title);
+        virtual void reposition(int left, int top);
+        virtual void resize(unsigned int width, unsigned int height);
+        virtual void windowMovedOrResized();
+        virtual void switchFullScreen(bool fullscreen);
+    public:
+        QNXEGLWindow(QNXEGLSupport* glsupport);
+        virtual ~QNXEGLWindow();
+        void create(const String& name, unsigned int width, unsigned int height,
+                    bool fullScreen, const NameValuePairList *miscParams);
+        void destroy(void);
+        void swapBuffers();
+        void setHidden(bool hidden);
+        bool isVisible() const { return mVisible && !mHidden; }
+        bool isHidden() const { return mHidden; }
+    private:
+        bool mHidden;
+    };
+}
+
+#endif
