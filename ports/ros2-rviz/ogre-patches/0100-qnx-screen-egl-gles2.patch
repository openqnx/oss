+#include "OgreRoot.h"
+#include "OgreException.h"
+#include "OgreLogManager.h"
+#include "OgreStringConverter.h"
+#include "OgreViewport.h"
+
+#include "OgreGLRenderSystemCommon.h"
+
+#include "OgreQNXEGLSupport.h"
+#include "OgreQNXEGLWindow.h"
+
+#include <errno.h>
+#include <string.h>
+#include <vector>
+
+namespace Ogre {
+    QNXEGLWindow::QNXEGLWindow(QNXEGLSupport *glsupport)
+        : EGLWindow(glsupport), mQNXSupport(glsupport), mOwnWindow(false), mOwnBuffers(false), mFSAA(0), mHidden(false)
+    {
+    }
+
+    QNXEGLWindow::~QNXEGLWindow()
+    {
+        destroy();
+    }
+
+    bool QNXEGLWindow::queryWindowSize(uint& width, uint& height)
+    {
+        int size[2] = {0, 0};
+        if (!mWindow || screen_get_window_property_iv(mWindow, SCREEN_PROPERTY_SIZE, size) != 0 ||
+            size[0] <= 0 || size[1] <= 0)
+            return false;
+        width = size[0];
+        height = size[1];
+        return true;
+    }
+
+    void QNXEGLWindow::createBuffers(uint width, uint height)
+    {
+        int usage = SCREEN_USAGE_OPENGL_ES2 | SCREEN_USAGE_OPENGL_ES3;
+        if (screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_USAGE, &usage) != 0)
+        {
+            usage = SCREEN_USAGE_OPENGL_ES2;
+            screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_USAGE, &usage);
+        }
+        // The window's format must be the config's native visual.
+        EGLint format = SCREEN_FORMAT_RGBX8888;
+        eglGetConfigAttrib(mEglDisplay, mEglConfig, EGL_NATIVE_VISUAL_ID, &format);
+        screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_FORMAT, &format);
+
+        // A window handed over may come with buffers already: drop them.
+        int count = 0;
+        screen_get_window_property_iv(mWindow, SCREEN_PROPERTY_RENDER_BUFFER_COUNT, &count);
+        if (count > 0)
+            screen_destroy_window_buffers(mWindow);
+
+        int size[2] = {(int)std::max(width, 1u), (int)std::max(height, 1u)};
+        screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_BUFFER_SIZE, size);
+        mWidth = size[0];
+        mHeight = size[1];
+    }
+
+    ::EGLSurface QNXEGLWindow::createSurface()
+    {
+        // On QNX the application creates the window's buffers before
+        // eglCreateWindowSurface (as Qt's qnx platform does); should a driver
+        // want to allocate them itself, try that too.
+        ::EGLSurface surface = EGL_NO_SURFACE;
+        if (screen_create_window_buffers(mWindow, 2) == 0)
+        {
+            mOwnBuffers = true;
+            surface = eglCreateWindowSurface(mEglDisplay, mEglConfig, mWindow, NULL);
+            if (surface == EGL_NO_SURFACE)
+            {
+                screen_destroy_window_buffers(mWindow);
+                mOwnBuffers = false;
+            }
+        }
+        else
+        {
+            LogManager::getSingleton().logWarning("QNXEGLWindow: screen_create_window_buffers: " + String(strerror(errno)));
+        }
+        if (surface == EGL_NO_SURFACE)
+            surface = eglCreateWindowSurface(mEglDisplay, mEglConfig, mWindow, NULL);
+        if (surface == EGL_NO_SURFACE)
+        {
+            OGRE_EXCEPT(Exception::ERR_RENDERINGAPI_ERROR,
+                        "eglCreateWindowSurface failed: EGL error " + StringConverter::toString(eglGetError()),
+                        "QNXEGLWindow::createSurface");
+        }
+        return surface;
+    }
+
+    ::EGLConfig QNXEGLWindow::chooseConfig()
+    {
+        // Screen allocates window buffers in 8-bit RGBX/RGBA only, and
+        // Mesa lists its deepest configs (RGBX1010102) first: take all the
+        // configs and pick an 8-bit one in one of those visuals, preferring
+        // the samples asked for, then a 24-bit depth and a stencil buffer.
+        EGLint renderable = mGLSupport->getContextProfile() == GLNativeSupport::CONTEXT_ES ? EGL_OPENGL_ES2_BIT : EGL_OPENGL_BIT;
+        EGLint attribs[] = {
+            EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+            EGL_RENDERABLE_TYPE, renderable,
+            EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8,
+            EGL_DEPTH_SIZE, 16,
+            EGL_NONE
+        };
+        EGLint n = 0;
+        if (!eglChooseConfig(mEglDisplay, attribs, NULL, 0, &n) || n <= 0)
+            return 0;
+        std::vector< ::EGLConfig> configs(n);
+        eglChooseConfig(mEglDisplay, attribs, &configs[0], n, &n);
+        ::EGLConfig best = 0;
+        int bestScore = -1;
+        for (EGLint i = 0; i < n; ++i)
+        {
+            EGLint r = 0, g = 0, b = 0, depth = 0, stencil = 0, samples = 0, visual = 0;
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_RED_SIZE, &r);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_GREEN_SIZE, &g);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_BLUE_SIZE, &b);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_DEPTH_SIZE, &depth);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_STENCIL_SIZE, &stencil);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_SAMPLES, &samples);
+            eglGetConfigAttrib(mEglDisplay, configs[i], EGL_NATIVE_VISUAL_ID, &visual);
+            if (r != 8 || g != 8 || b != 8)
+                continue;
+            if (visual != SCREEN_FORMAT_RGBX8888 && visual != SCREEN_FORMAT_RGBA8888)
+                continue;
+            int score = 0;
+            if (mFSAA > 1 ? samples == mFSAA : samples == 0) score += 100;
+            else if (samples == 0) score += 50;
+            if (depth >= 24) score += 10;
+            if (stencil >= 8) score += 5;
+            if (visual == SCREEN_FORMAT_RGBX8888) score += 1;
+            if (score > bestScore)
+            {
+                bestScore = score;
+                best = configs[i];
+            }
+        }
+        if (best)
+        {
+            EGLint samples = 0, depth = 0;
+            eglGetConfigAttrib(mEglDisplay, best, EGL_SAMPLES, &samples);
+            eglGetConfigAttrib(mEglDisplay, best, EGL_DEPTH_SIZE, &depth);
+            LogManager::getSingleton().logMessage("QNXEGLWindow: EGL config with " + StringConverter::toString(depth) +
+                                                  "-bit depth, " + StringConverter::toString(samples) + " samples");
+        }
+        return best;
+    }
+
+    void QNXEGLWindow::recreateSurface(uint width, uint height)
+    {
+        // The current context and surfaces, to restore afterwards: the GL
+        // render system keeps track of which context is current.
+        ::EGLContext oldContext = eglGetCurrentContext();
+        ::EGLSurface oldDraw = eglGetCurrentSurface(EGL_DRAW);
+        ::EGLSurface oldRead = eglGetCurrentSurface(EGL_READ);
+        bool wasOurs = (oldDraw == mEglSurface);
+
+        eglMakeCurrent(mEglDisplay, (::EGLSurface)0, (::EGLSurface)0, (::EGLContext)0);
+        eglDestroySurface(mEglDisplay, mEglSurface);
+        if (mOwnBuffers)
+        {
+            screen_destroy_window_buffers(mWindow);
+            mOwnBuffers = false;
+        }
+        createBuffers(width, height);
+        mEglSurface = createSurface();
+        static_cast<EGLContext*>(mContext)->_updateInternalResources(mEglDisplay, mEglConfig, mEglSurface);
+
+        if (wasOurs)
+            eglMakeCurrent(mEglDisplay, mEglSurface, mEglSurface, oldContext);
+        else if (oldContext != (::EGLContext)0)
+            eglMakeCurrent(mEglDisplay, oldDraw, oldRead, oldContext);
+    }
+
+    void QNXEGLWindow::getLeftAndTopFromNativeWindow(int & left, int & top, uint width, uint height)
+    {
+        int pos[2] = {0, 0};
+        if (mWindow)
+            screen_get_window_property_iv(mWindow, SCREEN_PROPERTY_POSITION, pos);
+        left = pos[0];
+        top = pos[1];
+    }
+
+    void QNXEGLWindow::initNativeCreatedWindow(const NameValuePairList *miscParams)
+    {
+    }
+
+    void QNXEGLWindow::createNativeWindow(int &left, int &top, uint &width, uint &height, String &title)
+    {
+        screen_context_t ctx = mQNXSupport->getScreenContext();
+        if (!ctx || screen_create_window(&mWindow, ctx) != 0)
+        {
+            OGRE_EXCEPT(Exception::ERR_RENDERINGAPI_ERROR,
+                        "screen_create_window failed: " + String(strerror(errno)),
+                        "QNXEGLWindow::createNativeWindow");
+        }
+        mOwnWindow = true;
+        int size[2] = {(int)std::max(width, 1u), (int)std::max(height, 1u)};
+        screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_SIZE, size);
+        int pos[2] = {left, top};
+        screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_POSITION, pos);
+        if (!title.empty())
+            screen_set_window_property_cv(mWindow, SCREEN_PROPERTY_ID_STRING, (int)title.size(), title.c_str());
+    }
+
+    void QNXEGLWindow::reposition(int left, int top)
+    {
+        if (mClosed || !mOwnWindow)
+            return;
+        int pos[2] = {left, top};
+        screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_POSITION, pos);
+        mLeft = left;
+        mTop = top;
+    }
+
+    void QNXEGLWindow::resize(uint width, uint height)
+    {
+        if (mClosed)
+            return;
+        if (mOwnWindow)
+        {
+            int size[2] = {(int)std::max(width, 1u), (int)std::max(height, 1u)};
+            screen_set_window_property_iv(mWindow, SCREEN_PROPERTY_SIZE, size);
+        }
+        uint w = width, h = height;
+        queryWindowSize(w, h);
+        if (w != mWidth || h != mHeight)
+            recreateSurface(w, h);
+        for (ViewportList::iterator it = mViewportList.begin(); it != mViewportList.end(); ++it)
+            it->second->_updateDimensions();
+    }
+
+    void QNXEGLWindow::windowMovedOrResized()
+    {
+        if (mClosed || !mWindow)
+            return;
+        uint w = mWidth, h = mHeight;
+        if (queryWindowSize(w, h) && (w != mWidth || h != mHeight))
+            recreateSurface(w, h);
+        for (ViewportList::iterator it = mViewportList.begin(); it != mViewportList.end(); ++it)
+            it->second->_updateDimensions();
+    }
