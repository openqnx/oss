+#include "OgreException.h"
+#include "OgreLogManager.h"
+#include "OgreStringConverter.h"
+#include "OgreRoot.h"
+
+#include "OgreQNXEGLSupport.h"
+#include "OgreQNXEGLWindow.h"
+
+namespace Ogre {
+
+    GLNativeSupport* getGLSupport(int profile)
+    {
+        return new QNXEGLSupport(profile);
+    }
+
+    QNXEGLSupport::QNXEGLSupport(int profile) : EGLSupport(profile), mScreenContext(0)
+    {
+        mNativeDisplay = EGL_DEFAULT_DISPLAY;
+        mGLDisplay = getGLDisplay();
+
+        // The size of the first display, for the video mode list.
+        int w = 1280, h = 800;
+        screen_context_t ctx = getScreenContext();
+        int count = 0;
+        if (ctx && screen_get_context_property_iv(ctx, SCREEN_PROPERTY_DISPLAY_COUNT, &count) == 0 && count > 0)
+        {
+            screen_display_t* displays = new screen_display_t[count];
+            if (screen_get_context_property_pv(ctx, SCREEN_PROPERTY_DISPLAYS, (void**)displays) == 0)
+            {
+                int size[2] = {0, 0};
+                if (screen_get_display_property_iv(displays[0], SCREEN_PROPERTY_SIZE, size) == 0 && size[0] > 0)
+                {
+                    w = size[0];
+                    h = size[1];
+                }
+            }
+            delete[] displays;
+        }
+        mCurrentMode.width = w;
+        mCurrentMode.height = h;
+        mCurrentMode.refreshRate = 0;
+        mOriginalMode = mCurrentMode;
+        mVideoModes.push_back(mCurrentMode);
+    }
+
+    QNXEGLSupport::~QNXEGLSupport()
+    {
+        if (mScreenContext)
+            screen_destroy_context(mScreenContext);
+    }
+
+    screen_context_t QNXEGLSupport::getScreenContext()
+    {
+        if (!mScreenContext && screen_create_context(&mScreenContext, SCREEN_APPLICATION_CONTEXT) != 0)
+        {
+            mScreenContext = 0;
+            LogManager::getSingleton().logError("QNXEGLSupport: screen_create_context failed (is Screen running?)");
+        }
+        return mScreenContext;
+    }
+
+    void QNXEGLSupport::switchMode(uint& width, uint& height, short& frequency)
+    {
+        // Screen's display modes are the system's to set, not an application's.
+    }
+
+    RenderWindow* QNXEGLSupport::newWindow(const String &name, unsigned int width, unsigned int height,
+                                          bool fullScreen, const NameValuePairList *miscParams)
+    {
+        QNXEGLWindow* window = new QNXEGLWindow(this);
+        window->create(name, width, height, fullScreen, miscParams);
+        return window;
+    }
+}
