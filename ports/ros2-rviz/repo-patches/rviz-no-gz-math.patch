+namespace
+{
+// The box of uniform density with the given mass and inertia tensor: its
+// sides along the tensor's principal axes (box_rot), of lengths box_scale.
+// What gz::math::MassMatrix3d::EquivalentBox() computes; false for a mass
+// or tensor no rigid body can have (non-positive, or principal moments that
+// break the triangle inequality).
+bool equivalentInertiaBox(
+  double mass, const Eigen::Matrix3d & inertia,
+  Eigen::Vector3d & box_scale, Eigen::Quaterniond & box_rot)
+{
+  const double tolerance = 1e-6;
+  if (!(mass > 0.0)) {
+    return false;
+  }
+  Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d> solver(inertia);
+  if (solver.info() != Eigen::Success) {
+    return false;
+  }
+  const Eigen::Vector3d moments = solver.eigenvalues();
+  Eigen::Matrix3d axes = solver.eigenvectors();
+  if (axes.determinant() < 0.0) {
+    axes.col(2) = -axes.col(2);
+  }
+  const double margin = tolerance * moments.cwiseAbs().maxCoeff();
+  if (moments.minCoeff() <= 0.0 ||
+    moments[0] + moments[1] < moments[2] - margin ||
+    moments[1] + moments[2] < moments[0] - margin ||
+    moments[2] + moments[0] < moments[1] - margin)
+  {
+    return false;
+  }
+  for (int i = 0; i < 3; ++i) {
+    const double sum = moments[(i + 1) % 3] + moments[(i + 2) % 3] - moments[i];
+    box_scale[i] = std::sqrt(6.0 * std::max(sum, 0.0) / mass);
+  }
+  box_rot = Eigen::Quaterniond(axes);
+  return true;
+}
+}  // namespace
