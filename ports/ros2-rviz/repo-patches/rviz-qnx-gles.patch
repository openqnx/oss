 #include "string_helper.hpp"
 
+#ifdef __QNX__
+#include <OgreMaterialManager.h>
+#include <OgreTechnique.h>
+#include <OgreRTShaderSystem.h>
+
+namespace
+{
+// QNX has OpenGL ES only (RenderSystem_GLES2), which has no fixed-function
+// pipeline: OGRE draws every viewport in the RTShader System's scheme, and
+// this listener has the shader generator make that scheme's technique
+// (shaders included) from a material's default one when it is first used --
+// what OgreBites' SGTechniqueResolverListener does for OGRE's own samples.
+class ShaderGeneratorTechniqueResolver : public Ogre::MaterialManager::Listener
+{
+public:
+  Ogre::Technique * handleSchemeNotFound(
+    unsigned short,  // NOLINT: Ogre decides the use of unsigned short
+    const Ogre::String & scheme_name, Ogre::Material * material,
+    unsigned short,  // NOLINT: Ogre decides the use of unsigned short
+    const Ogre::Renderable *) override
+  {
+    if (scheme_name != Ogre::RTShader::ShaderGenerator::DEFAULT_SCHEME_NAME) {
+      return nullptr;
+    }
+    auto * generator = Ogre::RTShader::ShaderGenerator::getSingletonPtr();
+    if (!generator || !generator->createShaderBasedTechnique(
+        *material, Ogre::MaterialManager::DEFAULT_SCHEME_NAME, scheme_name))
+    {
+      return nullptr;
+    }
+    generator->validateMaterial(scheme_name, material->getName(), material->getGroup());
+    for (auto * technique : material->getTechniques()) {
+      if (technique->getSchemeName() == scheme_name) {
+        return technique;
+      }
+    }
+    return nullptr;
+  }
+};
+ShaderGeneratorTechniqueResolver * shader_generator_resolver = nullptr;
+}  // namespace
+#endif
+
