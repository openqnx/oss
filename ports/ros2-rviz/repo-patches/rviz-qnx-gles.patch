@@ -66,6 +66,13 @@ RenderWindow::RenderWindow(QWindow * parent)
 : QWindow(parent), impl_(new RenderWindowImpl(this)),
   on_mouse_events_callback_(nullptr), on_wheel_events_callback_(nullptr)
 {
+#ifdef __QNX__
+  // OGRE draws into this window's Screen window with EGL. Qt's qnx platform
+  // gives a raster window buffers of its own (and draws into them); an
+  // OpenGL one it leaves alone until a QOpenGLContext uses it, which never
+  // happens here.
+  setSurfaceType(QSurface::OpenGLSurface);
+#endif
