+void
+RenderSystem::prepareShaderGenerator(Ogre::SceneManager * scene_manager)
+{
+#ifdef __QNX__
+  if (auto * generator = Ogre::RTShader::ShaderGenerator::getSingletonPtr()) {
+    generator->addSceneManager(scene_manager);
+  }
+#else
+  (void)scene_manager;
+#endif
+}
