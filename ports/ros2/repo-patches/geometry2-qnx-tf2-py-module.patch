tf2_py: build the _tf2_py extension module on QNX

qnx-ports' geometry2 change replaces python3_add_library(_tf2_py) on QNX
with add_library(tf2_py): a static libtf2_py.a, installed into
site-packages/tf2_py, which Python cannot load. tf2_py/__init__.py does
"from ._tf2_py import *", so every tf2_ros buffer, listener and
broadcaster failed with "No module named 'tf2_py._tf2_py'". Build a MODULE
named _tf2_py with the target's extension suffix (PYTHON_MODULE_EXTENSION,
.cpython-314.so), linked to libpython like rclpy's module, and install it.
Also restores the non-QNX install(TARGETS _tf2_py) that change broke
("_ tf2_py").

Upstream-Status: Inappropriate [fixes a QNX-only change]
---
--- a/tf2_py/CMakeLists.txt
+++ b/tf2_py/CMakeLists.txt
@@ -48,7 +48,10 @@
 ament_python_install_package(${PROJECT_NAME})
 
 if(QNX)
-  add_library(${PROJECT_NAME} src/tf2_py.cpp)
+  # The Python extension module tf2_py/__init__.py imports (_tf2_py), as
+  # python3_add_library would make it: a MODULE named _tf2_py<ABI suffix>.
+  add_library(_tf2_py MODULE src/tf2_py.cpp)
+  set_target_properties(_tf2_py PROPERTIES PREFIX "" SUFFIX "${PYTHON_MODULE_EXTENSION}")
 else()
   python3_add_library(_tf2_py src/tf2_py.cpp)
 endif()
@@ -57,18 +60,19 @@
   # Set output directories to import module from the build directory
   # Use a no-op generator expression so multi-config generators don't append an
   # extra directory like Release/ or Debug/ and break the Python import.
-  set_target_properties(${PROJECT_NAME} PROPERTIES
+  set_target_properties(_tf2_py PROPERTIES
     LIBRARY_OUTPUT_DIRECTORY "$<1:${CMAKE_CURRENT_BINARY_DIR}/test_${PROJECT_NAME}>"
     RUNTIME_OUTPUT_DIRECTORY "$<1:${CMAKE_CURRENT_BINARY_DIR}/test_${PROJECT_NAME}>"
   )
 
-  target_link_libraries(${PROJECT_NAME} PRIVATE
+  target_link_libraries(_tf2_py PRIVATE
     ${geometry_msgs_TARGETS}
     tf2::tf2
+    ${PYTHON_LIBRARY}
   )
 
   install(TARGETS
-    ${PROJECT_NAME}
+    _tf2_py
     DESTINATION ${PYTHON_INSTALL_DIR}/${PROJECT_NAME}
   )
 
@@ -92,7 +96,7 @@
   )
 
   install(TARGETS
-  _ tf2_py
+    _tf2_py
     DESTINATION ${PYTHON_INSTALL_DIR}/${PROJECT_NAME}
   )
 endif()
