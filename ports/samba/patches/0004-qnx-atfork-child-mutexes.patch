--- a/lib/util/tfork.c
+++ b/lib/util/tfork.c
@@ -225,7 +225,13 @@
 	int ret;
 
 #ifdef HAVE_PTHREAD
+#ifdef __QNX__
+	/* the parent's prepare handler locked it; QNX's child thread is not
+	 * its owner, so unlocking fails with EPERM: start from a fresh one */
+	ret = pthread_mutex_init(&signal_state.mutex, NULL);
+#else
