+/**
+ * Resizes an OpenGL ES window: Screen cannot resize buffers in place, so the
+ * EGL surface is taken down, the buffers are reallocated at the new size, and
+ * the surface is put back (and made current again if it was).
+ */
+void glResizeWindow(window_impl_t *impl, int w, int h)
+{
+    int         size[2] = { w, h };
+    EGLContext  ctx = EGL_NO_CONTEXT;
+    int         was_current = 0;
+
+    if (impl->surface != EGL_NO_SURFACE) {
+        was_current = (eglGetCurrentSurface(EGL_DRAW) == impl->surface);
+        ctx = eglGetCurrentContext();
+        glDestroySurface(impl);
+    }
+    screen_destroy_window_buffers(impl->window);
+    screen_set_window_property_iv(impl->window, SCREEN_PROPERTY_BUFFER_SIZE, size);
+    screen_set_window_property_iv(impl->window, SCREEN_PROPERTY_SOURCE_SIZE, size);
+    screen_create_window_buffers(impl->window, 2);
+    if (was_current && egl_disp != EGL_NO_DISPLAY) {
+        EGLint surf_attr[] = { EGL_RENDER_BUFFER, EGL_BACK_BUFFER, EGL_NONE };
+        impl->surface = eglCreateWindowSurface(egl_disp, impl->conf, impl->window, surf_attr);
