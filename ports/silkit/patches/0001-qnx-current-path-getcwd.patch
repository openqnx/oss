diff --git a/SilKit/source/util/CurrentPath.hpp b/SilKit/source/util/CurrentPath.hpp
new file mode 100644
--- /dev/null
+++ b/SilKit/source/util/CurrentPath.hpp
@@ -0,0 +1,36 @@
+// SPDX-FileCopyrightText: 2026 openqnx-oss
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <filesystem>
+#include <system_error>
+
+#if defined(__QNX__)
+#include <cerrno>
+#include <climits>
+#include <unistd.h>
+#endif
+
+namespace SilKit {
+namespace Util {
+
+//! std::filesystem::current_path(), which does not throw on QNX when the
+//! working directory is "/": libc++ sizes its buffer with
+//! pathconf(".", _PC_PATH_MAX), and QNX answers EINVAL for the root of the
+//! image filesystem. getcwd() works there.
+inline auto CurrentPath() -> std::filesystem::path
+{
+#if defined(__QNX__)
+    char buffer[PATH_MAX];
+    if (::getcwd(buffer, sizeof(buffer)) == nullptr)
+    {
+        throw std::filesystem::filesystem_error("getcwd", std::error_code(errno, std::generic_category()));
+    }
+    return std::filesystem::path{buffer};
+#else
+    return std::filesystem::current_path();
+#endif
+}
+
+} // namespace Util
+} // namespace SilKit
