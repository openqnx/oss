Build the table generators for the build machine (cross compiling)

The base2/16/64/85, URL, JavaScript and ASCII lookup tables
(modp_*_data.h) are written during the build by small generator programs.
Automake built them as noinst_PROGRAMS with the target compiler, so in a
cross build for QNX the build then tried to run QNX executables on the
build machine. They are now built with CC_FOR_BUILD (the build machine's
cc when cross compiling, $CC otherwise), which configure takes as a
precious variable. The two perl rules that derive modp_b64w.c and
modp_b64r.c read modp_b64.c from the current directory, which fails in a
build directory separate from the source; they read it from $(srcdir) (and
drop perl's -i, meaningless on a pipe).

Upstream-Status: Inappropriate (upstream archived)

diff --git a/configure.ac b/configure.ac
index 24a712a..44737e5 100644
--- a/configure.ac
+++ b/configure.ac
@@ -6,6 +6,9 @@ AC_CONFIG_HEADERS(config.h)
 AC_CONFIG_MACRO_DIR([m4])
 
 AC_PROG_CC
+# Compiler for the table generators, which run during the build.
+AC_ARG_VAR([CC_FOR_BUILD], [C compiler for programs run during the build])
+AS_IF([test -z "$CC_FOR_BUILD"], [AS_IF([test "$cross_compiling" = yes], [CC_FOR_BUILD=cc], [CC_FOR_BUILD="$CC"])])
 AC_PROG_CXX
 AC_PROG_INSTALL
 
diff --git a/src/Makefile.am b/src/Makefile.am
index add0026..1006dc5 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -57,10 +57,10 @@ modp_b16.c: modp_b16.h modp_b16_data.h
 modp_b64.c: modp_b64.h modp_b64_data.h
 
 modp_b64r.c: modp_b64.c modp_b64r.h modp_b64r_data.h
-	perl -p -i -e 's/b64/b64r/g' < modp_b64.c > modp_b64r.c
+	perl -p -e 's/b64/b64r/g' < $(srcdir)/modp_b64.c > modp_b64r.c
 
 modp_b64w.c: modp_b64.c modp_b64w.h modp_b64w_data.h
-	perl -p -i -e 's/b64/b64w/g' < modp_b64.c > modp_b64w.c
+	perl -p -e 's/b64/b64w/g' < $(srcdir)/modp_b64.c > modp_b64w.c
 
 modp_b85.c: modp_b85.h modp_b85_data.h
 
@@ -112,23 +112,13 @@ modp_bjavascript_data.h: modp_bjavascript_gen
 modp_json_data.h: modp_json_gen.py
 	./modp_json_gen.py
 
-noinst_PROGRAMS = \
+# The generators write the lookup tables at build time, so they run on the
+# build machine: built with CC_FOR_BUILD, not as target programs.
+GENERATORS = \
 	modp_b2_gen modp_b16_gen modp_b64_gen modp_b85_gen \
 	modp_burl_gen modp_ascii_gen modp_bjavascript_gen
 
-modp_b2_gen_SOURCES = arraytoc.c modp_b2_gen.c
-
-modp_b16_gen_SOURCES = arraytoc.c modp_b16_gen.c
-
-modp_b64_gen_SOURCES = arraytoc.c modp_b64_gen.c
-
-modp_b85_gen_SOURCES = arraytoc.c modp_b85_gen.c
-
-modp_burl_gen_SOURCES = arraytoc.c modp_burl_gen.c
-
-modp_ascii_gen_SOURCES = arraytoc.c modp_ascii_gen.c
-
-modp_bjavascript_gen_SOURCES = arraytoc.c modp_bjavascript_gen.c
-
-
+modp_%_gen: $(srcdir)/modp_%_gen.c $(srcdir)/arraytoc.c $(srcdir)/arraytoc.h
+	$(CC_FOR_BUILD) -I$(srcdir) -o $@ $(srcdir)/arraytoc.c $(srcdir)/$@.c
 
+CLEANFILES += $(GENERATORS)
