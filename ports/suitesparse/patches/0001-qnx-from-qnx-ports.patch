From 61c287e938e84f15b891fd66875dfe8d77849ea7 Mon Sep 17 00:00:00 2001
From: felixlionardo <flionardo@blackberry.com>
Date: Wed, 18 Mar 2026 11:07:23 -0400
Subject: [PATCH 3/3] APK test fix

---
 CHOLMOD/Makefile  | 2 +-
 LAGraph/Makefile  | 2 +-
 Mongoose/Makefile | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/CHOLMOD/Makefile b/CHOLMOD/Makefile
index 9f19c28966..491003bb55 100644
--- a/CHOLMOD/Makefile
+++ b/CHOLMOD/Makefile
@@ -113,7 +113,7 @@ ilarge: library
 	./build/cholmod_si_simple < ~/nd12k.mtx > ./build/si_nd12k.out.txt
 
 test: library
-	( cd build && ctest . || ctest . --rerun-failed --output-on-failure )
+	( cd build && ctest -j1 || ctest -j1 --rerun-failed --output-on-failure )
 
 cov:
 	( cd Tcov && $(MAKE) )
diff --git a/LAGraph/Makefile b/LAGraph/Makefile
index 39304d8e0f..5a8e37f07f 100644
--- a/LAGraph/Makefile
+++ b/LAGraph/Makefile
@@ -76,7 +76,7 @@ vanilla_debug:
 all: library
 
 test: library
-	( cd build && ctest . || ctest . --rerun-failed --output-on-failure )
+	( cd build && ctest -j1 || ctest -j1 --rerun-failed --output-on-failure )
 
 verbose_test: library
 	( cd build && ctest . --verbose || ctest . --rerun-failed --output-on-failure )
diff --git a/Mongoose/Makefile b/Mongoose/Makefile
index 65060e68a5..66054b8c8f 100644
--- a/Mongoose/Makefile
+++ b/Mongoose/Makefile
@@ -68,7 +68,7 @@ uninstall:
 
 # run the extensive tests
 test:
-	( cd build && cmake $(CMAKE_OPTIONS) .. ; ctest . )
+	( cd build && cmake $(CMAKE_OPTIONS) .. ; ctest -j1 )
 
 clean: distclean
 
