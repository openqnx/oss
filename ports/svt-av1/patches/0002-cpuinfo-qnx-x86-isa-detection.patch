SVT-AV1's bundled cpuinfo: x86 ISA detection on QNX.

Use the BSD initialiser, which is pure CPUID, for QNX; otherwise src/x86/isa.c
is never compiled and libSvtAv1Enc has an unresolved cpuinfo_isa.

Upstream-Status: Pending

diff --git a/third_party/cpuinfo/CMakeLists.txt b/third_party/cpuinfo/CMakeLists.txt
index 4f32f9c..e73f659 100644
--- a/third_party/cpuinfo/CMakeLists.txt
+++ b/third_party/cpuinfo/CMakeLists.txt
@@ -72,7 +72,7 @@ IF(NOT CMAKE_SYSTEM_NAME)
       "Target operating system is not specified. "
       "cpuinfo will compile, but cpuinfo_initialize() will always fail.")
   SET(CPUINFO_SUPPORTED_PLATFORM FALSE)
-ELSEIF(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|CYGWIN|MSYS|Darwin|Linux|Android|DragonFly|FreeBSD|NetBSD|OpenBSD)$")
+ELSEIF(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|CYGWIN|MSYS|Darwin|Linux|Android|DragonFly|FreeBSD|NetBSD|OpenBSD|QNX)$")
   IF(${CMAKE_VERSION} VERSION_GREATER_EQUAL "3.14" AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
     MESSAGE(WARNING
       "Target operating system \"${CMAKE_SYSTEM_NAME}\" is not supported in cpuinfo. "
@@ -95,7 +95,10 @@ IF(CPUINFO_SUPPORTED_PLATFORM)
     IF(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "Android")
       LIST(APPEND CPUINFO_SRCS
         src/x86/linux/init.c)
-    ELSEIF(CMAKE_SYSTEM_NAME MATCHES "^(DragonFly|FreeBSD|NetBSD|OpenBSD)$")
+    ELSEIF(CMAKE_SYSTEM_NAME MATCHES "^(DragonFly|FreeBSD|NetBSD|OpenBSD|QNX)$")
+      # The BSD initialiser is pure CPUID -- no sysctl, no /proc -- so QNX
+      # can use it verbatim.  Without it src/x86/isa.c is never compiled and
+      # libSvtAv1Enc is left with an unresolved reference to cpuinfo_isa.
       LIST(APPEND CPUINFO_SRCS src/x86/bsd/init.c)
     ELSEIF(CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
       LIST(APPEND CPUINFO_SRCS src/x86/mach/x86_mach_init.c)
diff --git a/third_party/cpuinfo/src/init.c b/third_party/cpuinfo/src/init.c
index e183d2e..75565ac 100644
--- a/third_party/cpuinfo/src/init.c
+++ b/third_party/cpuinfo/src/init.c
@@ -29,7 +29,7 @@ bool CPUINFO_ABI cpuinfo_initialize(void) {
         pthread_once(&init_guard, &cpuinfo_x86_linux_init);
     #elif defined(_WIN32) || defined(__CYGWIN__)
         InitOnceExecuteOnce(&init_guard, &cpuinfo_x86_windows_init, NULL, NULL);
-    #elif defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(__bsdi__) || defined(__DragonFly__)
+    #elif defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(__bsdi__) || defined(__DragonFly__) || defined(__QNX__)
         pthread_once(&init_guard, &cpuinfo_x86_bsd_init);
     #else
         cpuinfo_log_error("operating system is not supported in cpuinfo");
