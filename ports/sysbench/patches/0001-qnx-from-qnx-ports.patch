 #if LJ_TARGET_QNX
   sa.sa_flags = 0;
 #else
   sa.sa_flags = SA_RESTART;
 #endif
+
   sa.sa_handler = profile_signal;
   sigemptyset(&sa.sa_mask);
   sigaction(SIGPROF, &sa, &ps->oldsa);

