 	!memcmp(&myaddr->s6.sin6_addr, ip6_compat_prefix,
 		sizeof ip6_compat_prefix)) {
-	bzero(&in, sizeof in);
+	memset(&in, 0, sizeof in);
 	in.sin_family = AF_INET;
 	in.sin_port = myaddr->s6.sin6_port;
 	memcpy(&in.sin_addr, (const char *)&myaddr->s6.sin6_addr +
