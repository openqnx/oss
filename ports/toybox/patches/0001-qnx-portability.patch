 #endif
 
+#ifdef __QNX__
+// QNX has no extended attributes: report them as unsupported.
+#define QNX_NOXATTR { errno = ENOTSUP; return -1; }
+static inline ssize_t xattr_get(const char *p, const char *n, void *v, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_lget(const char *p, const char *n, void *v, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_fget(int fd, const char *n, void *v, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_list(const char *p, char *l, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_llist(const char *p, char *l, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_flist(int fd, char *l, size_t s) QNX_NOXATTR
+static inline ssize_t xattr_set(const char *p, const char *n, const void *v, size_t s, int f) QNX_NOXATTR
+static inline ssize_t xattr_lset(const char *p, const char *n, const void *v, size_t s, int f) QNX_NOXATTR
+static inline ssize_t xattr_fset(int fd, const char *n, const void *v, size_t s, int f) QNX_NOXATTR
+#endif
+
