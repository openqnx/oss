--- a/lib/portability.h
+++ b/lib/portability.h
@@ -12,6 +12,29 @@
 #define __IsBSD__
 #endif
 
+#ifdef __QNX__
+// QNX has statvfs() but no statfs(): its struct statvfs carries the
+// filesystem type name (f_basetype), so use it under the statfs names.
+#include <sys/statvfs.h>
+#define statfs statvfs
+#define fstatfs fstatvfs
+// No Linux system calls: the callers only reach syscall() for a system
+// call number that does not exist here (copy_file_range: 0), so this
+// stub never runs.
+#include <errno.h>
+static inline long syscall(long n, ...) { errno = ENOSYS; return -1; }
+#include <signal.h>
+#ifndef SA_RESTART
+// QNX: "not supported yet" (commented out in <signal.h>); the handlers
+// that ask for it cope with EINTR.
+#define SA_RESTART 0
+#endif
+#include <paths.h>
+#ifndef _PATH_DEFPATH
+#define _PATH_DEFPATH "/usr/bin:/bin"
+#endif
+#endif
+
 #ifdef __APPLE__
 // macOS 10.13 doesn't have the POSIX 2008 direct access to timespec in
 // struct stat, but we can ask it to give us something equivalent...
@@ -145,6 +168,10 @@
 #define bswap_16(x) OSSwapInt16(x)
 #define bswap_32(x) OSSwapInt32(x)
 #define bswap_64(x) OSSwapInt64(x)
+#elif defined(__QNX__)
+#define bswap_16(x) __builtin_bswap16(x)
+#define bswap_32(x) __builtin_bswap32(x)
+#define bswap_64(x) __builtin_bswap64(x)
 #elif defined(__IsBSD__)
 #include <sys/endian.h>
 #define bswap_16(x) bswap16(x)
