@@ -45,31 +46,58 @@ file(GLOB_RECURSE SRC_FILES "${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp")
 
 add_library(${PROJECT_NAME} ${SRC_FILES})
 add_library(up-cpp::${PROJECT_NAME} ALIAS ${PROJECT_NAME})
+set_target_properties(${PROJECT_NAME} PROPERTIES VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
+include(GNUInstallDirs)
 
 target_include_directories(${PROJECT_NAME}
 	PUBLIC
 	$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
 	$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
-	$<BUILD_INTERFACE:${CMAKE_BINARY_DIR}>
-	${zenohcpp_INCLUDE_DIR}
-	${up-cpp_INCLUDE_DIR}
-	${up-core-api_INCLUDE_DIR}
-	${protobuf_INCLUDE_DIR}
-	${spdlog_INCLUDE_DIR})
+	$<BUILD_INTERFACE:${CMAKE_BINARY_DIR}>)
 
 set_property(TARGET ${PROJECT_NAME} PROPERTY POSITION_INDEPENDENT_CODE ON)
 
+# ZenohUTransport.h includes zenoh.hxx and up-cpp's headers: those are part
+# of the interface. zenoh-cpp on zenoh-c (zenohcxx::zenohc).
 target_link_libraries(${PROJECT_NAME}
-	PRIVATE
-	zenohcpp::lib
+	PUBLIC
+	zenohcxx::zenohc
 	up-cpp::up-cpp
 	up-core-api::up-core-api
 	protobuf::libprotobuf
+	PRIVATE
 	spdlog::spdlog
 	)
 
-enable_testing()
-add_subdirectory(test)
+include(CTest)
+if(BUILD_TESTING)
+	add_subdirectory(test)
+endif()
 
-INSTALL(TARGETS ${PROJECT_NAME})
+INSTALL(TARGETS ${PROJECT_NAME} EXPORT up-transport-zenoh-cppTargets
+	LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+	ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+	RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
 INSTALL(DIRECTORY include DESTINATION .)
+
+# The CMake package Conan's CMakeDeps generates: up-transport-zenoh-cpp::up-transport-zenoh-cpp.
+include(CMakePackageConfigHelpers)
+set(_cmakedir ${CMAKE_INSTALL_LIBDIR}/cmake/up-transport-zenoh-cpp)
+install(EXPORT up-transport-zenoh-cppTargets NAMESPACE up-transport-zenoh-cpp:: DESTINATION ${_cmakedir})
+file(WRITE ${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfig.cmake.in [=[
+@PACKAGE_INIT@
+include(CMakeFindDependencyMacro)
+find_dependency(protobuf CONFIG)
+find_dependency(up-core-api)
+find_dependency(up-cpp)
+find_dependency(zenohc)
+find_dependency(zenohcxx)
+include("${CMAKE_CURRENT_LIST_DIR}/up-transport-zenoh-cppTargets.cmake")
+set(up-transport-zenoh-cpp_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
+]=])
+configure_package_config_file(${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfig.cmake.in
+	${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfig.cmake INSTALL_DESTINATION ${_cmakedir})
+write_basic_package_version_file(${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfigVersion.cmake
+	COMPATIBILITY SameMajorVersion)
+install(FILES ${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfig.cmake
+	${CMAKE_BINARY_DIR}/up-transport-zenoh-cppConfigVersion.cmake DESTINATION ${_cmakedir})
