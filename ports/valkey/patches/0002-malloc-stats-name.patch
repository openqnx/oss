Rename struct malloc_stats, which QNX's <malloc.h> declares.

QNX's <malloc.h> (reached through the system headers) declares its own
`struct malloc_stats` for mallinfo-style statistics, and server.h's struct of
the same name is then a redefinition. The struct is internal (one member of
struct valkeyServer), so it is renamed.

Upstream-Status: QNX-specific

--- a/src/server.h
+++ b/src/server.h
@@ -1627,7 +1627,7 @@
 
 #define RDB_SAVE_INFO_INIT {-1, 0, "0000000000000000000000000000000000000000", -1}
 
-struct malloc_stats {
+struct valkey_malloc_stats {
     size_t zmalloc_used;
     size_t process_rss;
     size_t allocator_allocated;
@@ -1903,7 +1903,7 @@
     long long stat_sync_partial_ok;                /* Number of accepted PSYNC requests. */
     long long stat_sync_partial_err;               /* Number of unaccepted PSYNC requests. */
     commandlog commandlog[COMMANDLOG_TYPE_NUM];    /* Logs of commands. */
-    struct malloc_stats cron_malloc_stats;         /* sampled in serverCron(). */
+    struct valkey_malloc_stats cron_malloc_stats;        /* sampled in serverCron(). */
     long long stat_net_input_bytes;                /* Bytes read from network. */
     long long stat_net_output_bytes;               /* Bytes written to network. */
     long long stat_net_repl_input_bytes;           /* Bytes read during replication, added to stat_net_input_bytes in 'info'. */
