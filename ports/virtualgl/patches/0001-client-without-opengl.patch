+// No desktop OpenGL: there is no OpenGL drawing. The constructors throw, and
+// ClientWin falls back to X11 drawing (and disables stereo), as it does when
+// GLX fails at run time.
+#include "Error.h"
+using namespace common;
+GLFrame::GLFrame(char *dpystring, Window win_) : Frame(), dpy(NULL), win(win_), ctx(0), tjhnd(NULL), newdpy(false)
+{ (void)dpystring; throw(util::Error("GLFrame::GLFrame()", "OpenGL drawing is not available on this platform")); }
+GLFrame::GLFrame(Display *dpy_, Window win_) : Frame(), dpy(dpy_), win(win_), ctx(0), tjhnd(NULL), newdpy(false)
+{ throw(util::Error("GLFrame::GLFrame()", "OpenGL drawing is not available on this platform")); }
+GLFrame::~GLFrame(void) {}
+void GLFrame::init(rrframeheader &h, bool stereo_) { (void)h; (void)stereo_; }
+GLFrame &GLFrame::operator= (CompressedFrame &cf) { (void)cf; return *this; }
+void GLFrame::redraw(void) {}
+void GLFrame::drawTile(int x, int y, int width, int height) { (void)x; (void)y; (void)width; (void)height; }
+void GLFrame::sync(void) {}
+void GLFrame::init(void) {}
+int GLFrame::glError(void) { return 0; }
+
+#else
 #include "Error.h"
 #include "Log.h"
 #include "vglutil.h"
