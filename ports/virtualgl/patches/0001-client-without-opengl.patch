--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -326,7 +326,16 @@
 # Clarify that we need to link with the legacy OpenGL library (libGL) rather
 # than the GLVND OpenGL library.  This shuts up CMake 3.11 and later.
 set(OpenGL_GL_PREFERENCE LEGACY)
+# Without desktop OpenGL (QNX: EGL/GLES only) the client draws with X11 only:
+# GLFrame (stereo drawing) reports that OpenGL is unavailable.
+option(VGL_USEGL "Use OpenGL (GLX) in the client (stereo drawing)" TRUE)
+if(VGL_USEGL)
 include(FindOpenGL)
+else()
+add_definitions(-DVGL_NOGL)
+set(OPENGL_INCLUDE_DIR "")
+set(OPENGL_gl_LIBRARY "")
+endif()
 
 # Ensure that we build and link against the X11 version of OpenGL on OS X/macOS
 if(APPLE)
@@ -402,8 +411,11 @@
 	add_subdirectory(server)
 endif()
 add_subdirectory(client)
+# The demos (glxspheres, ...) and diagnostics are OpenGL programs.
+if(VGL_USEGL)
 add_subdirectory(demos)
 add_subdirectory(diags)
+endif()
 add_subdirectory(doc)
 
 else()
