From 20043207d529f927e8ac170e003e754f56d7515d Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 10:01:41 -0400
Subject: [PATCH 51/60] Replacement for strerror_l

Add a replacement of strerror_l for systems that don't have it.

Ignores the passed in local and just calls strerror(). A non-localized
error message is better than no error message.
---
 compat/strerror_l.c  | 16 ++++++++++++++++
 configure.ac         |  1 +
 include/vlc_fixups.h |  4 ++++
 3 files changed, 21 insertions(+)
 create mode 100644 compat/strerror_l.c

diff --git a/compat/strerror_l.c b/compat/strerror_l.c
new file mode 100644
index 00000000000..062cc080f17
--- /dev/null
+++ b/compat/strerror_l.c
@@ -0,0 +1,16 @@
+/*****************************************************************************
+ * strerror_l.c: POSIX strerror_l() replacement
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include <config.h>
+#endif
+
+#include <string.h>
+#include <stdlib.h>
+
+char *strerror_l(int errnum, locale_t locale) {
+    (void)locale;
+    return strerror(errnum);
+}
+
diff --git a/configure.ac b/configure.ac
index 47f1d8e73e1..24305b06a3b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -634,6 +634,7 @@ dnl Check for usual libc functions
 AC_CHECK_FUNCS([accept4 daemon fcntl flock fstatvfs fork getenv getmntent_r getpwuid_r isatty lstat memalign mkostemp mmap newlocale open_memstream openat pipe2 pread posix_fadvise posix_madvise posix_memalign setlocale stricmp strnicmp strptime uselocale])
 AC_REPLACE_FUNCS([aligned_alloc atof atoll dirfd fdopendir ffsll flockfile fsync getdelim getpid lfind lldiv memrchr nrand48 poll recvmsg rewind sendmsg setenv strcasecmp strcasestr strdup strlcpy strndup strnlen strnstr strsep strtof strtok_r strtoll swab tdestroy tfind timegm timespec_get strverscmp pathconf])
 AC_REPLACE_FUNCS([gettimeofday])
+AC_REPLACE_FUNCS([strerror_l])
 AC_CHECK_FUNC(fdatasync,,
   [AC_DEFINE(fdatasync, fsync, [Alias fdatasync() to fsync() if missing.])
 ])
diff --git a/include/vlc_fixups.h b/include/vlc_fixups.h
index 861cb4cc506..8c96101150b 100644
--- a/include/vlc_fixups.h
+++ b/include/vlc_fixups.h
@@ -666,6 +666,10 @@ FILE *vlc_win32_tmpfile(void);
 # define IN6_IS_ADDR_MULTICAST IN6_IS_ADDR_MULTICAST
 #endif
 
+#if !defined(HAVE_STRERROR_L)
+char *strerror_l(int errnum, locale_t locale);
+#endif
+
 #ifdef __APPLE__
 # define fdatasync fsync
 #endif

From 85ace7fe97c427b1db19e61610c9e2ddb4f60560 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 10:05:33 -0400
Subject: [PATCH 52/60] Fix assert when --enable-debug is on and newlocale
 isn't available

On systems that don't have the uselocale/newlocale/duplocale/freelocal
APIs, the fixups do nothing beyond return 0 (as appropriate).
This worked fine until --enable-debug is turned on.

There is at least one assert, in vlc_strerror_l, that will fire if
newlocale returns 0 AND errno is neither ENOENT nor EINVAL. Since the
newlocale() fixup didn't set errno whether the assert would fire or not
was somewhat random.

Rework the code a bit so that the newlocale fixup returns 0 with errno
explicitly set to ENOENT. vlc_strerror_l will then just use strerror()
instead of asserting. Any other failure will still trigger an assert.
---
 include/vlc_fixups.h | 14 +++++++++++---
 src/posix/error.c    | 26 ++++++++++++++++++--------
 2 files changed, 29 insertions(+), 11 deletions(-)

diff --git a/include/vlc_fixups.h b/include/vlc_fixups.h
index 8c96101150b..9aa50014c18 100644
--- a/include/vlc_fixups.h
+++ b/include/vlc_fixups.h
@@ -326,14 +326,21 @@ void *aligned_alloc(size_t, size_t);
 # define HAVE_USELOCALE
 #endif
 
-#if !defined(HAVE_NEWLOCALE) && defined(HAVE_CXX_LOCALE_T) && defined(__cplusplus)
-# include <locale>
-# define HAVE_NEWLOCALE
+#if defined(HAVE_CXX_LOCALE_T) && defined(__cplusplus)
+# if !defined(HAVE_NEWLOCALE)
+#  include <locale>
+#  define HAVE_NEWLOCALE
+# endif
+# if !defined(HAVE_USELOCALE)
+#  include <locale>
+#  define HAVE_USELOCALE
+# endif
 #endif
 
 /* locale.h */
 #ifndef HAVE_USELOCALE
 # ifndef HAVE_NEWLOCALE
+#  include <errno.h>
 #  define LC_ALL_MASK      0
 #  define LC_NUMERIC_MASK  0
 #  define LC_MESSAGES_MASK 0
@@ -347,6 +354,7 @@ static inline void freelocale(locale_t loc)
 static inline locale_t newlocale(int mask, const char * locale, locale_t base)
 {
     (void)mask; (void)locale; (void)base;
+    errno = ENOENT;
     return NULL;
 }
 # else
diff --git a/src/posix/error.c b/src/posix/error.c
index db510046019..b1639b6f9b1 100644
--- a/src/posix/error.c
+++ b/src/posix/error.c
@@ -31,26 +31,36 @@
 
 static const char *vlc_strerror_l(int errnum, const char *lname)
 {
+    const char *buf = NULL;
     int saved_errno = errno;
     locale_t loc = newlocale(LC_MESSAGES_MASK, lname, (locale_t)0);
 
-    if (unlikely(loc == (locale_t)0))
+    if (likely(loc != (locale_t)0))
+    {
+        buf = strerror_l(errnum, loc);
+    }
+    else
     {
         if (errno == ENOENT) /* fallback to POSIX locale */
             loc = newlocale(LC_MESSAGES_MASK, "C", (locale_t)0);
 
-        if (unlikely(loc == (locale_t)0))
+        if (likely(loc != (locale_t)0))
+        {
+            buf = strerror_l(errnum, loc);
+        }
+        else if (errno == ENOENT)
         {
-            assert(errno != EINVAL && errno != ENOENT);
-            errno = saved_errno;
-            return "Error message unavailable";
+            buf = strerror(errnum);
+        }
+        else
+        {
+            assert(errno != EINVAL);
+            buf = "Error message unavailable";
         }
-        errno = saved_errno;
     }
 
-    const char *buf = strerror_l(errnum, loc);
-
     freelocale(loc);
+    errno = saved_errno;
     return buf;
 }
 

From 41f6b7f83c637ae553f937f37ec92e3cb2f1e88a Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 10:17:11 -0400
Subject: [PATCH 53/60] Fix build when hand-written assembler doesn't use GOT

Several of the contrib libraries (eg: libavcodec) have hand written
assembler in them. While the c/c++ code is compiled with -fPIC, the hand
written assembly generally isn't and doesn't bother trying to access
symbols it wants via the GOT.

This causes a problem when creating the final shared objects as the
(non-GOT) relocation is not supported.

Using SYMBOLIC_LDFLAGS adds -Bsymbolic to the link command line which
in turn makes the linker treat global symbols that it finds as local
and hence don't need the GOT.

This does mean they can't be overriden by the dynamic linker but I
believe that is ok in this instance.
---
 modules/codec/Makefile.am        | 2 +-
 modules/demux/Makefile.am        | 2 +-
 modules/packetizer/Makefile.am   | 1 +
 modules/stream_out/Makefile.am   | 2 +-
 modules/video_chroma/Makefile.am | 2 +-
 5 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/modules/codec/Makefile.am b/modules/codec/Makefile.am
index 25f343124b6..c72f2291ae3 100644
--- a/modules/codec/Makefile.am
+++ b/modules/codec/Makefile.am
@@ -522,7 +522,7 @@ endif
 libx265_plugin_la_SOURCES = codec/x265.c
 libx265_plugin_la_CPPFLAGS = $(CODEC_CPPFLAGS)
 libx265_plugin_la_CFLAGS = $(AM_CFLAGS) $(CFLAGS_x265)
-libx265_plugin_la_LDFLAGS = $(AM_LDFLAGS) $(LDFLAGS_x265) -rpath '$(codecdir)'
+libx265_plugin_la_LDFLAGS = $(AM_LDFLAGS) $(LDFLAGS_x265) -rpath '$(codecdir)' $(SYMBOLIC_LDFLAGS)
 libx265_plugin_la_LIBADD = $(LIBS_x265)
 EXTRA_LTLIBRARIES += libx265_plugin.la
 codec_LTLIBRARIES += $(LTLIBx265)
diff --git a/modules/demux/Makefile.am b/modules/demux/Makefile.am
index 947d9dc22a1..cb507cc2616 100644
--- a/modules/demux/Makefile.am
+++ b/modules/demux/Makefile.am
@@ -86,7 +86,7 @@ libnsc_plugin_la_SOURCES = demux/nsc.c
 demux_LTLIBRARIES += libnsc_plugin.la
 
 libmpc_plugin_la_SOURCES = demux/mpc.c
-libmpc_plugin_la_LDFLAGS = $(AM_LDFLAGS) -rpath '$(demuxdir)'
+libmpc_plugin_la_LDFLAGS = $(AM_LDFLAGS) -rpath '$(demuxdir)' $(SYMBOLIC_LDFLAGS)
 libmpc_plugin_la_LIBADD = $(LIBS_mpc) $(LIBM)
 EXTRA_LTLIBRARIES += libmpc_plugin.la
 demux_LTLIBRARIES += $(LTLIBmpc)
diff --git a/modules/packetizer/Makefile.am b/modules/packetizer/Makefile.am
index 588a3293bd5..4b54bc7f165 100644
--- a/modules/packetizer/Makefile.am
+++ b/modules/packetizer/Makefile.am
@@ -35,6 +35,7 @@ libpacketizer_avparser_plugin_la_SOURCES = packetizer/avparser.c \
 	codec/avcodec/avcodec.h
 libpacketizer_avparser_plugin_la_CFLAGS = $(AVCODEC_CFLAGS) $(AVUTIL_CFLAGS) $(AM_CFLAGS)
 libpacketizer_avparser_plugin_la_LIBADD = $(AVCODEC_LIBS) $(AVUTIL_LIBS) $(LIBM) libavcodec_common.la
+libpacketizer_avparser_plugin_la_LDFLAGS = $(AM_LDFLAGS) $(SYMBOLIC_LDFLAGS)
 
 noinst_HEADERS += packetizer/packetizer_helper.h packetizer/startcode_helper.h
 
diff --git a/modules/stream_out/Makefile.am b/modules/stream_out/Makefile.am
index 8a1b42d34d8..0706aadcf8d 100644
--- a/modules/stream_out/Makefile.am
+++ b/modules/stream_out/Makefile.am
@@ -63,7 +63,7 @@ endif
 libstream_out_chromaprint_plugin_la_SOURCES = stream_out/chromaprint.c stream_out/chromaprint_data.h dummy.cpp
 libstream_out_chromaprint_plugin_la_CPPFLAGS = $(AM_CPPFLAGS) $(CHROMAPRINT_CFLAGS)
 libstream_out_chromaprint_plugin_la_LDFLAGS = $(AM_LDFLAGS) -rpath '$(soutdir)'
-libstream_out_chromaprint_plugin_la_LIBADD = $(CHROMAPRINT_LIBS)
+libstream_out_chromaprint_plugin_la_LIBADD = $(CHROMAPRINT_LIBS) $(SYMBOLIC_LDFLAGS)
 EXTRA_LTLIBRARIES += libstream_out_chromaprint_plugin.la
 sout_LTLIBRARIES += $(LTLIBstream_out_chromaprint)
 
diff --git a/modules/video_chroma/Makefile.am b/modules/video_chroma/Makefile.am
index b86bdc362ba..c6586c6e138 100644
--- a/modules/video_chroma/Makefile.am
+++ b/modules/video_chroma/Makefile.am
@@ -13,7 +13,7 @@ libchroma_omx_plugin_la_LIBADD = $(OMXIP_LIBS)
 libswscale_plugin_la_SOURCES = video_chroma/swscale.c codec/avcodec/chroma.c
 libswscale_plugin_la_CFLAGS = $(AM_CFLAGS) $(SWSCALE_CFLAGS)
