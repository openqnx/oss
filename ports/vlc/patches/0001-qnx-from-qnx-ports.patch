From 06265db76f789ceaffec994a2c315d7d67181d60 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:37:03 -0400
Subject: [PATCH 40/60] Get contrib/srt working on QNX8

Add a QNX target type that can be switched on. It is generally treated
the same as the POSIX type but changes a few places where different
header files need to be included.

In addition, make sure that when static libraries are built, they can be
built with -fpic so that VLC can turn them into shared libraries later.
---
 contrib/src/srt/0001-qnx-support.patch    | 64 +++++++++++++++++++++++
 contrib/src/srt/0002-qnx-static-pic.patch | 29 ++++++++++
 contrib/src/srt/rules.mak                 | 11 +++-
 3 files changed, 103 insertions(+), 1 deletion(-)
 create mode 100644 contrib/src/srt/0001-qnx-support.patch
 create mode 100644 contrib/src/srt/0002-qnx-static-pic.patch

diff --git a/contrib/src/srt/0001-qnx-support.patch b/contrib/src/srt/0001-qnx-support.patch
new file mode 100644
index 00000000000..d9d3e6cdb68
--- /dev/null
+++ b/contrib/src/srt/0001-qnx-support.patch
@@ -0,0 +1,64 @@
+--- a/CMakeLists.txt	2025-02-10 10:13:28.101387719 -0500
++++ b/CMakeLists.txt	2025-02-10 10:15:33.226686262 -0500
+@@ -41,8 +41,9 @@
+ set_if(GNU         ${CMAKE_SYSTEM_NAME} MATCHES "GNU")
+ set_if(ANDROID     ${SYSNAME_LC} MATCHES "android")
+ set_if(SUNOS       "${SYSNAME_LC}" MATCHES "sunos")
+-set_if(POSIX       LINUX OR DARWIN OR BSD OR SUNOS OR ANDROID OR (CYGWIN AND CYGWIN_USE_POSIX))
+-set_if(SYMLINKABLE LINUX OR DARWIN OR BSD OR SUNOS OR CYGWIN OR GNU)
++set_if(QNX         ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
++set_if(POSIX       LINUX OR DARWIN OR BSD OR SUNOS OR ANDROID OR (CYGWIN AND CYGWIN_USE_POSIX) OR QNX)
++set_if(SYMLINKABLE LINUX OR DARWIN OR BSD OR SUNOS OR CYGWIN OR GNU OR QNX)
+ 
+ # Not sure what to do in case of compiling by MSVC.
+ # This will make installdir in C:\Program Files\SRT then
+@@ -622,6 +623,9 @@
+ elseif(SUNOS)
+ 	add_definitions(-DSUNOS=1)
+ 	message(STATUS "DETECTED SYSTEM: SunOS|Solaris;  SUNOS=1" )
++elseif(QNX)
++	add_definitions(-DQNX=1)
++	message(STATUS "DETECTED SYSTEM: QNX;  QNX=1" )
+ else()
+ 	message(FATAL_ERROR "Unsupported system: ${CMAKE_SYSTEM_NAME}")
+ endif()
+--- a/srtcore/platform_sys.h	2025-02-10 10:17:27.531545951 -0500
++++ b/srtcore/platform_sys.h	2025-02-10 10:18:39.266617633 -0500
+@@ -99,6 +99,14 @@
+ 
+ #endif
+ 
++#ifdef QNX
++
++#ifdef SRT_IMPORT_EVENT
++   #include <unistd.h>
++#endif
++
++#endif
++
+ #include <sys/types.h>
+ #include <sys/socket.h>
+ #include <sys/ioctl.h>
+--- a/srtcore/utilities.h	2025-02-10 10:27:56.531347072 -0500
++++ b/srtcore/utilities.h	2025-02-10 10:39:41.877009482 -0500
+@@ -230,6 +230,9 @@
+ #	define __LITTLE_ENDIAN LITTLE_ENDIAN
+ #	define __PDP_ENDIAN    PDP_ENDIAN
+ 
++#elif defined(__QNXNTO__)
++#	include <gulliver.h>
++
+ #else
+ 
+ #	error Endian: platform not supported
+--- a/srtcore/srt_compat.c	2025-03-07 11:27:47.323237582 -0500
++++ b/srtcore/srt_compat.c	2025-03-07 11:28:03.911424096 -0500
+@@ -23,7 +23,7 @@
+ #include <string.h>
+ #include <stdio.h>
+ #include <errno.h>
+-#if defined(__unix__) && !defined(BSD) && !defined(SUNOS)
++#if defined(__unix__) && !defined(BSD) && !defined(SUNOS) && !defined(QNX)
+ #include <features.h>
+ #endif
+ 
diff --git a/contrib/src/srt/0002-qnx-static-pic.patch b/contrib/src/srt/0002-qnx-static-pic.patch
new file mode 100644
index 00000000000..ed18e0b7a1b
--- /dev/null
+++ b/contrib/src/srt/0002-qnx-static-pic.patch
@@ -0,0 +1,29 @@
+--- a/CMakeLists.txt	2025-03-03 13:39:06.942234074 -0500
++++ b/CMakeLists.txt	2025-03-03 13:47:07.191036279 -0500
+@@ -134,6 +134,7 @@
+ option(ENABLE_HAICRYPT_LOGGING "Should logging in haicrypt be enabled" 0)
+ option(ENABLE_SHARED "Should libsrt be built as a shared library" ON)
+ option(ENABLE_STATIC "Should libsrt be built as a static library" ON)
++option(ENABLE_STATIC_PIC "Build static library as Position-Independent-Code" OFF)
+ option(ENABLE_RELATIVE_LIBPATH "Should application contain relative library paths, like ../lib" OFF)
+ option(ENABLE_GETNAMEINFO "In-logs sockaddr-to-string should do rev-dns" OFF)
+ option(ENABLE_UNITTESTS "Enable unit tests" OFF)
+@@ -854,7 +855,7 @@
+ 
+ add_library(srt_virtual OBJECT ${SOURCES_srt} ${SOURCES_srt_extra} ${HEADERS_srt} ${SOURCES_haicrypt} ${SOURCES_common})
+ 
+-if (ENABLE_SHARED)
++if (ENABLE_SHARED OR ENABLE_STATIC_PIC)
+ 	# Set this to sources as well, as it won't be automatically handled
+ 	set_target_properties(srt_virtual PROPERTIES POSITION_INDEPENDENT_CODE 1)
+ endif()
+@@ -908,6 +909,9 @@
+ 
+ if (srt_libspec_static)
+ 	add_library(${TARGET_srt}_static STATIC ${OBJECT_LIB_SUPPORT} ${VIRTUAL_srt})
++        if (ENABLE_STATIC_PIC)
++                set (CMAKE_POSITION_INDEPENDENT_CODE ON)
++        endif()
+ 
+ 	# For Windows, leave the name to be "srt_static.lib".
+ 	# Windows generates two different library files:
diff --git a/contrib/src/srt/rules.mak b/contrib/src/srt/rules.mak
index 53bd9252566..b8e690847cb 100644
--- a/contrib/src/srt/rules.mak
+++ b/contrib/src/srt/rules.mak
@@ -24,11 +24,20 @@ $(TARBALLS)/srt-$(SRT_VERSION).tar.gz:
 srt: srt-$(SRT_VERSION).tar.gz .sum-srt
 	$(UNPACK)
 	$(APPLY) $(SRC)/srt/0001-core-ifdef-MSG_TRUNC-nixes-fix.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/srt/0001-qnx-support.patch
+	$(APPLY) $(SRC)/srt/0002-qnx-static-pic.patch
+endif
 	$(call pkg_static,"scripts/srt.pc.in")
 	mv srt-$(SRT_VERSION) $@ && touch $@
 
+ifdef HAVE_QNX
+CMAKE_EXTRA_ARGS += "-DENABLE_STATIC_PIC=ON"
+endif
+
 .srt: srt toolchain.cmake
 	cd $< && $(HOSTVARS_PIC) $(CMAKE) \
-		-DENABLE_SHARED=OFF -DUSE_GNUTLS=ON -DENABLE_CXX11=OFF -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_BINDIR=bin -DCMAKE_INSTALL_INCLUDEDIR=include
+		-DENABLE_SHARED=OFF -DUSE_GNUTLS=ON -DENABLE_CXX11=OFF -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_INSTALL_BINDIR=bin -DCMAKE_INSTALL_INCLUDEDIR=include \
+		$(CMAKE_EXTRA_ARGS)
 	cd $< && $(CMAKEBUILD) . --target install
 	touch $@

From 8690b6a90c90039512b3cc6d50c1652a184de2d7 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:45:13 -0400
Subject: [PATCH 41/60] Get contrib/taglib working on QNX8

Two changes.
1. Update C++ standard from c++98 to C++11 in order to make it
   compatible with QNX's libc++ implementation that requires C++11

2. Build static libraries with -fpic so that VLC can turn them into
   shared objects later.
---
 contrib/src/taglib/0001-use-c++11.patch    | 11 +++++++++++
 contrib/src/taglib/0002-qnx-use-fpic.patch | 11 +++++++++++
 contrib/src/taglib/rules.mak               |  4 ++++
 3 files changed, 26 insertions(+)
 create mode 100644 contrib/src/taglib/0001-use-c++11.patch
 create mode 100644 contrib/src/taglib/0002-qnx-use-fpic.patch

diff --git a/contrib/src/taglib/0001-use-c++11.patch b/contrib/src/taglib/0001-use-c++11.patch
new file mode 100644
index 00000000000..d9e551db259
--- /dev/null
+++ b/contrib/src/taglib/0001-use-c++11.patch
@@ -0,0 +1,11 @@
+--- a/taglib/CMakeLists.txt	2025-02-06 14:30:13.557230071 -0500
++++ b/taglib/CMakeLists.txt	2025-02-06 14:30:35.170428488 -0500
+@@ -335,7 +335,7 @@
+ )
+ 
+ add_library(tag ${tag_LIB_SRCS} ${tag_HDRS})
+-set_property(TARGET tag PROPERTY CXX_STANDARD 98)
++set_property(TARGET tag PROPERTY CXX_STANDARD 11)
+ 
+ if(HAVE_ZLIB AND NOT HAVE_ZLIB_SOURCE)
+   target_link_libraries(tag ${ZLIB_LIBRARIES})
diff --git a/contrib/src/taglib/0002-qnx-use-fpic.patch b/contrib/src/taglib/0002-qnx-use-fpic.patch
new file mode 100644
index 00000000000..be0abef0a43
--- /dev/null
+++ b/contrib/src/taglib/0002-qnx-use-fpic.patch
@@ -0,0 +1,11 @@
+--- a/CMakeLists.txt	2025-02-07 20:32:12.557678118 -0500
++++ b/CMakeLists.txt	2025-02-07 20:34:14.588502112 -0500
+@@ -98,6 +98,8 @@
+ math(EXPR TAGLIB_SOVERSION_MINOR "${TAGLIB_SOVERSION_AGE}")
+ math(EXPR TAGLIB_SOVERSION_PATCH "${TAGLIB_SOVERSION_REVISION}")
+ 
++set(CMAKE_POSITION_INDEPENDENT_CODE ON)
++
+ include(ConfigureChecks.cmake)
+ 
+ if(${ZLIB_FOUND})
diff --git a/contrib/src/taglib/rules.mak b/contrib/src/taglib/rules.mak
index a5872c1a197..96c451c2e69 100644
--- a/contrib/src/taglib/rules.mak
+++ b/contrib/src/taglib/rules.mak
@@ -15,6 +15,10 @@ $(TARBALLS)/taglib-$(TAGLIB_VERSION).tar.gz:
 
 taglib: taglib-$(TAGLIB_VERSION).tar.gz .sum-taglib
 	$(UNPACK)
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/taglib/0001-use-c++11.patch
+	$(APPLY) $(SRC)/taglib/0002-qnx-use-fpic.patch
