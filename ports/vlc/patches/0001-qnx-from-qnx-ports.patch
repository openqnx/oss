From ef3229bfcd425768de2517c7175c563203558fdc Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:23:14 -0400
Subject: [PATCH 37/60] Get contrib/mpcdec building on QNX

qcc/q++ does not support the '-pipe' argument. Don't use it when
building using these tools.

For what it is worth, qcc/q++ by default has the behaviour that -pipe
enables in gcc/g++ so even if it was supported, it wouldn't change
anything.
---
 contrib/src/samplerate/rules.mak | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/contrib/src/samplerate/rules.mak b/contrib/src/samplerate/rules.mak
index 5714f9cd39c..5e29828ce0b 100644
--- a/contrib/src/samplerate/rules.mak
+++ b/contrib/src/samplerate/rules.mak
@@ -9,6 +9,11 @@ ifeq ($(call need_pkg,"samplerate"),)
 PKGS_FOUND += samplerate
 endif
 
+ifdef HAVE_QNX
+# qcc enables -pipe by default and doesn't actually understand the '-pipe' option
+SAMPLERATE_CONF := --disable-gcc-pipe
+endif
+
 $(TARBALLS)/libsamplerate-$(SAMPLERATE_VERSION).tar.gz:
 	$(call download_pkg,$(SAMPLERATE_URL),samplerate)
 
@@ -21,6 +26,6 @@ samplerate: libsamplerate-$(SAMPLERATE_VERSION).tar.gz .sum-samplerate
 
 .samplerate: samplerate
 	$(REQUIRE_GPL)
-	cd $< && $(HOSTVARS) ./configure $(HOSTCONF)
+	cd $< && $(HOSTVARS) ./configure $(HOSTCONF) $(SAMPLERATE_CONF)
 	cd $< && $(MAKE) -C src install && $(MAKE) install-data
 	touch $@

From 77eb24a75fee4f017dbc7ca2e5869154a9c29b8a Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:25:11 -0400
Subject: [PATCH 38/60] Get contrib/sidplay2 building on QNX

QNX8's compiler generates a narrowing warning when converting an 8bit
hexadecimal value (eg: '\x81') to an int8_t. This breaks the build.

The warning can be ignored as the bits in the int8_t are set correctly.
---
 .../sidplay2/0001-no-narrowing-warning.patch    | 17 +++++++++++++++++
 contrib/src/sidplay2/rules.mak                  |  3 +++
 2 files changed, 20 insertions(+)
 create mode 100644 contrib/src/sidplay2/0001-no-narrowing-warning.patch

diff --git a/contrib/src/sidplay2/0001-no-narrowing-warning.patch b/contrib/src/sidplay2/0001-no-narrowing-warning.patch
new file mode 100644
index 00000000000..ea74ece4edb
--- /dev/null
+++ b/contrib/src/sidplay2/0001-no-narrowing-warning.patch
@@ -0,0 +1,17 @@
+--- a/libsidplay/src/xsid/xsid.cpp	2025-02-06 14:02:35.324404477 -0500
++++ b/libsidplay/src/xsid/xsid.cpp	2025-02-06 14:07:57.784833961 -0500
+@@ -94,11 +94,14 @@
+     '\x08', '\x19', '\x2a', '\x3b', '\x4c', '\x5d', '\x6e', '\x7f'
+ };
+ */
++#pragma GCC diagnostic push
++#pragma GCC diagnostic ignored "-Wnarrowing"
+ const int8_t XSID::sampleConvertTable[16] =
+ {
+     '\x80', '\x94', '\xa9', '\xbc', '\xce', '\xe1', '\xf2', '\x03',
+     '\x1b', '\x2a', '\x3b', '\x49', '\x58', '\x66', '\x73', '\x7f'
+ };
++#pragma GCC diagnostic pop
+ 
+ const char *XSID::credit =
+ {
diff --git a/contrib/src/sidplay2/rules.mak b/contrib/src/sidplay2/rules.mak
index 2f8504dcf6c..e05a8760adb 100644
--- a/contrib/src/sidplay2/rules.mak
+++ b/contrib/src/sidplay2/rules.mak
@@ -25,6 +25,9 @@ sidplay-libs: sidplay-libs-$(SID_VERSION).tar.gz .sum-sidplay2
 	$(APPLY) $(SRC)/sidplay2/sidplay2-string.patch
 	$(APPLY) $(SRC)/sidplay2/sidplay2-fix-overflow.patch
 	$(APPLY) $(SRC)/sidplay2/sidplay2-cxxtest.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/sidplay2/0001-no-narrowing-warning.patch
+endif
 	$(MOVE)
 
 .sidplay2: sidplay-libs

From 084c8dd34fb2389f8d75e9c59149562382658ef6 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:26:49 -0400
Subject: [PATCH 39/60] Get contrib/shout building on QNX

shout has a bunch of helper functions named like _blah_*(). This
clashes with some internal names from QNX's headers. For example,
_mutex_lock().

Rename all the clashing usages in shout from _blah_*() to
shout_blah_*().
---
 .../shout/0001-qnx-fix-namespace-clash.patch  | 319 ++++++++++++++++++
 contrib/src/shout/rules.mak                   |   3 +
