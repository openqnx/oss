From 1ab8c9e7d7b5912dbcd2483d942d9f2556834eb9 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 14:45:41 -0400
Subject: [PATCH 30/60] Get contrib/modplug building against qnx

q++, by default, builds against libc++. However that requires at
least c++11 (unless one uses clang apparently). modplug deliberately
sets the standard to gnu++98.

Update the standard used to c++11 so I can link against libc++ instead
of libstdc++. I did it this way instead of just using libstdc++ because
I didn't want to mix usage of libc++ and libstdc++ in the same
application.

This also required a change to the .pc file to specify libc++ instead of
libstdc++.
---
 contrib/src/modplug/qnx-use-libc++.patch |  9 +++++++++
 contrib/src/modplug/rules.mak            | 12 +++++++++++-
 2 files changed, 20 insertions(+), 1 deletion(-)
 create mode 100644 contrib/src/modplug/qnx-use-libc++.patch

diff --git a/contrib/src/modplug/qnx-use-libc++.patch b/contrib/src/modplug/qnx-use-libc++.patch
new file mode 100644
index 00000000000..c6a283a287d
--- /dev/null
+++ b/contrib/src/modplug/qnx-use-libc++.patch
@@ -0,0 +1,9 @@
+--- libmodplug-0.8.9.0/libmodplug.pc.in.old	2020-04-29 21:39:14.000000000 +0200
++++ libmodplug-0.8.9.0/libmodplug.pc.in	2020-04-29 21:40:06.000000000 +0200
+@@ -8,5 +8,5 @@
+ Version: @VERSION@
+ Requires: 
+ Libs: -L${libdir} -lmodplug 
+-Libs.private: -lstdc++ -lm
++Libs.private: -lc++ -lm
+ Cflags: -I${includedir} -DMODPLUG_STATIC
diff --git a/contrib/src/modplug/rules.mak b/contrib/src/modplug/rules.mak
index c8371c9270b..cc9131c82a2 100644
--- a/contrib/src/modplug/rules.mak
+++ b/contrib/src/modplug/rules.mak
@@ -8,7 +8,14 @@ ifeq ($(call need_pkg,"libmodplug >= 0.8.9.0"),)
 PKGS_FOUND += modplug
 endif
 
-MODPLUG_CXXFLAGS := $(CXXFLAGS) -std=gnu++98
+MODPLUG_CXXFLAGS := $(CXXFLAGS)
+ifdef HAVE_QNX
+# QNX uses GCC and libc++, and libc++ only supports C++03 (and earlier)
+# when compiled with clang. Work around this by bumping the C++ version.
+MODPLUG_CXXFLAGS += -std=gnu++11
+else
+MODPLUG_CXXFLAGS += -std=gnu++98
+endif
 
 $(TARBALLS)/libmodplug-$(MODPLUG_VERSION).tar.gz:
 	$(call download_pkg,$(MODPLUG_URL),modplug)
@@ -22,6 +29,9 @@ libmodplug: libmodplug-$(MODPLUG_VERSION).tar.gz .sum-modplug
 	$(APPLY) $(SRC)/modplug/fix-endianness-check.diff
 ifdef HAVE_MACOSX
 	$(APPLY) $(SRC)/modplug/mac-use-c-stdlib.patch
+endif
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/modplug/qnx-use-libc++.patch
 endif
 	$(call pkg_static,"libmodplug.pc.in")
 	$(MOVE)

