From c689fe025e6dbd3c6660b3f177a9e303fa2bc426 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:09:49 -0400
Subject: [PATCH 35/60] Get contrib/qt working on QNX8

A bunch of changes to get the contrib version of qt compiling and
working on QNX8. Only minimal testing was done so improvements are
likely possible.

Changes are:
1. Different location of slog2.h header.
2. Make sure the top level window is a 'root' window. Otherwise any
   dialog that pops up ends up being a detached floating window that
   appears to be a separate application.
3. When a new native (screen) buffer is created, make sure screen's
   blit'ter is done clearing it before QT tries to start rendering into
   it.
4. Changes to how contrib drives qt's build so that the QNX specific
   bits get exposed in a way that VLC can use them.
5. Correctly specify the QT target type based on the target type that
   QT is cross compiling for.
6. Don't build the QT tools using the cross-compiler. They need to be
   run on the development host, not the target.
---
 .../src/qt/0001-qnx-fix-slog2-support.patch   | 23 +++++++++++++++
 .../src/qt/0002-qnx-enable-root-window.patch  | 19 ++++++++++++
 contrib/src/qt/0003-qnx-flush-clear.patch     | 11 +++++++
 contrib/src/qt/rules.mak                      | 29 +++++++++++++++++++
 4 files changed, 82 insertions(+)
 create mode 100644 contrib/src/qt/0001-qnx-fix-slog2-support.patch
 create mode 100644 contrib/src/qt/0002-qnx-enable-root-window.patch
 create mode 100644 contrib/src/qt/0003-qnx-flush-clear.patch

diff --git a/contrib/src/qt/0001-qnx-fix-slog2-support.patch b/contrib/src/qt/0001-qnx-fix-slog2-support.patch
new file mode 100644
index 00000000000..dda92e83014
--- /dev/null
+++ b/contrib/src/qt/0001-qnx-fix-slog2-support.patch
@@ -0,0 +1,23 @@
+--- a/config.tests/unix/slog2/slog2.cpp	2025-02-06 11:57:20.115176350 -0500
++++ b/config.tests/unix/slog2/slog2.cpp	2025-02-06 11:57:27.416255443 -0500
+@@ -31,7 +31,7 @@
+ **
+ ****************************************************************************/
+ 
+-#include <slog2.h>
++#include <sys/slog2.h>
+ 
+ int main(int, char **)
+ {
+
+--- a/src/corelib/global/qlogging.cpp	2025-02-06 16:13:51.586158185 -0500
++++ b/src/corelib/global/qlogging.cpp	2025-02-06 16:13:57.391217093 -0500
+@@ -53,7 +53,7 @@
+ #include <qt_windows.h>
+ #endif
+ #ifdef QT_USE_SLOG2
+-#include <slog2.h>
++#include <sys/slog2.h>
+ #endif
+ 
+ #ifdef Q_OS_ANDROID
diff --git a/contrib/src/qt/0002-qnx-enable-root-window.patch b/contrib/src/qt/0002-qnx-enable-root-window.patch
new file mode 100644
index 00000000000..d85cc65020e
--- /dev/null
+++ b/contrib/src/qt/0002-qnx-enable-root-window.patch
@@ -0,0 +1,19 @@
+--- a/src/plugins/platforms/qnx/qqnxintegration.cpp	2025-02-24 11:57:27.119921001 -0500
++++ b/src/plugins/platforms/qnx/qqnxintegration.cpp	2025-02-24 11:58:08.188371171 -0500
+@@ -120,16 +120,9 @@
+         options |= QQnxIntegration::AlwaysFlushScreenContext;
+     }
+ 
+-// On Blackberry the first window is treated as a root window
+-#ifdef Q_OS_BLACKBERRY
+     if (!paramList.contains(QLatin1String("no-rootwindow"))) {
+-        options |= QQnxIntegration::RootWindow;
+-    }
+-#else
+-    if (paramList.contains(QLatin1String("rootwindow"))) {
+         options |= QQnxIntegration::RootWindow;
+     }
+-#endif
+     return options;
+ }
+ 
diff --git a/contrib/src/qt/0003-qnx-flush-clear.patch b/contrib/src/qt/0003-qnx-flush-clear.patch
new file mode 100644
index 00000000000..32670a06d6b
--- /dev/null
+++ b/contrib/src/qt/0003-qnx-flush-clear.patch
@@ -0,0 +1,11 @@
+--- a/src/plugins/platforms/qnx/qqnxrasterwindow.cpp	2025-02-28 11:01:33.260154435 -0500
++++ b/src/plugins/platforms/qnx/qqnxrasterwindow.cpp	2025-02-28 11:01:44.840231667 -0500
+@@ -151,7 +151,7 @@
+                                 "Failed to clear window buffer");
+         }
+ 
+-        Q_SCREEN_CHECKERROR(screen_flush_blits(screen()->nativeContext(), 0),
++        Q_SCREEN_CHECKERROR(screen_flush_blits(screen()->nativeContext(), SCREEN_WAIT_IDLE),
+                             "Failed to flush blits");
+ 
+         // Use the first available render buffer
diff --git a/contrib/src/qt/rules.mak b/contrib/src/qt/rules.mak
index a4b214b4c50..06d7cbda2b5 100644
--- a/contrib/src/qt/rules.mak
+++ b/contrib/src/qt/rules.mak
@@ -42,6 +42,11 @@ qt: qt-$(QT_VERSION).tar.xz .sum-qt
 	$(APPLY) $(SRC)/qt/0018-Remove-qtypetraits.h-s-contents-altogether.patch
 	$(APPLY) $(SRC)/qt/0019-QFileSystemEngine-only-define-FILE_ID_INFO-for-build.patch
 	$(APPLY) $(SRC)/qt/systray-no-sound.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/qt/0001-qnx-fix-slog2-support.patch
+	$(APPLY) $(SRC)/qt/0002-qnx-enable-root-window.patch
+	$(APPLY) $(SRC)/qt/0003-qnx-flush-clear.patch
+endif
 	$(MOVE)
 
 ifdef HAVE_MACOSX
@@ -58,6 +63,12 @@ QT_SPEC := win32-g++
 endif
 QT_PLATFORM := -xplatform $(QT_SPEC) -device-option CROSS_COMPILE=$(HOST)-
 endif
+ifdef HAVE_QNX
+QT_SPEC := qnx-$(subst gcc_nto,,$(QNX_ARCH))-qcc
+# QNX uses x86_64 but QT_SPEC/QT_PLATFORM wants x86-64
+QT_SPEC := $(subst x86_64,x86-64,$(QT_SPEC))
+QT_PLATFORM := -xplatform $(QT_SPEC)
+endif
 
 QT_CONFIG := -static -opensource -confirm-license -no-pkg-config \
 	-no-sql-sqlite -no-gif -qt-libjpeg -no-openssl -no-opengl -no-dbus \
@@ -65,6 +76,11 @@ QT_CONFIG := -static -opensource -confirm-license -no-pkg-config \
 	-no-compile-examples -nomake examples
 
 QT_CONFIG += -release
+ifdef HAVE_QNX
+# Make sure that the system zlib isn't used as QT seems to assume that it is
+# using its built-in copy of zlib
+QT_CONFIG += -qt-zlib
+endif
 
 .qt: qt
 	cd $< && $(QT_VARS) ./configure $(QT_PLATFORM) $(QT_CONFIG) -prefix $(PREFIX)
@@ -75,7 +91,11 @@ QT_CONFIG += -release
 	cd $< && $(MAKE) -C src sub-moc-install_subtargets sub-rcc-install_subtargets sub-uic-install_subtargets
 	# Install plugins
 	cd $< && $(MAKE) -C src/plugins sub-platforms-install_subtargets
+ifdef HAVE_QNX
+	mv $(PREFIX)/plugins/platforms/libqqnx.a $(PREFIX)/lib/ && rm -rf $(PREFIX)/plugins
+else
 	mv $(PREFIX)/plugins/platforms/libqwindows.a $(PREFIX)/lib/ && rm -rf $(PREFIX)/plugins
+endif
 	# Move includes to match what VLC expects
 	mkdir -p $(PREFIX)/include/QtGui/qpa
 	cp $(PREFIX)/include/QtGui/$(QT_VERSION)/QtGui/qpa/qplatformnativeinterface.h $(PREFIX)/include/QtGui/qpa
@@ -83,16 +103,25 @@ QT_CONFIG += -release
 	rm -rf $(PREFIX)/lib/libQt5Bootstrap* $</lib/libQt5Bootstrap*
 	# Fix .pc files to remove debug version (d)
 	cd $(PREFIX)/lib/pkgconfig; for i in Qt5Core.pc Qt5Gui.pc Qt5Widgets.pc; do sed -i -e 's/d\.a/.a/g' -e 's/d $$/ /' $$i; done
+ifdef HAVE_QNX
+	# Fix Qt5Gui.pc file to include qqnx (QQnxIntegrationPlugin), all the things libqqnx needs, and Qt5Platform Support
+	cd $(PREFIX)/lib/pkgconfig; sed -i -e 's/ -lQt5Gui/ -lqqnx -lfreetype -lfontconfig -lz -lscreen -lQt5PlatformSupport -lQt5Gui/g' Qt5Gui.pc
+	# Update all the pkg-config files to use static linking
+	for i in ${PREFIX}/lib/pkgconfig/Qt5*.pc; do $(SRC)/pkg-static.sh $$i; done
+else
 	# Fix Qt5Gui.pc file to include qwindows (QWindowsIntegrationPlugin) and Qt5Platform Support
 	cd $(PREFIX)/lib/pkgconfig; sed -i -e 's/ -lQt5Gui/ -lqwindows -lQt5PlatformSupport -lQt5Gui/g' Qt5Gui.pc
+endif
 ifdef HAVE_CROSS_COMPILE
 	# Building Qt build tools for Xcompilation
 	cd $</include/QtCore; $(LN_S)f $(QT_VERSION)/QtCore/private private
 	cd $<; $(MAKE) -C qmake
 	cd $<; $(MAKE) install_qmake install_mkspecs
+ifndef HAVE_QNX
 	cd $</src/tools; \
 	for i in bootstrap uic rcc moc; \
 		do (cd $$i; echo $$i && ../../../bin/qmake -spec $(QT_SPEC) && $(MAKE) clean && $(MAKE) CC=$(HOST)-gcc CXX=$(HOST)-g++ LINKER=$(HOST)-g++ LIB="$(HOST)-ar -rc" && $(MAKE) install); \
 	done
+endif
 endif
 	touch $@

From a31311babcfa26e4fc429aaa26545ba3435cf93c Mon Sep 17 00:00:00 2001
