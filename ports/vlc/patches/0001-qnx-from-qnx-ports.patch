From cb63e6325fe08dbcb938cbc86bb3051812987e78 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 08:51:45 -0400
Subject: [PATCH 45/60] Get contrib/x265 working on QNX

1. Update C++ standard from c++98 to C++11 in order to make it
   compatible with QNX's libc++ implementation that requires C++11

2. Build static libraries with -fpic so that VLC can turn them into
   shared objects later.

3. QNX does not need `-lpthread` to be explicitly added to link in
   pthread support. It breaks if you do so as there is no libpthread
   available.

4. CMake will try to figure out what libraries are implicitly linked
   when creating an executable/shared-object. The x265 CMakeLists will
   then explicitly add these libraries to the .pc dependency lists. This
   causes them to be explicitly linked later on when VLC creates the
   final shared object.

   One of this implicit libraries is the static version of libc (libcS)
   and explicitly linking that in causes problems with malloc and
   friends when a shared object is unloaded.

   I'm not sure why x265 whats to explicitly link these in, it should
   happen automatically. Perhaps it is trying to protect against a
   different toolchain consuming what the x265 build produces? In any
   case, there is only one toolchain on QNX so don't link in libcS to
   avoid the malloc issue.

5. Update x265's build process so that it can properly pull the gcc
   version from qcc/q++.
---
 contrib/src/x265/0001-qnx-use-gnu++11.patch   | 11 ++++++++++
 .../src/x265/0002-qnx-dont-link-libcS.patch   | 10 +++++++++
 .../x265/0003-qnx-get-compiler-version.patch  | 22 +++++++++++++++++++
 contrib/src/x265/rules.mak                    | 13 ++++++++++-
 4 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 contrib/src/x265/0001-qnx-use-gnu++11.patch
 create mode 100644 contrib/src/x265/0002-qnx-dont-link-libcS.patch
 create mode 100644 contrib/src/x265/0003-qnx-get-compiler-version.patch

diff --git a/contrib/src/x265/0001-qnx-use-gnu++11.patch b/contrib/src/x265/0001-qnx-use-gnu++11.patch
new file mode 100644
index 00000000000..92bb358ce4c
--- /dev/null
+++ b/contrib/src/x265/0001-qnx-use-gnu++11.patch
@@ -0,0 +1,11 @@
+--- a/source/CMakeLists.txt	2025-02-07 14:02:19.027990139 -0500
++++ b/source/CMakeLists.txt	2025-02-07 14:02:32.375095280 -0500
+@@ -206,7 +206,7 @@
+         endif()
+         add_definitions(-std=gnu++11)
+     else()
+-        add_definitions(-std=gnu++98)
++        add_definitions(-std=gnu++11)
+     endif()
+     if(ENABLE_PIC)
+          add_definitions(-fPIC)
diff --git a/contrib/src/x265/0002-qnx-dont-link-libcS.patch b/contrib/src/x265/0002-qnx-dont-link-libcS.patch
new file mode 100644
index 00000000000..51031ed8b9a
--- /dev/null
+++ b/contrib/src/x265/0002-qnx-dont-link-libcS.patch
@@ -0,0 +1,10 @@
+--- a/source/CMakeLists.txt	2025-02-13 16:56:11.394500065 -0500
++++ b/source/CMakeLists.txt	2025-02-13 16:56:56.735985017 -0500
+@@ -658,6 +658,7 @@
+         list(REMOVE_ITEM PLIBLIST "-lc" "-lpthread" "-lmingwex" "-lmingwthrd"
+             "-lmingw32" "-lmoldname" "-lmsvcrt" "-ladvapi32" "-lshell32"
+             "-luser32" "-lkernel32")
++        list(REMOVE_ITEM PLIBLIST "-lcS")
+         string(REPLACE ";" " " PRIVATE_LIBS "${PLIBLIST}")
+     else()
+         set(PRIVATE_LIBS "")
diff --git a/contrib/src/x265/0003-qnx-get-compiler-version.patch b/contrib/src/x265/0003-qnx-get-compiler-version.patch
new file mode 100644
index 00000000000..d73491b677d
--- /dev/null
+++ b/contrib/src/x265/0003-qnx-get-compiler-version.patch
@@ -0,0 +1,22 @@
+--- a/source/CMakeLists.txt	2025-03-13 13:25:30.041561751 -0400
++++ b/source/CMakeLists.txt	2025-03-13 13:58:41.424514646 -0400
+@@ -325,7 +325,18 @@
+             endif()
+         endif()
+     endif(ENABLE_AGGRESSIVE_CHECKS)
+-    execute_process(COMMAND ${CMAKE_CXX_COMPILER} -dumpversion OUTPUT_VARIABLE CC_VERSION)
++    if (CMAKE_SYSTEM_NAME STREQUAL QNX)
++        execute_process(COMMAND ${CMAKE_CXX_COMPILER} -V OUTPUT_VARIABLE CC_VERSION ERROR_VARIABLE CC_VERSION)
++        # Output will be a bit of preamble on the 1st line, the subsequent lines
++        # each giving a target and version. Assume that the version is the same
++        # for each target.
++        string(REPLACE "\n" ";" CC_VERSION "${CC_VERSION}")
++        list(GET CC_VERSION 1 CC_VERSION)
++        string(STRIP "${CC_VERSION}" CC_VERSION)
++        string(REGEX MATCH "^[0-9.]*" CC_VERSION "${CC_VERSION}")
++    else()
++        execute_process(COMMAND ${CMAKE_CXX_COMPILER} -dumpversion OUTPUT_VARIABLE CC_VERSION)
++    endif()
+ endif(GCC)
+ 
+ find_package(Nasm)
