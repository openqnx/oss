Date: Tue, 11 Mar 2025 14:50:13 -0400
Subject: [PATCH 32/60] Get contrib/nfs building on QNX

A handful of small changes to get the code compiling on QNX. Mostly
dealing with what API to use

1. QNX's makedev takes three arguments, not two.
2. getsockname is available, so use it.
3. System level time APIs come from sys/time.h, not time.h
---
 contrib/src/nfs/qnx_three_arg_makedev.patch | 14 ++++++++++++++
 contrib/src/nfs/qnx_use_getsockname.patch   | 12 ++++++++++++
 contrib/src/nfs/qnx_use_sys_time.patch      | 12 ++++++++++++
 contrib/src/nfs/rules.mak                   |  3 +++
 4 files changed, 41 insertions(+)
 create mode 100644 contrib/src/nfs/qnx_three_arg_makedev.patch
 create mode 100644 contrib/src/nfs/qnx_use_getsockname.patch
 create mode 100644 contrib/src/nfs/qnx_use_sys_time.patch

diff --git a/contrib/src/nfs/qnx_three_arg_makedev.patch b/contrib/src/nfs/qnx_three_arg_makedev.patch
new file mode 100644
index 00000000000..727758ea26c
--- /dev/null
+++ b/contrib/src/nfs/qnx_three_arg_makedev.patch
@@ -0,0 +1,14 @@
+--- a/lib/nfs_v3.c	2025-02-06 09:37:45.709788455 -0500
++++ b/lib/nfs_v3.c	2025-02-06 09:39:27.114138535 -0500
+@@ -105,7 +105,11 @@
+ specdata3_to_rdev(struct specdata3 *rdev)
+ {
+ #ifdef makedev
++#if defined(__QNXNTO__)
++	return makedev(0, rdev->specdata1, rdev->specdata2);
++#else
+ 	return makedev(rdev->specdata1, rdev->specdata2);
++#endif
+ #else
+ 	return 0;
+ #endif
diff --git a/contrib/src/nfs/qnx_use_getsockname.patch b/contrib/src/nfs/qnx_use_getsockname.patch
new file mode 100644
index 00000000000..ea0506eeb9a
--- /dev/null
+++ b/contrib/src/nfs/qnx_use_getsockname.patch
@@ -0,0 +1,12 @@
+--- a/lib/socket.c	2025-02-06 09:47:04.580367850 -0500
++++ b/lib/socket.c	2025-02-06 09:51:36.025120762 -0500
+@@ -166,7 +166,8 @@
+ {
+ 	int level;
+ 
+-	#if defined(__FreeBSD__) || defined(__sun) || (defined(__APPLE__) && defined(__MACH__))
++	#if defined(__FreeBSD__) || defined(__sun) || defined(__QNXNTO__) \
++            || (defined(__APPLE__) && defined(__MACH__))
+ 	struct protoent *buf;
+ 
+ 	if ((buf = getprotobyname("tcp")) != NULL)
diff --git a/contrib/src/nfs/qnx_use_sys_time.patch b/contrib/src/nfs/qnx_use_sys_time.patch
new file mode 100644
index 00000000000..6aaa3fe7f9f
--- /dev/null
+++ b/contrib/src/nfs/qnx_use_sys_time.patch
@@ -0,0 +1,12 @@
+--- a/include/nfsc/libnfs.h	2025-02-06 09:26:27.918079126 -0500
++++ b/include/nfsc/libnfs.h	2025-02-06 09:27:04.420551487 -0500
+@@ -29,7 +29,8 @@
+ 
+ #include <stdint.h>
+ #if defined(__ANDROID__) || defined(AROS) || defined(__PPU__) \
+- || ( defined(__APPLE__) && defined(__MACH__) )
++ || ( defined(__APPLE__) && defined(__MACH__) ) \
++ || defined(__QNXNTO__)
+ #include <sys/time.h>
+ #else
+ #include <time.h>
diff --git a/contrib/src/nfs/rules.mak b/contrib/src/nfs/rules.mak
index de7f253788e..9b42f7538e7 100644
--- a/contrib/src/nfs/rules.mak
+++ b/contrib/src/nfs/rules.mak
@@ -16,6 +16,9 @@ nfs: libnfs-$(NFS_VERSION).tar.gz .sum-nfs
 	$(UNPACK)
 	mv libnfs-libnfs-$(NFS_VERSION) libnfs-$(NFS_VERSION)
 	$(UPDATE_AUTOCONFIG)
+	$(APPLY) $(SRC)/nfs/qnx_use_sys_time.patch
+	$(APPLY) $(SRC)/nfs/qnx_three_arg_makedev.patch
+	$(APPLY) $(SRC)/nfs/qnx_use_getsockname.patch
 	$(MOVE)
 
 .nfs: nfs

From 07aed31495befeedb6b9d46c8040aadf9147dfb6 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 14:54:36 -0400
Subject: [PATCH 33/60] Get contrib/orc building on QNX

QNX, like Android, doesn't require explicitly compiler/linker arguments
to enable pthread support.
---
 contrib/src/orc/0001-qnx-no-libpthread.patch | 11 +++++++++++
 contrib/src/orc/rules.mak                    |  4 ++++
 2 files changed, 15 insertions(+)
 create mode 100644 contrib/src/orc/0001-qnx-no-libpthread.patch

diff --git a/contrib/src/orc/0001-qnx-no-libpthread.patch b/contrib/src/orc/0001-qnx-no-libpthread.patch
new file mode 100644
index 00000000000..a8c1c403ccd
--- /dev/null
+++ b/contrib/src/orc/0001-qnx-no-libpthread.patch
@@ -0,0 +1,11 @@
+--- orc/configure.ac	2025-02-06 10:20:08.163319978 -0500
++++ orc/configure.ac	2025-02-06 10:20:37.036791228 -0500
+@@ -96,7 +96,7 @@
+   mingw*|pw32*|cygwin*)
+     AC_DEFINE(HAVE_THREAD_WIN32, 1, [Use Windows thread code])
+     ;;
+-  *android*)
++  *android*|*nto*)
+     AC_DEFINE(HAVE_THREAD_PTHREAD, 1, [Use pthread thread code])
+     PTHREAD_CFLAGS=
+     PTHREAD_LIBS=
diff --git a/contrib/src/orc/rules.mak b/contrib/src/orc/rules.mak
index 5ac4bde97e0..93acfa2e529 100644
--- a/contrib/src/orc/rules.mak
+++ b/contrib/src/orc/rules.mak
@@ -15,10 +15,14 @@ $(TARBALLS)/orc-$(ORC_VERSION).tar.gz:
 orc: orc-$(ORC_VERSION).tar.gz .sum-orc
 	$(UNPACK)
 	$(APPLY) $(SRC)/orc/use-proper-func-detection.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/orc/0001-qnx-no-libpthread.patch
+endif
 	$(UPDATE_AUTOCONFIG)
 	$(MOVE)
 
 .orc: orc
+	$(RECONF)
 	cd $< && $(HOSTVARS) ./configure $(HOSTCONF)
 	cd $< && $(MAKE) install
 	touch $@

From be0aecfa8b9707edfde0400d2eed9c19a2c27b94 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 14:56:21 -0400
Subject: [PATCH 34/60] Get contrib/protobuf building on 64bit QNX targets

The version of protobuf in contrib didn't support a 64bit target on QNX.
Add in the missing configuration for the required support.
---
 .../0001-add-support-for-64-bit-QNX-builds.patch | 16 ++++++++++++++++
 contrib/src/protobuf/rules.mak                   |  3 +++
