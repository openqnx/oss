From cba52f4422667734572be0a6170a555212d35bd4 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 13:55:35 -0400
Subject: [PATCH 25/60] Get contrib/chromaprint working for QNX

Chromaprint, by default, only enables -fpic when it is building the
shared library variant of itself. VLC's contrib builds static libraries
that are then used to build shared libraries. So -fpic isn't used even
though it needs to be.

Add a CMake option to force -fpic to be used. This switch is enabled for
QNX.
---
 .../src/chromaprint/0001-qnx-enable-PIC.patch | 21 +++++++++++++++++++
 contrib/src/chromaprint/rules.mak             |  9 +++++++-
 2 files changed, 29 insertions(+), 1 deletion(-)
 create mode 100644 contrib/src/chromaprint/0001-qnx-enable-PIC.patch

diff --git a/contrib/src/chromaprint/0001-qnx-enable-PIC.patch b/contrib/src/chromaprint/0001-qnx-enable-PIC.patch
new file mode 100644
index 00000000000..348d6b0b13c
--- /dev/null
+++ b/contrib/src/chromaprint/0001-qnx-enable-PIC.patch
@@ -0,0 +1,21 @@
+--- a/CMakeLists.txt	2025-03-11 13:44:55.790484651 -0400
++++ b/CMakeLists.txt	2025-03-11 13:46:44.948833078 -0400
+@@ -71,6 +71,7 @@
+ endif()
+ 
+ option(BUILD_SHARED_LIBS "Build shared libraries" ON)
++option(BUILD_ENABLE_PIC "Explicitly enable PIC. Useful when BUILD_SHARED_LIBS is disabled" OFF)
+ option(BUILD_TOOLS "Build command line tools" OFF)
+ option(BUILD_TESTS "Build test suite" OFF)
+ 
+--- a/src/CMakeLists.txt	2025-03-11 13:47:42.284541342 -0400
++++ b/src/CMakeLists.txt	2025-03-11 13:47:59.845758278 -0400
+@@ -66,7 +66,7 @@
+ endif()
+ 
+ add_library(chromaprint_objs OBJECT ${chromaprint_SOURCES})
+-if(BUILD_SHARED_LIBS)
++if(BUILD_SHARED_LIBS OR BUILD_ENABLE_PIC)
+ 	set_target_properties(chromaprint_objs PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
+ endif()
+ 
diff --git a/contrib/src/chromaprint/rules.mak b/contrib/src/chromaprint/rules.mak
index 5ceab7292a9..65a3ef11ab4 100644
--- a/contrib/src/chromaprint/rules.mak
+++ b/contrib/src/chromaprint/rules.mak
@@ -16,11 +16,18 @@ $(TARBALLS)/chromaprint-$(CHROMAPRINT_VERSION).tar.gz:
 chromaprint: chromaprint-$(CHROMAPRINT_VERSION).tar.gz .sum-chromaprint
 	$(UNPACK)
 	$(APPLY) $(SRC)/chromaprint/linklibs.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/chromaprint/0001-qnx-enable-PIC.patch
+endif
 	$(MOVE)
 
 DEPS_chromaprint = ffmpeg $(DEPS_ffmpeg)
 
+ifdef HAVE_QNX
+CHROMAPRINT_CMAKEARGS := -DBUILD_ENABLE_PIC=ON
+endif
+
 .chromaprint: chromaprint .ffmpeg toolchain.cmake
-	cd $< && $(HOSTVARS_PIC) $(CMAKE)
+	cd $< && $(HOSTVARS_PIC) $(CMAKE) $(CHROMAPRINT_CMAKEARGS)
 	cd $< && $(CMAKEBUILD) . --target install
 	touch $@

