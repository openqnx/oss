From 9d95068aab37b39db84e2c3f5da30aa8a9b6552b Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 08:55:41 -0400
Subject: [PATCH 10/60] Update contrib's bootstrap and build process to support
 QNX.

This mostly involved recognizing a host triplet with 'nto' in it
and then ensuring that an SDP has been sourced into the environment.

Once this is verified, both the HAVE_QNX and HAVE_LINUX flags are set.
QNX and Linux are often close enough that what works on Linux works on
QNX. So to keep from having to touch everything HAVE_LINUX is set. In
cases where something needs to handle different behaviour between Linux
and QNX, it can switch on the HAVE_QNX flag.

Finally QNX's cross compilers (qcc/q++) are set up with the required
environment variables so that they know what target they are compiling
for.

Unfortunately, meson doesn't play nice with the QNX cross compilers. It
doesn't know how to identify them so refuses to build anything. For
meson, call the underlying toolchain directly instead of going through
the qcc/q++ frontends.

This commit does NOT actually make any updates to the individual contrib
libraries. That will be happening in the following commits.
---
 contrib/bootstrap                  | 11 ++++++++++
 contrib/src/gen-meson-crossfile.py |  7 ++++++
 contrib/src/get-arch.sh            |  3 +++
 contrib/src/main.mak               | 35 +++++++++++++++++++++++++++---
 4 files changed, 53 insertions(+), 3 deletions(-)

diff --git a/contrib/bootstrap b/contrib/bootstrap
index 4e0fd82a88f..d698287e636 100755
--- a/contrib/bootstrap
+++ b/contrib/bootstrap
@@ -256,6 +256,14 @@ check_tizen_sdk()
 	[ ${TIZEN_ABI} = "armv7l" ] && add_make_enabled "HAVE_ARMV7A"
 }
 
+check_qnx_sdp()
+{
+    [ -z "${QNX_TARGET}" ] && echo "You must source a QNX SDP" && exit 1
+    [ -z "${QNX_HOST}" ] && echo "You must source a QNX SDP" && exit 1
+
+    add_make_enabled "HAVE_LINUX" "HAVE_QNX"
+}
+
 test -z "$PREFIX" || add_make "PREFIX := $PREFIX"
 test -z "$BUILD_DISCS" || add_make_enabled "BUILD_DISCS"
 test -z "$BUILD_ENCODERS" || add_make_enabled "BUILD_ENCODERS"
@@ -382,6 +390,9 @@ case "${OS}" in
 	*solaris*)
 		add_make_enabled "HAVE_SOLARIS"
 		;;
+	*nto*)
+                check_qnx_sdp
+		;;
 esac
 
 #
diff --git a/contrib/src/gen-meson-crossfile.py b/contrib/src/gen-meson-crossfile.py
index 26e0faafb68..2a6dda0ed7c 100755
--- a/contrib/src/gen-meson-crossfile.py
+++ b/contrib/src/gen-meson-crossfile.py
@@ -21,6 +21,13 @@ def _add_environ_arr(meson_key, env_key):
     arr_string = (', '.join("'" + item + "'" for item in env_values))
     args.file.write("{} = [{}]\n".format(meson_key, arr_string))
 
+# Meson does not support QNX's compilers (qcc/q++) so if I'm
+# targetting QNX, replace them with the underlying gcc compiler.
+if '-nto-qnx' in os.environ.get('HOST'):
+    os.environ['CC'] = f"nto{os.environ.get('HOST_ARCH')}-gcc"
+    os.environ['CXX'] = f"nto{os.environ.get('HOST_ARCH')}-g++"
+    os.environ['LD'] = f"nto{os.environ.get('HOST_ARCH')}-ld"
+
 # Generate meson crossfile
 args.file.write("# Automatically generated by contrib makefile\n")
 
diff --git a/contrib/src/get-arch.sh b/contrib/src/get-arch.sh
index 3431779811f..8f18aca7ebb 100755
--- a/contrib/src/get-arch.sh
+++ b/contrib/src/get-arch.sh
@@ -22,6 +22,9 @@ case "$HOST" in
 	powerpc64-*|ppc64-*)
 		ARCH="ppc64"
 		;;
+	nto*)
+		ARCH="${HOST#nto}"
+		;;
 	*-*)
 		ARCH="${HOST%%-*}"
 		;;
diff --git a/contrib/src/main.mak b/contrib/src/main.mak
index 2a7776caa1b..2941b136217 100644
--- a/contrib/src/main.mak
+++ b/contrib/src/main.mak
@@ -1,4 +1,3 @@
-# Main makefile for VLC 3rd party libraries ("contrib")
 # Copyright (C) 2003-2011 the VideoLAN team
 #
 # This file is under the same license as the vlc package.
@@ -54,6 +53,19 @@ endif
 #
 # Default values for tools
 #
+ifdef HAVE_QNX
+QNX_ARCH=gcc_nto$(ARCH)$(if $(findstring aarch64,$(ARCH)),le)
+ifneq ($(findstring $(origin CC),undefined default),)
+CC := qcc -V$(QNX_ARCH)
