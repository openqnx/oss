From 27bd3b441502369e4e4240ab0abdc1e882311872 Mon Sep 17 00:00:00 2001
From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 12:14:31 -0400
Subject: [PATCH 21/60] Get contrib/gettext building for QNX

gettext wants to make use of openmp. Normally that is enabled via the
-fopenmp command line option to gcc but that isn't working with qcc/q++.

Instead it needs to be passed through qcc/q++ to the compiler stage via
-Wc,-fopenmp. In addition, since I'm bypassing the front end the link
stage also needs to be told to link against libgomp via -Wl,-lgomp.
---
 contrib/src/gettext/0001-qnx-support.patch | 11 +++++++++++
 contrib/src/gettext/rules.mak              |  3 +++
 2 files changed, 14 insertions(+)
 create mode 100644 contrib/src/gettext/0001-qnx-support.patch

diff --git a/contrib/src/gettext/0001-qnx-support.patch b/contrib/src/gettext/0001-qnx-support.patch
new file mode 100644
index 00000000000..2cc83fccf74
--- /dev/null
+++ b/contrib/src/gettext/0001-qnx-support.patch
@@ -0,0 +1,11 @@
+--- a/gettext-tools/configure	2025-03-06 17:30:45.118301868 -0500
++++ b/gettext-tools/configure	2025-03-06 17:32:33.788384354 -0500
+@@ -47818,7 +47818,7 @@
+   ac_cv_prog_c_openmp='none needed'
+ else
+   ac_cv_prog_c_openmp='unsupported'
+-	  	  	  	  	  	  	                                	  	  	  	  	  	  for ac_option in -fopenmp -xopenmp -openmp -mp -omp -qsmp=omp -homp \
++	  	  	  	  	  	  	                                	  	  	  	  	  	  for ac_option in -fopenmp "-Wc,-fopenmp -Wl,-lgomp" -xopenmp -openmp -mp -omp -qsmp=omp -homp \
+                            -Popenmp --openmp; do
+ 	    ac_save_CFLAGS=$CFLAGS
+ 	    CFLAGS="$CFLAGS $ac_option"
diff --git a/contrib/src/gettext/rules.mak b/contrib/src/gettext/rules.mak
index 151da2bcb06..a916d7029ff 100644
--- a/contrib/src/gettext/rules.mak
+++ b/contrib/src/gettext/rules.mak
@@ -17,6 +17,9 @@ gettext: gettext-$(GETTEXT_VERSION).tar.gz .sum-gettext
 	$(UNPACK)
 	$(APPLY) $(SRC)/gettext/0001-libasprintf-On-mingw-really-use-our-vasprintf-functi.patch
 	$(APPLY) $(SRC)/gettext/0002-libasprintf-Avoid-compilation-error-on-mingw-with-D_.patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/gettext/0001-qnx-support.patch
+endif
 	$(MOVE)
 
 DEPS_gettext = iconv $(DEPS_iconv) libxml2 $(DEPS_libxml2)

