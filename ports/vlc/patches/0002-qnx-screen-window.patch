--- a/modules/video_output/opengl/egl.c
+++ b/modules/video_output/opengl/egl.c
@@ -461,17 +461,69 @@
         EGL_RENDERABLE_TYPE, api->render_bit,
         EGL_NONE
     };
+#if defined (USE_PLATFORM_QNX)
+    /* all of them: Mesa lists well over a hundred, the 8-bit ones last */
+    EGLConfig cfgv[1024];
+#else
     EGLConfig cfgv[1];
+#endif
     EGLint cfgc;
 
-    if (eglChooseConfig(sys->display, conf_attr, cfgv, 1, &cfgc) != EGL_TRUE
+    if (eglChooseConfig(sys->display, conf_attr, cfgv, (EGLint)(sizeof (cfgv) / sizeof (cfgv[0])), &cfgc) != EGL_TRUE
      || cfgc == 0)
     {
         msg_Err (obj, "cannot choose EGL configuration");
         goto error;
     }
 #if defined (USE_PLATFORM_QNX)
+    /* eglChooseConfig() lists the deepest configs first (RGBX1010102 on
+     * virtio-gpu, which Screen cannot make window buffers of), and the
+     * SDP 8 EGL takes a window only in its config's native visual
+     * (EGL_BAD_NATIVE_WINDOW, "can't create window buffers", otherwise):
+     * take an 8-bit config with an RGBX/RGBA8888 visual and give the window
+     * that format. */
+    EGLint visual = 0, chosen = 0;
+    for (EGLint i = 0; i < cfgc; i++)
+    {
+        EGLint r = 0, g = 0, b = 0, a = 0, v = 0;
+        eglGetConfigAttrib(sys->display, cfgv[i], EGL_RED_SIZE, &r);
+        eglGetConfigAttrib(sys->display, cfgv[i], EGL_GREEN_SIZE, &g);
+        eglGetConfigAttrib(sys->display, cfgv[i], EGL_BLUE_SIZE, &b);
+        eglGetConfigAttrib(sys->display, cfgv[i], EGL_ALPHA_SIZE, &a);
+        eglGetConfigAttrib(sys->display, cfgv[i], EGL_NATIVE_VISUAL_ID, &v);
+        if (r != 8 || g != 8 || b != 8)
+            continue;
+        if (v <= 0) /* no native visual: the format its depths make */
+            v = a ? SCREEN_FORMAT_RGBA8888 : SCREEN_FORMAT_RGBX8888;
+        if (v == SCREEN_FORMAT_RGBX8888 || v == SCREEN_FORMAT_RGBA8888)
+        {
+            cfgv[0] = cfgv[i];
+            visual = v;
+            chosen = i;
+            break;
+        }
+    }
+    if (visual == 0)
+        eglGetConfigAttrib(sys->display, cfgv[0], EGL_NATIVE_VISUAL_ID, &visual);
+    msg_Dbg(obj, "EGL config %d of %d, Screen format %d", chosen, cfgc, visual);
     sys->cfg = cfgv[0];
+    {
+        int format = 0;
+        screen_get_window_property_iv(sys->window, SCREEN_PROPERTY_FORMAT, &format);
+        if (visual > 0 && visual != format)
+        {
+            int nbufs = 0;
+            screen_get_window_property_iv(sys->window, SCREEN_PROPERTY_RENDER_BUFFER_COUNT, &nbufs);
+            if (nbufs > 0)
+                screen_destroy_window_buffers(sys->window);
+            screen_set_window_property_iv(sys->window, SCREEN_PROPERTY_FORMAT, &visual);
+            if (nbufs > 0 && screen_create_window_buffers(sys->window, nbufs) != 0)
+            {
+                msg_Err (obj, "cannot create Screen window buffers in format %d", visual);
+                goto error;
+            }
+        }
+    }
 #endif
 
