From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 13:13:05 -0400
Subject: [PATCH 24/60] Get contrib/gpg-error building with QNX

gpg-error needs to pass the -P flag to the preprocessor via -Wp,-P
instead of directly to qcc, which assigns a different meaning to -P.

Create a local header for QNX8 support that gets copied into gpg-error's
source tree. It is specific to QNX8 though it would probably work fine
for QNX 7.1. If/when support for QNX7.1 is required it can be dealt with
then.

3.0.24: libgpg-error 1.61 is configured with --disable-threads, so its
configure generates lock-obj-pub.native.h itself and the QNX lock-obj header
(and the step that copied it) is gone; the -Wp,-P change is rewritten for
1.61's configure.ac and src/Makefile.am and applied after the upstream
patches.

Upstream-Status: QNX-specific (from qnx-ports)

--- a/contrib/src/gpg-error/0001-qnx-support.patch
+++ b/contrib/src/gpg-error/0001-qnx-support.patch
@@ -0,0 +1,46 @@
+--- a/configure.ac
++++ b/configure.ac
+@@ -124,6 +124,7 @@
+ # Set some variables depending on the platform for later use.
+ have_w32_system=no
+ have_w64_system=no
++have_qnx_system=no
+ case "${host}" in
+     x86_64-*mingw32*)
+         have_w32_system=yes
+@@ -138,6 +139,9 @@
+         AC_DEFINE(_DARWIN_C_SOURCE, 1,
+                   Expose all libc features (__DARWIN_C_FULL).)
+         ;;
++    *-nto-qnx*)
++        have_qnx_system=yes
++        ;;
+     *)
+        ;;
+ esac
+@@ -657,6 +661,7 @@
+ 
+ AM_CONDITIONAL(HAVE_W32_SYSTEM, test "$have_w32_system" = yes)
+ AM_CONDITIONAL(HAVE_W64_SYSTEM, test "$have_w64_system" = yes)
++AM_CONDITIONAL(HAVE_QNX_SYSTEM, test "$have_qnx_system" = yes)
+ AM_CONDITIONAL(CROSS_COMPILING, test x$cross_compiling = xyes)
+ AM_CONDITIONAL(FORCE_USE_SYSCFG, test x$force_use_syscfg = xyes)
+ AM_CONDITIONAL(HAVE_GENERATED_LOCK_OBJ_H, test x$lock_obj_h_generated = xyes)
+--- a/src/Makefile.am
++++ b/src/Makefile.am
+@@ -248,9 +248,14 @@
+ 	$(AWK) -f $(srcdir)/mkerrnos.awk $(srcdir)/errnos.in >$@
+ 
+ # It is correct to use $(CPP).  We want the host's idea of the error codes.
++if HAVE_QNX_SYSTEM
++no_line_markers := -Wp,-P
++else
++no_line_markers := -P
++endif
+ mkerrcodes.h: Makefile mkerrcodes.awk
+ 	$(AWK) -f $(srcdir)/mkerrcodes1.awk $(srcdir)/errnos.in >_$@
+-	$(CPP) $(CPPFLAGS) -P _$@ | grep GPG_ERR_ | \
++	$(CPP) $(CPPFLAGS) $(no_line_markers) _$@ | grep GPG_ERR_ | \
+                $(AWK) -f $(srcdir)/mkerrcodes.awk >$@
+ 	-rm _$@
+ 
--- a/contrib/src/gpg-error/rules.mak
+++ b/contrib/src/gpg-error/rules.mak
@@ -10,6 +10,7 @@
 PKGS_FOUND += gpg-error
 endif
 
+
 .sum-gpg-error: libgpg-error-$(GPGERROR_VERSION).tar.bz2
 
 libgpg-error: libgpg-error-$(GPGERROR_VERSION).tar.bz2 .sum-gpg-error
@@ -40,6 +41,9 @@
 	sed -i.orig -e 's/SetEnvironmentVariable /SetEnvironmentVariableA /g' $(UNPACK_DIR)/src/sysutils.c
 	sed -i.orig -e 's/GetEnvironmentVariable /GetEnvironmentVariableA /g' $(UNPACK_DIR)/src/sysutils.c
 	sed -i.orig -e 's/GetModuleHandle /GetModuleHandleA /g' $(UNPACK_DIR)/src/w32-gettext.c
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/gpg-error/0001-qnx-support.patch
+endif
 
 	$(MOVE)
 
