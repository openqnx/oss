From: Darcy Phipps <dphipps@qnx.com>
Date: Tue, 11 Mar 2025 15:37:03 -0400
Subject: [PATCH 40/60] Get contrib/srt working on QNX8

Add a QNX target type that can be switched on. It is generally treated
the same as the POSIX type but changes a few places where different
header files need to be included.

In addition, make sure that when static libraries are built, they can be
built with -fpic so that VLC can turn them into shared libraries later.

3.0.24: srt 1.5.6: the QNX system type is rewritten for the new
CMakeLists.txt; the PIC part (0002-qnx-static-pic.patch, ENABLE_STATIC_PIC)
is dropped, because VLC's contrib CMake builds now pass
-DCMAKE_POSITION_INDEPENDENT_CODE=ON (upstream ddbbf247).

Upstream-Status: QNX-specific (from qnx-ports)

--- a/contrib/src/srt/0001-qnx-support.patch
+++ b/contrib/src/srt/0001-qnx-support.patch
@@ -0,0 +1,64 @@
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -48,8 +48,9 @@
+ set_if(ANDROID     ${SYSNAME_LC} MATCHES "android")
+ set_if(OHOS        ${CMAKE_SYSTEM_NAME} MATCHES "OHOS")
+ set_if(SUNOS       "${SYSNAME_LC}" MATCHES "sunos")
+-set_if(POSIX       LINUX OR DARWIN OR BSD OR SUNOS OR ANDROID OR OHOS OR (CYGWIN AND CYGWIN_USE_POSIX) OR GNU_OS)
+-set_if(SYMLINKABLE LINUX OR DARWIN OR BSD OR SUNOS OR CYGWIN OR GNU_OS)
++set_if(QNX         ${CMAKE_SYSTEM_NAME} MATCHES "QNX")
++set_if(POSIX       LINUX OR DARWIN OR BSD OR SUNOS OR ANDROID OR OHOS OR (CYGWIN AND CYGWIN_USE_POSIX) OR GNU_OS OR QNX)
++set_if(SYMLINKABLE LINUX OR DARWIN OR BSD OR SUNOS OR CYGWIN OR GNU_OS OR QNX)
+ set_if(NEED_DESTINATION  ${CMAKE_VERSION} VERSION_LESS "3.14.0")
+ 
+ include(GNUInstallDirs)
+@@ -825,6 +826,9 @@
+ elseif(SUNOS)
+ 	add_definitions(-DSUNOS=1)
+ 	message(STATUS "DETECTED SYSTEM: SunOS|Solaris;  SUNOS=1" )
++elseif(QNX)
++	add_definitions(-DQNX=1)
++	message(STATUS "DETECTED SYSTEM: QNX;  QNX=1" )
+ else()
+ 	message(FATAL_ERROR "Unsupported system: ${CMAKE_SYSTEM_NAME}")
+ endif()
+--- a/srtcore/platform_sys.h
++++ b/srtcore/platform_sys.h
+@@ -111,6 +111,14 @@
+ 
+ #endif
+ 
++#ifdef QNX
++
++#ifdef SRT_IMPORT_EVENT
++   #include <unistd.h>
++#endif
++
++#endif
++
+ #include <sys/types.h>
+ #include <sys/socket.h>
+ #include <sys/ioctl.h>
+--- a/srtcore/utilities.h
++++ b/srtcore/utilities.h
+@@ -231,6 +231,9 @@
+ #	define __LITTLE_ENDIAN LITTLE_ENDIAN
+ #	define __PDP_ENDIAN    PDP_ENDIAN
+ 
++#elif defined(__QNXNTO__)
++#	include <gulliver.h>
++
+ #else
+ 
+ #	error Endian: platform not supported
+--- a/srtcore/srt_compat.c
++++ b/srtcore/srt_compat.c
+@@ -22,7 +22,7 @@
+ #include <string.h>
+ #include <stdio.h>
+ #include <errno.h>
+-#if defined(__unix__) && !defined(BSD) && !defined(SUNOS)
++#if defined(__unix__) && !defined(BSD) && !defined(SUNOS) && !defined(QNX)
+ #include <features.h>
+ #endif
+ 
--- a/contrib/src/srt/rules.mak
+++ b/contrib/src/srt/rules.mak
@@ -35,6 +35,9 @@
 srt: srt-$(SRT_VERSION).tar.gz .sum-srt
 	$(UNPACK)
 	$(APPLY) $(SRC)/srt/0001-build-fix-implicit-libraries-set-using-Wl-l-libname..patch
+ifdef HAVE_QNX
+	$(APPLY) $(SRC)/srt/0001-qnx-support.patch
+endif
 	$(call pkg_static,"scripts/srt.pc.in")
 	$(MOVE)
 
