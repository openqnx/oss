From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 09:40:28 -0400
Subject: [PATCH 47/60] Cleanup use of AM_CPPFLAGS

A couple of modules needed to add an include path (-I) to their
CPPFLAGS. They did this by modifying AM_CPPFLAGS which, unfortunately,
impacted everyone else who used it. Gotta love make and its recursively
expanded variables.

This caused a problem because the 'access' module has its own
screen/screen.h that would end up being picked up by the EGL module I
was compiling for QNX instead of QNX's screen/screen.h

Clean this up so that a module's Makefile.am uses a local variable
instead of a global one. This required touching a bunch of #include paths
as they were set with erroneous -I paths paths due to AM_CPPFLAGS being
modified.

Upstream-Status: QNX-specific (from qnx-ports)

--- a/modules/access/Makefile.am
+++ b/modules/access/Makefile.am
@@ -1,7 +1,7 @@
 accessdir = $(pluginsdir)/access
 access_LTLIBRARIES =
 
-AM_CPPFLAGS += -I$(srcdir)/access
+ACCESS_CPPFLAGS = ${AM_CPPFLAGS} -I$(srcdir)/access
 
 ### Files ###
 
@@ -10,7 +10,7 @@
 
 libdcp_plugin_la_SOURCES = access/dcp/dcpparser.h access/dcp/dcp.cpp access/dcp/dcpparser.cpp access/dcp/dcpdecrypt.cpp
 if HAVE_ASDCP
-libdcp_plugin_la_CPPFLAGS = $(AM_CPPFLAGS) $(ASDCP_CFLAGS) -DASDCPLIB_FACTORY=@ASDCPLIB_FACTORY@
+libdcp_plugin_la_CPPFLAGS = $(ACCESS_CPPFLAGS) $(ASDCP_CFLAGS) -DASDCPLIB_FACTORY=@ASDCPLIB_FACTORY@
 libdcp_plugin_la_LIBADD = $(AM_LIBADD) $(ASDCP_LIBS)
 if HAVE_GCRYPT
 libdcp_plugin_la_CPPFLAGS += $(GCRYPT_CFLAGS)
@@ -20,7 +20,7 @@
 endif
 
 libfilesystem_plugin_la_SOURCES = access/fs.h access/file.c access/directory.c access/fs.c
-libfilesystem_plugin_la_CPPFLAGS = $(AM_CPPFLAGS)
+libfilesystem_plugin_la_CPPFLAGS = $(ACCESS_CPPFLAGS)
 if HAVE_WIN32
