From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 09:49:40 -0400
Subject: [PATCH 49/60] Support Qt builds w/o clipboard support

Not all Qt targets have a clipboard. Support this situation by checking
for support and disabling code as required.

Upstream-Status: QNX-specific (from qnx-ports)

--- a/configure.ac
+++ b/configure.ac
@@ -4072,6 +4072,24 @@
 AM_CONDITIONAL([HAVE_QT_GUI_PRIVATE], [test "${have_qt_gui_private}" = "yes"])
 
 dnl
+dnl See if QT supports clipboard
+dnl
+AS_IF([test "${enable_qt}" != "no"], [
+  AC_MSG_CHECKING([for clipboard support in QT])
+  AC_COMPILE_IFELSE([AC_LANG_PROGRAM(
+    [[#include <QtGui/qclipboard.h>
+      #ifdef QT_NO_CLIPBOARD
+      #error QT does not support clipboard
+      #endif
+    ]], [[;]])], [
+      AC_DEFINE([HAVE_QT_CLIPBOARD], [1], [Define to 1 if QT supports clipboard.])
+      AC_MSG_RESULT([yes])
+    ], [
+      AC_MSG_RESULT([no])
+    ])
+])
+
+dnl
 dnl detect kde4-config patch (used for kde solids).
 dnl
 AC_ARG_VAR([KDE4_CONFIG], [kde4-config utility])
--- a/modules/gui/qt/dialogs/messages.cpp
+++ b/modules/gui/qt/dialogs/messages.cpp
@@ -195,9 +195,11 @@
