From: Darcy Phipps <dphipps@qnx.com>
Date: Wed, 12 Mar 2025 09:56:04 -0400
Subject: [PATCH 50/60] Fix NULL-pointer segfault's when running in debug mode

Ran into a few places where vlc would segfault when --enable-debug is
enabled. The extra logging wasn't bothering to check if a string pointer
was NULL or not.

Upstream-Status: QNX-specific (from qnx-ports)

--- a/modules/demux/mp4/libmp4.c
+++ b/modules/demux/mp4/libmp4.c
@@ -1500,8 +1500,7 @@
 
 #ifdef MP4_VERBOSE
     msg_Dbg( p_stream, "read box: \"url\" url: %s",
-                       p_box->data.p_url->psz_location );
-
+                       p_box->data.p_url->psz_location ? p_box->data.p_url->psz_location : "<null>" );
 #endif
     MP4_READBOX_EXIT( 1 );
 }
@@ -1523,8 +1522,8 @@
 
 #ifdef MP4_VERBOSE
     msg_Dbg( p_stream, "read box: \"urn\" name %s location %s",
-                      p_box->data.p_urn->psz_name,
-                      p_box->data.p_urn->psz_location );
+                      p_box->data.p_urn->psz_name ? p_box->data.p_urn->psz_name : "<null>",
+                      p_box->data.p_urn->psz_location ? p_box->data.p_urn->psz_location : "<null>" );
 #endif
     MP4_READBOX_EXIT( 1 );
 }
@@ -3429,7 +3428,7 @@
 #ifdef MP4_VERBOSE
     msg_Dbg( p_stream, "read box: \"cprt\" language %3.3s notice %s",
                       p_box->data.p_cprt->rgs_language,
-                      p_box->data.p_cprt->psz_notice );
+                      p_box->data.p_cprt->psz_notice ? p_box->data.p_cprt->psz_notice : "<null>" );
 
 #endif
     MP4_READBOX_EXIT( 1 );
--- a/src/input/demux.c
+++ b/src/input/demux.c
@@ -232,7 +232,8 @@
         msg_Dbg( p_obj, "creating demux: access='%s' demux='%s' "
                  "location='%s' file='%s'",
                  p_demux->psz_access, p_demux->psz_demux,
-                 p_demux->psz_location, p_demux->psz_file );
+                 p_demux->psz_location,
+                 p_demux->psz_file ? p_demux->psz_file : "" );
 
     p_demux->s              = s;
     p_demux->out            = out;
