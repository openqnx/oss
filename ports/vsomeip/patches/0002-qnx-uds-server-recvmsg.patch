Read UNIX-domain-socket messages on QNX (recvmsg loop was Linux-only).

The routing host reads what local clients send it over the UNIX domain
socket in local_endpoint_receive_op::receive_cb(). The recvmsg() loop that
does the read sits under #if defined(__linux__), so on QNX the handler runs
with 0 bytes and no error after every readiness wake-up: nothing a client
sends is ever read, client-ID assignment never completes, and a second
application on the same host keeps logging "request client timeout".
Run the loop on QNX too, without the Linux-only SCM_CREDENTIALS ancillary
data (QNX has no struct ucred; uid/gid stay ANY, as with security off).

Upstream-Status: Pending

--- a/implementation/endpoints/include/local_server_endpoint_impl_receive_op.hpp
+++ b/implementation/endpoints/include/local_server_endpoint_impl_receive_op.hpp
@@ -55,7 +55,7 @@
         if (!_error) {
             if (!_data->socket_.native_non_blocking())
                 _data->socket_.native_non_blocking(true, _error);
-            #if defined(__linux__)
+            #if defined(__linux__) || defined(__QNX__)
             for (;;) {
                 ssize_t its_result;
                 int its_flags(0);
@@ -65,6 +65,7 @@
                 its_vec[0].iov_base = _data->buffer_;
                 its_vec[0].iov_len = _data->length_;
 
+#if defined(__linux__)
                 union {
                     struct cmsghdr cmh;
                     char   control[CMSG_SPACE(sizeof(struct ucred))];
@@ -74,13 +75,16 @@
                 control_un.cmh.cmsg_len = CMSG_LEN(sizeof(struct ucred));
                 control_un.cmh.cmsg_level = SOL_SOCKET;
                 control_un.cmh.cmsg_type = SCM_CREDENTIALS;
+#endif
 
                 // Build header with all informations to call ::recvmsg
                 auto its_header = msghdr();
                 its_header.msg_iov = its_vec;
                 its_header.msg_iovlen = 1;
+#if defined(__linux__)
                 its_header.msg_control = control_un.control;
                 its_header.msg_controllen = sizeof(control_un.control);
+#endif
 
                 // Call recvmsg and handle its result
                 errno = 0;
@@ -104,6 +108,7 @@
                 if (_data->bytes_ == 0)
                     _error = boost::asio::error::eof;
 
+#if defined(__linux__)
                 // Extract credentials (UID/GID)
                 struct ucred *its_credentials;
                 for (struct cmsghdr *cmsg = CMSG_FIRSTHDR(&its_header);
@@ -123,6 +128,7 @@
                     }
                 }
 
+#endif
                 break;
             }
             #endif
