Get the peer credentials of a UNIX domain socket with getpeereid() on QNX.

vsomeip 3.8 reads the uid/gid of every local (UDS) peer with
getsockopt(SOL_SOCKET, SO_PEERCRED) into a struct ucred, built for Linux and
QNX alike. QNX has neither SO_PEERCRED nor struct ucred (the build stops
there), but it has getpeereid() in <unistd.h>, which returns the same
effective uid and gid of the connected peer. Use it on QNX; an error still
makes the connection fail as before ("Could not getsockopt(SO_PEERCRED)").

Upstream-Status: Pending

--- a/implementation/endpoints/include/asio_uds_socket.hpp
+++ b/implementation/endpoints/include/asio_uds_socket.hpp
@@ -11,6 +11,9 @@
 #include <memory>
 #include <sys/socket.h>
 #include <sys/un.h>
+#if defined(__QNX__)
+#include <unistd.h>
+#endif
 
 namespace vsomeip_v3 {
 
@@ -28,12 +31,24 @@
 
     [[nodiscard]] bool get_peer_credentials(vsomeip_sec_client_t& _client) override {
         int handle = socket_->native_handle();
+#if defined(__QNX__)
+        // QNX has no SO_PEERCRED/struct ucred; getpeereid() gives the peer's
+        // effective uid/gid of a connected UNIX domain socket.
+        uid_t uid;
+        gid_t gid;
+        if (-1 == ::getpeereid(handle, &uid, &gid)) {
+            return false;
+        }
+        _client.user = uid;
+        _client.group = gid;
+#else
         ucred out;
         if (socklen_t len = sizeof(ucred); -1 == ::getsockopt(handle, SOL_SOCKET, SO_PEERCRED, &out, &len)) {
             return false;
         }
         _client.user = out.uid;
         _client.group = out.gid;
+#endif
         _client.port = VSOMEIP_SEC_PORT_UNUSED;
         return true;
     }
