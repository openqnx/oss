meson: QNX's libasound has no alsa.pc

QNX SDP 8.0 ships libasound with an ALSA-compatible API (salsa-based, the
mixer API this plugin uses included) but without alsa.pc, so
dependency('alsa') finds nothing. On QNX, when there is no alsa.pc, take the
C library from the compiler's default paths and the Vala binding from the
plugin's own src/vapi/alsa.vapi. Elsewhere nothing changes.

Upstream-Status: Pending

--- a/meson.build
+++ b/meson.build
@@ -24,7 +24,20 @@
     add_project_arguments('--define=XFCE_420', language : 'vala')
 endif
 
-dependencies = [dependency('alsa'),
+alsa_dep = dependency('alsa', required : false)
+if not alsa_dep.found() and host_machine.system() == 'qnx'
+    # QNX's libasound (in the SDP; an ALSA-compatible API) comes without an
+    # alsa.pc: the C library from the compiler's default paths, the Vala
+    # binding (src/vapi/alsa.vapi) by name, with posix, which its alsa.deps
+    # names (find_library does not read .deps)
+    alsa_dep = [meson.get_compiler('c').find_library('asound', has_headers : ['alsa/asoundlib.h']),
+                meson.get_compiler('vala').find_library('posix'),
+                meson.get_compiler('vala').find_library('alsa', dirs : vapi_dir)]
+elif not alsa_dep.found()
+    alsa_dep = dependency('alsa')
+endif
+
+dependencies = [alsa_dep,
                 dependency('gtk+-3.0', version : '>= 3.20.0'),
                 libxfce4panel_dep,
                 meson.get_compiler('vala').find_library('config', dirs : vapi_dir)]
