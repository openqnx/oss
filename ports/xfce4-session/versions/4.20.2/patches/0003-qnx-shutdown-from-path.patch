Power off and restart: shutdown found in PATH, sudo only when not root

Upstream-Status: QNX-specific

--- a/libxfsm/xfsm-shutdown-common.h
+++ b/libxfsm/xfsm-shutdown-common.h
@@ -51,8 +51,10 @@
 #define POWEROFF_CMD "/usr/sbin/shutdown -i 5 -g 0 -y"
 #define REBOOT_CMD "/usr/sbin/shutdown -i 6 -g 0 -y"
 #elif defined(__QNX__)
-#define POWEROFF_CMD "sudo /usr/bin/shutdown -S system"
-#define REBOOT_CMD "sudo /usr/bin/shutdown -S reboot"
+/* shutdown is /usr/bin/shutdown on the QNX Everywhere image and /system/bin/shutdown on a
+ * mkqnximage image: found in PATH; sudo only when the session is not root's (it may not be installed). */
+#define POWEROFF_CMD "sh -c 'if [ \"$(id -u)\" = 0 ]; then exec shutdown -S system; else exec sudo shutdown -S system; fi'"
+#define REBOOT_CMD "sh -c 'if [ \"$(id -u)\" = 0 ]; then exec shutdown -S reboot; else exec sudo shutdown -S reboot; fi'"
 #else
 #define POWEROFF_CMD "/sbin/shutdown -h now"
 #define REBOOT_CMD "/sbin/shutdown -r now"
