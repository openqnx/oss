diff -ruN a/src/task-manager-qnx.c b/src/task-manager-qnx.c
--- a/src/task-manager-qnx.c	1970-01-01 09:00:00.000000000 +0900
+++ b/src/task-manager-qnx.c	2026-11-25 17:11:13.627080664 +0900
@@ -0,0 +1,338 @@
+/*
