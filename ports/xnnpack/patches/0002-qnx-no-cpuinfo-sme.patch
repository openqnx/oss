diff --git a/src/configs/hardware-config.c b/src/configs/hardware-config.c
index 5904368..628abd8 100644
--- a/src/configs/hardware-config.c
+++ b/src/configs/hardware-config.c
@@ -109,9 +109,18 @@ static void init_hardware_config(void) {
     hardware_config.use_arm_neon_i8mm = cpuinfo_has_arm_i8mm();
     hardware_config.use_arm_sve = cpuinfo_has_arm_sve();
     hardware_config.use_arm_sve2 = cpuinfo_has_arm_sve2();
+  #if defined(__QNX__)
+    /* The cpuinfo this is built against (the qnx-ports base, 2024-04)
+       predates cpuinfo_has_arm_sme/_sme2: called anyway, they were implicit
+       declarations and left libXNNPACK.so with two undefined symbols. Its QNX
+       backend detects no SME either, so report none. */
+    hardware_config.use_arm_sme = false;
+    hardware_config.use_arm_sme2 = false;
+  #else
     hardware_config.use_arm_sme = cpuinfo_has_arm_sme();
     hardware_config.use_arm_sme2 = cpuinfo_has_arm_sme2();
   #endif
+  #endif
 
   #if XNN_ARCH_X86 || XNN_ARCH_X86_64
     hardware_config.use_x86_ssse3 = cpuinfo_has_x86_ssse3();
