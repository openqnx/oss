--- a/src/macros/mod.rs
+++ b/src/macros/mod.rs
@@ -498,6 +498,7 @@
             target_os = "dragonfly",
             target_os = "illumos",
             target_os = "haiku",
+            target_os = "nto",
             target_vendor = "apple",
             target_family = "wasm",
             windows
@@ -528,6 +529,7 @@
