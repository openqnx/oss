+//! QNX backend: network interface listing; no raw data-link channels.
+//!
+//! interfaces() uses getifaddrs(), as the other Unix backends do. A layer-2
+//! channel would need BPF bindings for QNX's io-sock, which this crate does
+//! not have, so channel() reports the operation as unsupported instead of
+//! failing to compile.
+
+use std::io;
+use std::time::Duration;
+
+use crate::NetworkInterface;
+
+/// Configuration for the QNX backend (accepted and ignored).
+#[derive(Clone, Copy, Debug, Default, Eq, Hash, PartialEq)]
+pub struct Config {
+    /// Unused on QNX.
+    pub read_timeout: Option<Duration>,
+}
+
+impl<'a> From<&'a super::Config> for Config {
+    fn from(config: &super::Config) -> Config {
+        Config { read_timeout: config.read_timeout }
+    }
+}
+
+/// Raw data-link channels are not available on QNX.
+#[inline]
+pub fn channel(_: &NetworkInterface, _: Config) -> io::Result<super::Channel> {
+    Err(io::Error::new(io::ErrorKind::Unsupported, "data-link channels are not supported on QNX"))
+}
+
+/// Get a list of available network interfaces for the current machine.
+pub fn interfaces() -> Vec<NetworkInterface> {
+    #[path = "unix_interfaces.rs"]
+    mod interfaces;
+    interfaces::interfaces()
+}
