polling: notification pipe without pipe2() on QNX.

The poll() backend makes its notification pipe with rustix's pipe_with()
(pipe2), which rustix does not provide for QNX: "unresolved import
rustix::pipe::pipe_with". Use the fallback polling already has for Haiku,
pipe() followed by fcntl() for FD_CLOEXEC.

Applied to polling 3.7.3 (the version zenoh-c's Cargo.lock pins) by
ports/zenoh-c/recipe.sh.

Upstream-Status: Pending

--- a/src/poll.rs
+++ b/src/poll.rs
@@ -635,7 +635,7 @@
     use rustix::fd::{AsFd, AsRawFd, BorrowedFd, OwnedFd, RawFd};
     use rustix::fs::{fcntl_getfl, fcntl_setfl, OFlags};
     use rustix::io::{fcntl_getfd, fcntl_setfd, read, write, FdFlags};
-    #[cfg(not(target_os = "haiku"))]
+    #[cfg(not(any(target_os = "haiku", target_os = "nto")))]
     use rustix::pipe::pipe_with;
     use rustix::pipe::{pipe, PipeFlags};
 
@@ -665,10 +665,10 @@
                 io::Result::Ok((read_pipe, write_pipe))
             };
 
-            #[cfg(not(target_os = "haiku"))]
+            #[cfg(not(any(target_os = "haiku", target_os = "nto")))]
             let (read_pipe, write_pipe) = pipe_with(PipeFlags::CLOEXEC).or_else(fallback_pipe)?;
 
-            #[cfg(target_os = "haiku")]
+            #[cfg(any(target_os = "haiku", target_os = "nto"))]
             let (read_pipe, write_pipe) = fallback_pipe(PipeFlags::CLOEXEC)?;
 
             // Put the reading side into non-blocking mode.
