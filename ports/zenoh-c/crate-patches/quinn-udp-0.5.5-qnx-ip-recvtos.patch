             if let Err(_err) =
-                set_socket_option(&*io, libc::IPPROTO_IP, libc::IP_RECVTOS, OPTION_ON)
+                set_socket_option(&*io, libc::IPPROTO_IP, IP_RECVTOS, OPTION_ON)
             {
                 debug!("Ignoring error setting IP_RECVTOS on socket: {_err:?}");
             }
