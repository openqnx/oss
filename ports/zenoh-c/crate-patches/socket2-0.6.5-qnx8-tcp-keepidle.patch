+++ b/src/sys/unix.rs
@@ -344,8 +344,14 @@
     target_os = "tvos",
     target_os = "watchos",
     target_os = "vita",
+    all(target_os = "nto", target_env = "nto80"),
 )))]
 use libc::TCP_KEEPIDLE as KEEPALIVE_TIME;
+// QNX 8 (io-sock): the libc crate releases that still know target_env
+// "nto80" do not define TCP_KEEPIDLE; the value is the one in QNX 8's
+// <netinet/tcp.h>. Like the BSDs, it takes the idle time in seconds (int).
+#[cfg(all(target_os = "nto", target_env = "nto80"))]
+const KEEPALIVE_TIME: c_int = 256;
 
