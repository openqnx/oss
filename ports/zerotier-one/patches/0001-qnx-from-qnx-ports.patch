+void QNXEthernetTap::setFriendlyName(const char* friendlyName)
+{
+	// No-op on QNX
+}
+
+void QNXEthernetTap::scanMulticastGroups(std::vector<MulticastGroup>& added,
+	std::vector<MulticastGroup>& removed)
+{
+	std::vector<MulticastGroup> newGroups;
+
+	// QNX does not have getifmaddrs(); derive multicast groups from assigned IPs only
+	std::vector<InetAddress> allIps(ips());
+	for (std::vector<InetAddress>::iterator ip(allIps.begin()); ip != allIps.end(); ++ip)
+		newGroups.push_back(MulticastGroup::deriveMulticastGroupForAddressResolution(*ip));
+
+	std::sort(newGroups.begin(), newGroups.end());
+	newGroups.erase(std::unique(newGroups.begin(), newGroups.end()), newGroups.end());
+
+	for (std::vector<MulticastGroup>::iterator m(newGroups.begin()); m != newGroups.end(); ++m) {
+		if (! std::binary_search(_multicastGroups.begin(), _multicastGroups.end(), *m))
+			added.push_back(*m);
+	}
+	for (std::vector<MulticastGroup>::iterator m(_multicastGroups.begin()); m != _multicastGroups.end(); ++m) {
+		if (! std::binary_search(newGroups.begin(), newGroups.end(), *m))
+			removed.push_back(*m);
+	}
+
+	_multicastGroups.swap(newGroups);
+}
+
+void QNXEthernetTap::setMtu(unsigned int mtu)
+{
+	if (mtu != _mtu) {
+		_mtu = mtu;
+		char tmp[64];
+		OSUtils::ztsnprintf(tmp, sizeof(tmp), "%u", mtu);
+		long cpid = (long)vfork();
+		if (cpid == 0) {
+#ifdef ZT_TRACE
+			fprintf(stderr, "DEBUG: ifconfig %s mtu %s" ZT_EOL_S, _dev.c_str(), tmp);
+#endif
+			execl("/usr/bin/ifconfig", "/usr/bin/ifconfig", _dev.c_str(), "mtu", tmp, (const char*)0);
+			_exit(-1);
+		}
+		else if (cpid > 0) {
+			int exitcode = -1;
+			waitpid(cpid, &exitcode, 0);
+		}
+	}
+}
