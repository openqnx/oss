#!/usr/bin/env python3
"""download-stats -- how much the releases and the repository are used.

    scripts/download-stats [-n TOP] [--csv FILE]

GitHub only keeps counts, never who: this shows
  - downloads per release (apk/packages-8.0-<arch> and their -m-z shards,
    tests-8.0-<arch>; scripts/lib/shards.py) and in total,
  - the most downloaded packages (per component and version, both arches
    and both formats added up),
  - repository traffic over the last 14 days (views, unique visitors,
    clones, referring sites, most-viewed pages) -- only readable with push
    access, so run it as the maintainer (gh logged in).
--csv writes every asset's count, to compare with an earlier run.
"""
import argparse, collections, csv, json, os, re, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))
import shards

REPO = "openqnx/oss"
TAGS = shards.tags()


def gh(path, paginate=False):
    cmd = ["gh", "api"] + (["--paginate"] if paginate else []) + [path]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode:
        return None
    if paginate:   # pages of JSON arrays, concatenated
        return [x for chunk in re.findall(r"\[.*?\](?=\[|\s*$)", out.stdout, re.S) for x in json.loads(chunk)]
    return json.loads(out.stdout)


ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
ap.add_argument("-n", type=int, default=20, help="how many top packages to list (20)")
ap.add_argument("--csv", help="write every asset's download count to this file")
args = ap.parse_args()

rows, per_tag, per_pkg = [], {}, collections.Counter()
for tag in TAGS:
    rel = gh(f"repos/{REPO}/releases/tags/{tag}")
    if not rel:
        print(f"{tag}: not readable (gh logged in? not created yet?)", file=sys.stderr)
        continue
    assets = gh(f"repos/{REPO}/releases/{rel['id']}/assets?per_page=100", paginate=True) or []
    per_tag[tag] = sum(a["download_count"] for a in assets)
    for a in assets:
        rows.append((tag, a["name"], a["download_count"]))
        m = re.match(r"(.+?-\d[^-]*-r\d+)\.(apk|tar\.gz)$", a["name"])
        if m:
            per_pkg[m.group(1)] += a["download_count"]

print("== Downloads per release")
for tag in TAGS:
    if tag in per_tag:
        print(f"  {tag:26} {per_tag[tag]:>7}")
print(f"  {'total':26} {sum(per_tag.values()):>7}")

print(f"\n== Most downloaded packages (both arches, .apk + .tar.gz)")
for name, n in per_pkg.most_common(args.n):
    print(f"  {n:>6}  {name}")
idx = sum(n for t, a, n in rows if a in ("APKINDEX.tar.gz", "INDEX"))
print(f"  (index files: {idx} -- their count restarts at every publish, which uploads them again)")

print("\n== Repository traffic, last 14 days (maintainers only)")
v, c = gh(f"repos/{REPO}/traffic/views"), gh(f"repos/{REPO}/traffic/clones")
if v is None:
    print("  not readable: needs push access to the repository")
else:
    print(f"  views {v['count']} (unique visitors {v['uniques']}), clones {c['count']} (unique {c['uniques']})")
    for r in gh(f"repos/{REPO}/traffic/popular/referrers") or []:
        print(f"  from {r['referrer']:30} {r['count']:>5} views, {r['uniques']} unique")
    for p in (gh(f"repos/{REPO}/traffic/popular/paths") or [])[:10]:
        print(f"  page {p['path'][:60]:60} {p['count']:>5}")

if args.csv:
    with open(args.csv, "w", newline="") as f:
        csv.writer(f).writerows([("release", "asset", "downloads")] + rows)
    print(f"\nwrote {args.csv} ({len(rows)} assets)")
