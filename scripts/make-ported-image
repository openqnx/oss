#!/bin/bash
# make-ported-image -- a QEMU image (mkqnximage) that uses the ports first:
# QNX supplies the boot layer and what has no port, everything else comes
# from /usr/local. docs/ported-first-image.md explains the layout.
#
#   source ./env.sh <arch>
#   scripts/make-ported-image [-n <vm-name>] [--apk | --desktop] [<package>...]
#
# Two kinds of image, with the given packages (default: the base set below):
#   (default)  the packages of THIS workspace (dists/<sdp>/<arch>) and their
#              dependencies are put into the image, read-only, as
#              /system/usr/local. Nothing is downloaded, on the host or on
#              the target.
#   --apk      the image carries only apk-tools and what it needs, downloaded
#              from the project's GitHub releases when the image is made
#              (kept in dist/github/, used from there). At boot the target
#              sets up apk from that copy and installs the packages from
#              GitHub itself, into /data/oss (seen as /usr/local); later
#              "apk add / upgrade" on the target, or edit
#              /data/oss/etc/oss-packages and reboot. target/oss-boot.
#
#   --desktop  an --apk image with graphics that boots into the Xfce desktop,
#              in the way of QNX Everywhere's Developer Desktop: QNX Screen,
#              then oss-desktop (labwc, xfce4-session, the panel with the
#              Applications menu and the log out / restart / shut down
#              buttons, terminal, file manager), the web browser, editors and
#              the compiler that runs on the target -- all installed from
#              GitHub at the first boot (several minutes; the desktop comes up
#              when that is done, and at once on later boots). Needs QNX's
#              "Screen Board Support VirtIO" package in the SDP.
#
# Makes lab/vm/<vm-name> (default oss-ported-<arch>, oss-apk-<arch>,
# oss-qdd-<arch>).
# Start it:  cd lab/vm/<vm-name> && mkqnximage --run=-h ; mkqnximage --getip
#            (--desktop: mkqnximage --run, in a desktop session: QEMU opens a window)
# An existing VM directory of that name is rebuilt with the new contents.
set -eo pipefail
WS=$(cd "$(dirname "$0")/.." && pwd)
. "$WS/scripts/lib/sdp.sh"
[ -n "$QNX_ARCH" ] || { echo "source ./env.sh <arch> first" >&2; exit 1; }
A=$QNX_ARCH; NAME=""; APK=""; DESKTOP=""
while :; do case "$1" in
  -n) NAME=$2; shift 2 ;;
  --apk) APK=1; shift ;;
  --desktop) APK=1; DESKTOP=1; shift ;;
  *) break ;;
esac; done
if [ -z "$NAME" ]; then
  if [ -n "$DESKTOP" ]; then NAME=oss-qdd-$A; elif [ -n "$APK" ]; then NAME=oss-apk-$A; else NAME=oss-ported-$A; fi
fi
BASE="toybox bash openssh openssl curl ca-certificates sqlite gawk grep less vim tar xz bzip2 file
      libarchive ncurses dhcpcd chrony tcpdump iperf3 htop gdb sudo tzdata apk-tools inetutils"
# --desktop: the session, what the Developer Desktop comes with (browser,
# editors, calculator, image viewer, GTK demos) and the tools to build on the target.
DESKTOP_SET="oss-desktop xfce4-session xfce4-settings adwaita-icon-theme font-dejavu
      epiphany geany emacs neovim mate-calc gthumb gtk3 gtk4 foot
      llvm binutils make cmake ninja pkgconf git python3 nano"
if [ $# -eq 0 ]; then set -- $BASE; [ -n "$DESKTOP" ] && set -- "$@" $DESKTOP_SET; fi
PORTS_PATH=/usr/local/bin:/usr/local/sbin:/usr/local/opt/toybox/bin:/system/bin:/proc/boot
PORTS_LIBS=/usr/local/lib:/system/lib:/system/lib/dll:/proc/boot
# env.sh points QNX_TARGET at the build's link root, a view of the SDP without
# the libraries that have a port; the image is made from the SDP itself.
export QNX_TARGET=$QNX_SDP_ROOT/target/qnx
SDPT=$QNX_TARGET/$A

if [ -n "$APK" ]; then
  # 1. apk-tools and what it needs, from GitHub: unpacked (root/) and as a
  #    repository apk can install itself from (repo/).
  R=$WS/build/image-seed/$A
  "$WS/scripts/make-image-root" --github --seed-repo "$R/repo" -o "$R/root" "$A" apk-tools ca-certificates
  PORTS_PATH=/data/oss/bin:$PORTS_PATH
  SYS_MB=150; DATA_MB=6000; DATA_INODES=200000
  if [ -n "$DESKTOP" ]; then
    DATA_MB=16000; DATA_INODES=600000
    # What the compiler on the target needs from QNX (headers, link-time
    # files), from this SDP: in the image as /system/qnx-dev, seen as
    # /usr/include and /usr/lib.
    DEV=$WS/build/dev-sysroot/$A
    "$WS/scripts/make-dev-sysroot" "$A" "$DEV"
    SYS_MB=$(( SYS_MB + $(du -sm "$DEV" | cut -f1) * 5 / 4 + 100 ))
  fi
else
  # 1. The ports and their dependencies, unpacked.
  R=$WS/build/image-root/$A
  "$WS/scripts/make-image-root" -o "$R" "$A" "$@"
  # 2. toybox is packaged as one binary without command links (on a QNX image
  #    its names would collide with QNX's toybox); here the image is ours, so
  #    its commands are linked next to it, after the full tools in PATH.
  G=$WS/build/$A/toybox/generated; T=$R/usr/local/opt/toybox/bin
  if [ -x "$T/toybox" ] && [ -f "$G/newtoys.h" ]; then
    python3 - "$G" "$T" <<'EOT'
import os, re, sys
g, t = sys.argv[1:]
on = {m.group(1) for m in re.finditer(r'#define CFG_(\w+) 1', open(g + '/config.h').read())}
for m in re.finditer(r'USE_(\w+)\((?:NEW|OLD)TOY\((\w+|\[)', open(g + '/newtoys.h').read()):
    if m.group(1) in on and m.group(2) != 'toybox' and not os.path.lexists(f'{t}/{m.group(2)}'):
        os.symlink('toybox', f'{t}/{m.group(2)}')
EOT
  else
    echo "note: no toybox command links (toybox not chosen, or build/$A/toybox is gone: scripts/qnxbuild -a $A -f toybox)" >&2
  fi
  SYS_MB=$(( $(du -sm "$R" | cut -f1) * 3 / 2 + 300 )); DATA_MB=2000; DATA_INODES=40000
fi

# 3. The image directory, with room for the ports.
V=$WS/lab/vm/$NAME; mkdir -p "$V" "$WS/logs"; cd "$V"; LOG=$WS/logs/make-ported-image-$NAME.log
SSHID=$WS/tests/ssh/qnx-target.pub; [ -f "$SSHID" ] || SSHID=none
GFX=(--graphics=no --ram=2G); [ -n "$DESKTOP" ] && GFX=(--graphics=yes --ram=4G)
SYS_INODES=60000; [ -n "$DESKTOP" ] && SYS_INODES=120000
mkqnximage --noprompt --type=qemu --arch="$A" --hostname="${NAME#oss-}" --ssh-ident="$SSHID" "${GFX[@]}" \
  --sys-size=$SYS_MB --sys-inodes=$SYS_INODES --data-size=$DATA_MB --data-inodes=$DATA_INODES --cpu=4 > "$LOG" 2>&1 \
  || { tail -n 20 "$LOG" >&2; exit 1; }

# 4. What this adds to the image: everything between the markers, replaced
#    on every run.
put() { # put <snippet> : stdin replaces the marked block of local/snippets/<snippet>
  local f=local/snippets/$1
  sed -i '/^# >>> ported-first/,/^# <<< ported-first/d' "$f"
  { echo "# >>> ported-first (scripts/make-ported-image; docs/ported-first-image.md)"; cat; echo "# <<< ported-first"; } >> "$f"
}
inimage() { grep -qE "(^|[/=])$(printf %s "$1" | sed 's/[.+]/\\&/g')(\$|=)" output/build/ifs.build output/build/system.build; }
{
  if [ -n "$APK" ]; then
    K=$(ls "$WS"/keys/*.rsa.pub | head -n 1)
    cat <<EOT
[uid=0 gid=0 dperms=755 type=dir] oss-seed
[uid=0 gid=0 dperms=755 type=dir] oss-seed/usr
[uid=0 gid=0 dperms=755 type=dir] oss-seed/keys
[-followlink uid=0 gid=0 perms=* dperms=755] oss-seed/usr/local=$R/root/usr/local
[uid=0 gid=0 perms=444 dperms=755] oss-seed/repo=$R/repo
[uid=0 gid=0 perms=444] oss-seed/keys/$(basename "$K")=$K
[uid=0 gid=0 perms=555] oss-seed/apk-setup=$WS/target/apk-setup
[uid=0 gid=0 perms=555] oss-seed/oss-boot=$WS/target/oss-boot
[uid=0 gid=0 perms=444] oss-seed/sdp={
$SDP
}
[uid=0 gid=0 perms=444] oss-seed/packages={
# The packages this target installs at boot (target/oss-boot). The copy in
# use is /data/oss/etc/oss-packages.
$*
}
[uid=0 gid=0 perms=444] oss-seed/desktop={
$DESKTOP
}
EOT
    # Every QNX library a package may link (scripts/check-sdp-leak), since
    # what will be installed is not known here.
    stems=$(sed -n '/^QNX_OS_LIBS="/,/"$/p' "$WS/scripts/check-sdp-leak" | tr -d '"' | sed 's/QNX_OS_LIBS=//')
    for s in $stems; do
      for f in "$SDPT"/lib/$s.so.[0-9] "$SDPT"/lib/$s.so.[0-9][0-9] "$SDPT"/usr/lib/$s.so.[0-9] "$SDPT"/usr/lib/$s.so.[0-9][0-9]; do
        [ -f "$f" ] && ! inimage "$(basename "$f")" && echo "[uid=0 gid=0 perms=555] lib/$(basename "$f")=$f"
      done
    done
    if [ -n "$DESKTOP" ]; then
      echo "[uid=0 gid=0 dperms=755 type=dir] qnx-dev"
      echo "[-followlink uid=0 gid=0 perms=* dperms=755] qnx-dev/usr=$DEV/usr"
    fi
    # libgbm (wlroots' allocator) opens its DRI backend by name: dri_gbm.so
    # ("Can't open 'dri' library!" without it; labwc does not start).
    [ -f "$SDPT/usr/lib/dri_gbm.so" ] && ! inimage dri_gbm.so && echo "[uid=0 gid=0 perms=555] lib/dri_gbm.so=$SDPT/usr/lib/dri_gbm.so"
  else
    echo "[uid=0 gid=0 dperms=755 type=dir] usr"
    echo "[-followlink uid=0 gid=0 perms=* dperms=755] usr/local=$R/usr/local"
    # QNX run-time libraries the ports need and the image does not carry.
    while IFS=$'\t' read -r n p; do inimage "$n" || echo "[uid=0 gid=0 perms=555] lib/$n=$p"; done < "$R/QNX-RUNTIME"
  fi
  cat <<EOT
[uid=0 gid=0 perms=444] etc/ssh/sshd_config.ported={
# The ported OpenSSH (/usr/local/sbin/sshd); it takes the place of the sshd of QNX.
Port 22
HostKey /data/var/ssh/ssh_host_rsa_key
HostKey /data/var/ssh/ssh_host_ed25519_key
AuthorizedKeysFile	.ssh/authorized_keys
PasswordAuthentication no
PermitUserEnvironment yes
PidFile none
# Sessions that read no profile ("ssh host command") get the ports first too.
SetEnv PATH=$PORTS_PATH LD_LIBRARY_PATH=$PORTS_LIBS SSL_CERT_FILE=/usr/local/ssl/cert.pem TERMINFO=/usr/local/share/terminfo
Subsystem sftp /usr/local/libexec/sftp-server
}
[uid=0 gid=0 dperms=755 perms=555]
EOT
} | put system_files.custom
put data_files.custom <<'EOT'
# privilege separation directory of the ported sshd
[uid=0 gid=0 type=dir dperms=755] var/empty
EOT
put profile.custom <<EOT
export PATH=$PORTS_PATH
export LD_LIBRARY_PATH=$PORTS_LIBS
export SSL_CERT_FILE=/usr/local/ssl/cert.pem
export TERMINFO=/usr/local/share/terminfo
EOT
if [ -n "$APK" ]; then
  put post_start.custom <<'EOT'
# apk set-up and the packages from GitHub, in the background: the boot does
# not wait for the network. Log: /data/oss/var/log/oss-boot.log
/system/oss-seed/oss-boot &
EOT
  [ -n "$DESKTOP" ] && sed -i '/^# <<< ported-first/i\
# the headers and link-time files of QNX, where the compiler on the target looks\
[ -d /system/qnx-dev/usr/include ] \&\& ln -sP /system/qnx-dev/usr/include /usr/include\
[ -d /system/qnx-dev/usr/lib ] \&\& ln -sP /system/qnx-dev/usr/lib /usr/lib' local/snippets/post_start.custom
else
  put post_start.custom <<EOT
ln -sP /system/usr/local /usr/local
export PATH=$PORTS_PATH
export LD_LIBRARY_PATH=$PORTS_LIBS
# log-in shell of root: the ported bash (the account file is on /data)
if [ -x /usr/local/bin/bash ]; then
  grep -q '^root:.*:/usr/local/bin/bash\$' /data/var/etc/passwd || sed -i 's#^\\(root:.*\\):/bin/sh\$#\\1:/usr/local/bin/bash#' /data/var/etc/passwd
fi
# the ported sshd instead of the one startup.sh started
if [ -x /usr/local/sbin/sshd ]; then
  slay -f sshd 2>/dev/null
  /usr/local/sbin/sshd -f /system/etc/ssh/sshd_config.ported
fi
EOT
fi

# 5. Build the image with them.
mkqnximage --noprompt --build >> "$LOG" 2>&1 || { tail -n 20 "$LOG" >&2; exit 1; }
if [ -n "$DESKTOP" ]; then
  echo "$V: image built. Start (in a desktop session, QEMU opens a window): cd $V && mkqnximage --run; mkqnximage --getip"
  echo "  first boot: the packages come from GitHub, then the desktop starts (log on the target: /data/oss/var/log/oss-boot.log)"
else
  echo "$V: image built. Start: cd $V && mkqnximage --run=-h; mkqnximage --getip"
fi
