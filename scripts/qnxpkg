    "test_whisper": ["opt/whisper.cpp/lib", "opt/whisper.cpp/share/models"],
    "test_sdcpp": ["opt/stable-diffusion.cpp/bin/sd-cli"],
    "test_pymods": ["bin/python3", "lib/python3.14/site-packages/astor", "lib/python3.14/site-packages/async_generator", "lib/python3.14/site-packages/click", "lib/python3.14/site-packages/coverage", "lib/python3.14/site-packages/idna", "lib/python3.14/site-packages/mypy_extensions.py", "lib/python3.14/site-packages/pretend.py", "lib/python3.14/site-packages/pluggy", "lib/python3.14/site-packages/iniconfig", "lib/python3.14/site-packages/pygments", "lib/python3.14/site-packages/pytest", "lib/python3.14/site-packages/pytest_cov", "lib/python3.14/site-packages/pytest_tornasync", "lib/python3.14/site-packages/pytokens", "lib/python3.14/site-packages/sniffio", "lib/python3.14/site-packages/sortedcontainers", "lib/python3.14/site-packages/traitlets", "lib/python3.14/site-packages/versioneer.py", "lib/python3.14/site-packages/curio", "lib/python3.14/site-packages/tornado"],
    "test_ts_grammars": ["lib/tree-sitter/bash.so", "lib/tree-sitter/python.so",
                         "lib/tree-sitter/cmake.so", "lib/tree-sitter/make.so"],
}
TESTS_VERSION = "1.0"


def package_tests(arch, args, owner, outdir):
    """The on-target port tests as packages: qnx-test-<name> per test program
    (its run-time dependencies computed like any package's, plus TEST_EXTRAS),
    and qnx-port-tests with the runner that runs every installed test."""
    stage = os.path.join(WS, "stage", arch)
    tdir = "usr/local/bin/qnx-port-tests"
    if not os.path.isdir(os.path.join(stage, tdir)):
        print("!! [%s] no port tests staged (run: tests/build-tests.sh %s)" % (arch, arch))
        return []
    files_of = {}
    mdir = os.path.join(stage, ".manifest")
    for comp in os.listdir(mdir):
        files_of[comp] = open(os.path.join(mdir, comp)).read().split("\n")
    def owners_of(path):
        # The packages that hold the path: <comp>, or <comp>-dev when the
        # matching files are development files (or the component ships only
        # a -dev package, like rust or a header-only library).
        pre = "usr/local/" + path
        out = set()
        for c, fs in files_of.items():
            hit = [f for f in fs if f == pre or f.startswith(pre + "/")]
            if not hit:
                continue
            runtime = [f for f in fs if f and not is_dev(f)]
            out.add(c if runtime and not all(is_dev(f) for f in hit) else c + "-dev")
        # Alternatives that hold the same file (sdl2 and sdl2-compat, which
        # declare CONFLICTS with each other) cannot both be dependencies:
        # apk could never install the test. Keep the first by name.
        keep = set()
        for p in sorted(out):
            base = p[:-4] if p.endswith("-dev") else p
            if not any(base in recipe_meta(k[:-4] if k.endswith("-dev") else k)["conflicts"] for k in keep):
                keep.add(p)
        return keep
    # tests/run-level/<group>.extras: "test_x<TAB>path path ..." -- what a
    # run-level test needs installed beyond what its binary links.
    run_level_extras = {}
    for f in sorted(glob.glob(os.path.join(WS, "tests", "run-level", "*.extras"))):
        for l in open(f):
            if l.strip() and not l.startswith("#"):
                k, _, v = l.rstrip("\n").partition("\t")
                run_level_extras.setdefault(k.strip(), []).extend(v.split())
    tool = readelf(arch)
    san = Sanitizer(stage, None, arch)
    out = []
    db = os.path.join(outdir, ".index.json")
    existing = json.load(open(db)) if os.path.exists(db) else {}
    def emit(pname, root, rels, deps, desc):
        allr = set()
        for r in rels:
            while r:
                allr.add(r)
                r = os.path.dirname(r)
        rels = sorted(allr)
        fp = fingerprint(root, rels, san=san)
        ver = "%s-r%d" % (TESTS_VERSION, choose_release(existing, pname, TESTS_VERSION, fp, args.release,
                                                        fingerprint(root, rels, v=1)))
        same = not BUMP and unchanged(existing, outdir, pname, ver, fp, fingerprint(root, rels, v=1))
        if same and same[1].split("|")[2] != ",".join(deps):
            # same files, other dependencies: a new release (as for components)
            ver = "%s-r%d" % (TESTS_VERSION, int(ver.rpartition("-r")[2]) + 1)
            print("   %s: dependencies changed -> %s" % (pname, ver))
            same = None
        if same:
            out.append(same); return
        meta = {"version": TESTS_VERSION, "url": "https://github.com/openqnx/oss/tree/main/tests",
                "desc": desc, "license": "see tests/", "origin": "qnx-port-tests", "conflicts": []}
        tgz, sha, size = make_tgz("%s-%s" % (pname, ver), root, rels, san, outdir)
        line = "|".join([pname, ver, ",".join(deps), tgz, sha, str(size), desc, ""])
        e = make_apk(pname, ver, arch, meta, root, rels, deps, [], san, args.key, outdir)
        e["fp"] = fp
        out.append((e, line))
    # Which components each test checks (tests/port-tests.tsv and the run-level
    # groups). A test's helper programs -- test_bison_calc for test_bison,
    # test_inetutils_inetd for test_inetutils -- are tests of the same
    # component named <test>_*; the main test's package depends on theirs, so
    # installing it brings them. (The shared component keeps test_python3 from
    # pulling in every test_python3_<module>.)
    comps_of = {}
    for tsv in [os.path.join(WS, "tests", "port-tests.tsv")] + glob.glob(os.path.join(WS, "tests", "run-level", "*.tsv")):
        if os.path.exists(tsv):
            for l in open(tsv):
                f = l.rstrip("\n").split("\t")
                if len(f) >= 2 and not l.startswith("#"):
                    comps_of.setdefault(f[1], set()).add(f[0])
    names = sorted(os.listdir(os.path.join(stage, tdir)))
    for n in names:
        if not n.startswith("test_"):
            continue
        rel = os.path.join(tdir, n)
        deps = set()
        info = elf_info(os.path.join(stage, rel), tool)
        if info:
            deps |= {owner[s] for s in info[1] if s in owner}
        for x in TEST_EXTRAS.get(n, []) + run_level_extras.get(n, []):
            deps |= owners_of(x)
        deps |= {"qnx-test-" + h[len("test_"):].replace("_", "-") for h in names
                 if h.startswith(n + "_") and comps_of.get(h, set()) & comps_of.get(n, set())}
        pname = "qnx-test-" + n[len("test_"):].replace("_", "-")
        emit(pname, stage, [rel], sorted(deps), "QNX port test %s: checks its component on the target" % n)
    # The runner: a stand-alone copy, so it is packaged from a scratch root.
    root = os.path.join(WS, "build", arch, "qnx-port-tests-pkg")
    shutil.rmtree(root, ignore_errors=True)
    os.makedirs(os.path.join(root, tdir))
    shutil.copy2(os.path.join(WS, "tests", "run-on-target.sh"), os.path.join(root, tdir, "run-on-target.sh"))
    emit("qnx-port-tests", root, [os.path.join(tdir, "run-on-target.sh")], [],
         "QNX port tests runner: runs every installed qnx-test-* package")
    # The plain programs too, for a target without apk, and the bundle.
    bdir = os.path.join(outdir, "bin")
    shutil.rmtree(bdir, ignore_errors=True)
    os.makedirs(bdir)
    for n in sorted(os.listdir(os.path.join(stage, tdir))):
        if n.startswith("test_"):
            shutil.copy2(os.path.join(stage, tdir, n), bdir)
    shutil.copy2(os.path.join(WS, "tests", "run-on-target.sh"), bdir)
    bundle = os.path.join(WS, "dist", "qnx-port-tests-%s.tar.gz" % arch)
    if os.path.exists(bundle):
        shutil.copy2(bundle, outdir)
    print("== port tests [%s]: %d packages" % (arch, len(out)))
    return out


def write_indexes(outdir, key):
    """Rebuild INDEX and APKINDEX.tar.gz from every package in the directory."""
    db = os.path.join(outdir, ".index.json")
    data = json.load(open(db)) if os.path.exists(db) else {}
    # By name, and newest first within a name: oss-get takes the first line.
    order = sorted(data, key=lambda k: apk_version_key(data[k]["apk"]["V"]), reverse=True)
    order = sorted(order, key=lambda k: data[k]["apk"]["P"])
    with open(os.path.join(outdir, "INDEX"), "w") as f:
        f.write("# name|version|depends|file|sha256|size|description|conflicts\n")
        for k in order:
            f.write(data[k]["line"] + "\n")
    text = ""
    for k in order:
        e = data[k]["apk"]
        for k in "C P V A S I T U L o t D p".split():
            if k in e:
                text += "%s:%s\n" % (k, e[k])
        text += "\n"
    members = []
    for n, b in (("DESCRIPTION", b"QNX OSS (openqnx/oss)\n"), ("APKINDEX", text.encode())):
        ti = tarfile.TarInfo(n)
        ti.size = len(b)
        ti.mode = 0o644
        ti.mtime = int(time.time())
        members.append((ti, b))
    body = gz(write_tar(members, tarfile.USTAR_FORMAT))
    open(os.path.join(outdir, "APKINDEX.tar.gz"), "wb").write(sign(body, key) + body)


def fingerprint(root, rels, v=2, san=None):
    """What a package holds: path, type and link target of every member, and
    the contents of each file -- hashed when under 32 MB, size and mtime for
    bigger ones. Equal fingerprints -> the same package. v=1 is the first
    form (size and mtime only), still recognised in existing indexes. With a
    Sanitizer, a file whose packaged bytes now differ from what the old
    rewrite produced counts with its new contents (Sanitizer.fp_body)."""
    h = hashlib.sha256()
    for r in rels:
        full = os.path.join(root, r)
        st = os.lstat(full)
        tgt = os.readlink(full) if stat.S_ISLNK(st.st_mode) else ""
        if stat.S_ISDIR(st.st_mode):
            body = "0\0" + "0"
        elif v == 2 and stat.S_ISREG(st.st_mode) and st.st_size < (32 << 20):
            body = san.fp_body(full, r) if san else hashlib.sha256(open(full, "rb").read()).hexdigest()
        else:
            body = "%d\0%d" % (st.st_size, int(st.st_mtime))
        h.update(("%s\0%o\0%s\0%s\n" % (r, st.st_mode, body, tgt)).encode())
    return ("v2:" if v == 2 else "") + h.hexdigest()


BUMP = False   # --bump: a new release even where the contents look the same


def unchanged(existing, outdir, pname, ver, fp, fp1=None):
    """The entry already in the repository for <pname>-<ver>, when it holds
    these very contents and its files are there: then it is kept as it is.
    Writing the archives again would give the same name new bytes (gzip and
    tar record times), and a published copy would no longer match its index."""
    prev = (existing or {}).get("%s-%s" % (pname, ver))
    # The same test as choose_release's: no fingerprint (a legacy entry,
    # its archive already compared by the caller), or either fingerprint.
    if not prev or prev.get("fp") not in (None, fp, fp1):
        return None
    for ext in (".tar.gz", ".apk"):
        if not os.path.exists(os.path.join(outdir, "%s-%s%s" % (pname, ver, ext))):
            return None
    e = dict(prev["apk"]); e["fp"] = fp
    return e, prev["line"]


def archive_digest(path):
    """What a package archive holds, independent of time stamps and order:
    every member's name, type, link target and contents."""
    h = hashlib.sha256()
    with tarfile.open(path) as tf:
        for m in sorted(tf.getmembers(), key=lambda m: m.name):
            body = ""
            if m.isreg():
                body = hashlib.sha256(tf.extractfile(m).read()).hexdigest()
            h.update(("%s\0%s\0%s\0%s\n" % (m.name, m.type, m.linkname, body)).encode())
    return h.hexdigest()


def choose_release(existing, pname, base, fp, default, fp1=None):
    """A published <name>-<version>-r<N> is never rewritten: the same
    contents keep their release, changed contents get the next one."""
    rels = []
    for v in (existing or {}).values():
        if v["apk"]["P"] == pname:
            b, _, r = v["apk"]["V"].rpartition("-r")
            if b == base and r.isdigit():
                rels.append((int(r), v.get("fp")))
    if not rels:
        return default
    n, old = max(rels)
    # Entries made before fingerprints were recorded (old is None) are taken
    # as unchanged; --bump says otherwise.
    same = old is None or old == fp or (fp1 is not None and old == fp1)
    return n + 1 if BUMP or not same else n


_SUFFIX = {"alpha": 0, "beta": 1, "pre": 2, "rc": 3, "": 4, "cvs": 5, "svn": 6, "git": 7, "hg": 8, "p": 9}


def apk_version_key(v):
    """Sort key following apk's version order: numbers numerically, then the
    _alpha/_beta/_pre/_rc (before the release) and _git/_p (after) suffixes,
    then -r<release>."""
    v, _, rel = v.partition("-r")
    main, *sufs = v.split("_")
    nums = tuple(int(x) if x.isdigit() else 0 for x in re.findall(r"\d+|[a-z]+", main))
    sk = []
    for s in sufs or [""]:
        m = re.match(r"([a-z]*)(\d*)", s)
        sk.append((_SUFFIX.get(m.group(1), 4), int(m.group(2) or 0)))
    return (nums, tuple(sk), int(rel) if rel.isdigit() else 0)


def store(outdir, results, key):
    """Add packages to the repository in outdir and rewrite its indexes.
    Every version is kept: a new version of a package is added next to the
    ones already there, never in their place (apk installs the newest unless
    told "apk add <name>=<version>"; oss-get likewise)."""
    db = os.path.join(outdir, ".index.json")
    data = json.load(open(db)) if os.path.exists(db) else {}
    # Indexes written before versions were kept are keyed by name alone.
    data = {("%s-%s" % (v["apk"]["P"], v["apk"]["V"])): v for v in data.values()}
    for entry, line in results:
        fp = entry.pop("fp", None)
        data["%s-%s" % (entry["P"], entry["V"])] = {"apk": entry, "line": line, "fp": fp}
    json.dump(data, open(db, "w"), indent=1, sort_keys=True)
    write_indexes(outdir, key)


def reindex(dirpath, src, also, key):
    """Write INDEX and APKINDEX.tar.gz into dirpath for the packages whose
    files are there, or named in `also` (already published elsewhere), taking
    their entries from the repository src. For publishing a subset."""
    data = json.load(open(os.path.join(src, ".index.json")))
    have = set(os.listdir(dirpath)) | set(also)
    sel = {k: v for k, v in data.items()
           if "%s-%s.apk" % (v["apk"]["P"], v["apk"]["V"]) in have
           or "%s-%s.tar.gz" % (v["apk"]["P"], v["apk"]["V"]) in have}
    json.dump(sel, open(os.path.join(dirpath, ".index.json"), "w"), indent=1, sort_keys=True)
    write_indexes(dirpath, key)
    os.remove(os.path.join(dirpath, ".index.json"))
    print("== %s: index of %d packages" % (dirpath, len(sel)))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-a", "--arch", action="append", choices=list(APK_ARCH))
    ap.add_argument("-o", "--out", default=os.path.join(WS, "dists"))
    ap.add_argument("-r", "--release", type=int, default=0)
    ap.add_argument("--key", help="RSA private key for signing (abuild-keygen style)")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--tests", action="store_true",
                    help="package the on-target port tests too, into the separate "
                         "repository TESTS_OUT/<sdp>/<arch> (qnx-test-<name>, qnx-port-tests)")
    ap.add_argument("--tests-out", default=os.path.join(WS, "test_suites"))
    ap.add_argument("--bump", action="store_true",
                    help="give the packages a new release number even if their contents look unchanged")
    ap.add_argument("--reindex", metavar="DIR", help="only write the indexes of DIR (see reindex())")
    ap.add_argument("--from", dest="src", metavar="REPO_DIR")
    ap.add_argument("--also", metavar="FILE", help="package file names to index as well, one per line")
    ap.add_argument("components", nargs="*")
    args = ap.parse_args()
    global BUMP
    BUMP = args.bump
    if args.reindex:
        also = open(args.also).read().split() if args.also else []
        reindex(args.reindex, args.src, also, args.key)
        return 0
    arches = args.arch or list(APK_ARCH)
    rc = 0
    for arch in arches:
        comps = args.components
        if args.all:
            comps = sorted(os.listdir(os.path.join(WS, "pkgroot", arch)))
        owner = load_manifests(arch)
        if comps:
            outdir = os.path.join(args.out, SDP, APK_ARCH[arch])
            os.makedirs(outdir, exist_ok=True)
            results = []
            db = os.path.join(outdir, ".index.json")
            existing = json.load(open(db)) if os.path.exists(db) else {}
            for comp in comps:
                res = package(comp, arch, args, owner, outdir, existing)
                if not res:
                    rc = 1
                results += res
            store(outdir, results, args.key)
        if args.tests:
            # A repository of their own: tests depend on components, never the
            # other way, and GitHub allows 1000 assets per release.
            outdir = os.path.join(args.tests_out, SDP, APK_ARCH[arch])
            os.makedirs(outdir, exist_ok=True)
            res = package_tests(arch, args, owner, outdir)
            if not res:
                rc = 1
            store(outdir, res, args.key)
    return rc


if __name__ == "__main__":
    sys.exit(main())
