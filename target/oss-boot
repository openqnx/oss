#!/bin/sh
# oss-boot -- run at the end of the boot of an image made by
# "scripts/make-ported-image --apk" (docs/ported-first-image.md): sets up
# apk from what the image carries, then lets apk fetch and install the
# packages the image is configured for from the project's GitHub releases.
#
# In the image (read-only):  /system/oss-seed/
#     usr/local/   apk-tools and what it needs, unpacked (never in PATH)
#     repo/*/      the release indexes and those same packages: apk installs
#                  itself into /data/oss from here, without a network
#     keys/        the key the packages are signed with
#     packages     the packages to install at boot, one or several per line
#     desktop      not empty: start the desktop (oss-desktop) at the end
#     install-once not empty: install the packages at the first boot only; on
#                  later boots nothing is installed (apk add by hand)
#     sdp          the SDP release the image was made with (8.0, 8.0.6)
# On the data partition (writable):  /data/oss, seen as /usr/local
#     etc/oss-packages   the list in use: copied from the image at the first
#                        boot; edit it and reboot (or run oss-boot) to change
#                        what the target has
#     etc/rc.local       run at the end, if executable (start your services)
#     etc/no-desktop     when it exists the desktop is not started
#     etc/oss-installed  written when the first-boot install succeeded
#                        (install-once): the install is not repeated
#     var/log/oss-boot.log
#
# Also used on a board image (a BSP's IFS with a data partition mounted at
# /data and the seed at /system/oss-seed): the script that mounts /data runs it.
#
# Every boot: link /usr/local, "apk add" the list (nothing to do when all is
# installed; no network: reported, the boot goes on), start the ported sshd
# when it is installed. Safe to run by hand at any time.
#
# Environment:
#   OSS_BOOT_LOG=-        output on stdout instead of the log (a first boot
#                         run in the foreground: the caller shows it and
#                         appends it to the log with tee)
#   OSS_BOOT_DESKTOP=no   do not start the desktop (such a foreground run:
#                         QNX Screen starts after it)
SEED=${OSS_SEED:-/system/oss-seed}
ROOT=/data/oss
LOG=$ROOT/var/log/oss-boot.log
mkdir -p $ROOT/var/log $ROOT/etc
[ "$OSS_BOOT_LOG" = - ] || exec >> $LOG 2>&1
echo "== oss-boot $(date)"

# 1. apk on /data/oss, from the image's own copy (first boot only)
if ! $ROOT/bin/apk --version >/dev/null 2>&1; then
  OSS_SDP=$(cat $SEED/sdp) sh $SEED/apk-setup -b $SEED/usr/local \
    -s "$(echo $SEED/repo/*/APKINDEX.tar.gz)" -k "$(echo $SEED/keys/*.pub)" || echo "!! apk set-up failed"
fi

# 2. /usr/local and the environment of what follows
[ -e /usr/local ] || ln -sP $ROOT/usr/local /usr/local
# (what the image started this with comes last: a BSP image keeps the QNX
# commands in /bin, /usr/bin, ... instead of /system/bin)
PATH=$ROOT/bin:/usr/local/bin:/usr/local/sbin:/usr/local/opt/toybox/bin:/system/bin:/proc/boot${PATH:+:$PATH}
LD_LIBRARY_PATH=/usr/local/lib:/system/lib:/system/lib/dll:/proc/boot${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export PATH LD_LIBRARY_PATH

# The desktop, on an image made for it (make-ported-image --desktop): the
# session of root, started again when it ends (Log Out), like a display
# manager with automatic log-in. Restart and Shut Down end the system.
# Called before the packages are looked at (a later boot: the desktop is
# there at once) and after (the first boot: when it has been installed).
start_desktop() {
  [ "$OSS_BOOT_DESKTOP" != no ] && [ -n "$(cat $SEED/desktop 2>/dev/null)" ] && [ -x /usr/local/bin/oss-desktop ] && [ ! -e $ROOT/etc/no-desktop ] || return 0
  [ -n "$DESKTOP_STARTED" ] && return 0
  n=0; until [ -e /dev/screen ]; do n=$((n+1)); [ $n -ge 30 ] && break; sleep 1; done
  if [ ! -e /dev/screen ]; then echo "!! QNX Screen is not running: no desktop"; return 0; fi
  echo "starting the desktop"; DESKTOP_STARTED=1
  ( export HOME=/data/home/root SHELL=/usr/local/bin/bash USER=root LOGNAME=root
    export SSL_CERT_FILE=/usr/local/ssl/cert.pem
    cd $HOME
    while [ ! -e $ROOT/etc/no-desktop ]; do
      /usr/local/bin/oss-desktop >> $ROOT/var/log/oss-desktop.log 2>&1
      sleep 2
    done ) >> $ROOT/var/log/oss-desktop.log 2>&1 &
}
start_desktop

# 3. the packages this target is to have, from GitHub
LIST=$ROOT/etc/oss-packages
[ -f $LIST ] || cp $SEED/packages $LIST
want=$(echo $(sed 's/#.*//' $LIST))
ONCE=$(cat $SEED/install-once 2>/dev/null)
if [ -n "$ONCE" ] && [ -e $ROOT/etc/oss-installed ]; then
  echo "packages: installed at the first boot ($(cat $ROOT/etc/oss-installed)); add more with: apk add <package>"
elif [ -n "$want" ]; then
  n=0
  until $ROOT/bin/apk update >/dev/null 2>&1; do      # the network may not be up yet
    n=$((n+1)); [ $n -ge 12 ] && break; sleep 5
  done
  if [ $n -lt 12 ]; then
    if $ROOT/bin/apk add $want; then
      echo "packages installed: $want"
      [ -n "$ONCE" ] && date > $ROOT/etc/oss-installed
    else
      echo "!! apk add failed (the first-boot install is tried again at the next boot)"
    fi
  else
    echo "!! no connection to the package repositories; installed packages stay as they are"
  fi
fi

# 4. toybox comes without command links: make them (after the full tools in PATH)
# (by the real path: links cannot be made through the /usr/local link)
T=$ROOT/usr/local/opt/toybox/bin
if [ -x $T/toybox ] && [ ! -e $T/ls ]; then
  for a in $($T/toybox); do [ -e $T/$a ] || ln -s toybox $T/$a; done
fi

# 5. root logs in to the ported bash, over the ported sshd
# (an image whose account file is on /data: mkqnximage; elsewhere it stays)
if [ -x /usr/local/bin/bash ] && [ -f /data/var/etc/passwd ]; then
  if ! grep -q '^root:.*:/usr/local/bin/bash$' /data/var/etc/passwd; then
    sed 's#^\(root:.*\):/bin/sh$#\1:/usr/local/bin/bash#' /data/var/etc/passwd > $ROOT/etc/passwd.new &&
      cp $ROOT/etc/passwd.new /data/var/etc/passwd; rm -f $ROOT/etc/passwd.new
  fi
fi
if [ -x /usr/local/sbin/sshd ] && ! pidin -F %n | grep -q usr/local/sbin/sshd; then
  slay -f sshd 2>/dev/null
  /usr/local/sbin/sshd -f /system/etc/ssh/sshd_config.ported && echo "ported sshd started"
fi

[ -x $ROOT/etc/rc.local ] && $ROOT/etc/rc.local

start_desktop
echo "== oss-boot done $(date)"
