# local/snippets/system_files.custom
# QNX's Linux-compatibility shims from the SDP. A full QNX 8 image has them;
# mkqnximage's standard list does not, and every binary the workspace builds
# links them (toolchain/qnx-*.cmake, toolchain/meson-*.ini), so the ports
# would die at load with "Could not load library libeventfd.so.1". The loader searches
# /proc/boot:/system/lib:/system/lib/dll, so they go in lib/.
lib/libeventfd.so.1=usr/lib/libeventfd.so.1
lib/libepoll.so.1=usr/lib/libepoll.so.1
lib/libsignalfd.so.1=usr/lib/libsignalfd.so.1
lib/libtimerfd.so.1=usr/lib/libtimerfd.so.1
# QNX's audio library (io-audio client): SDL3, OpenAL and the sound tests
# link it; a full image has it, the standard mkqnximage list does not.
lib/libasound.so.5=lib/libasound.so.5
